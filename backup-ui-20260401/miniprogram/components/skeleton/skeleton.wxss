/* 骨架屏组件 v2.0 - 自然渐变 shimmer */

.skel-shimmer {
  background: linear-gradient(
    90deg,
    #F0F0EB 25%,
    #E8F5E9 37%,
    #F0F0EB 63%
  );
  background-size: 400rpx 100%;
  animation: skelShimmer 1.8s cubic-bezier(0.4, 0, 0.6, 1) infinite;
}

@keyframes skelShimmer {
  0% { background-position: -400rpx 0; }
  100% { background-position: 400rpx 0; }
}

/* 卡片骨架 */
.skel-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.skel-cover {
  width: 100%;
  height: 360rpx;
  border-radius: 20rpx 20rpx 0 0;
}

.skel-body {
  padding: 24rpx;
}

.skel-row {
  display: flex;
  gap: 12rpx;
  margin-top: 14rpx;
}

/* 线条骨架 */
.skel-line {
  border-radius: 8rpx;
  height: 28rpx;
}

.skel-line--title {
  width: 55%;
  height: 34rpx;
  margin-bottom: 16rpx;
}

.skel-line--desc {
  width: 80%;
  height: 24rpx;
  margin-bottom: 16rpx;
}

.skel-line--full {
  width: 100%;
  height: 24rpx;
  margin-bottom: 16rpx;
}

.skel-line--half {
  width: 50%;
  height: 24rpx;
  margin-bottom: 16rpx;
}

.skel-line--3-4 {
  width: 75%;
  height: 24rpx;
  margin-bottom: 16rpx;
}

/* 芯片/标签骨架 */
.skel-chip {
  width: 100rpx;
  height: 32rpx;
  border-radius: 8rpx;
}

/* 按钮骨架 */
.skel-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 12rpx;
}

/* 详情骨架 */
.skel-banner {
  width: 100%;
  height: 480rpx;
}

.skel-content {
  padding: 32rpx;
}
