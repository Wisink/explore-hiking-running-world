/* 空状态组件 v2.0 - 自然装饰风格 */

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 60rpx;
}

/* 装饰视觉 */
.empty-state__visual {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 32rpx;
}

.empty-state__circle {
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: linear-gradient(135deg, #E8F5E9 0%, #C8E6C9 100%);
  animation: emptyPulse 3s cubic-bezier(0.4, 0, 0.6, 1) infinite;
}

@keyframes emptyPulse {
  0%, 100% {
    transform: scale(1);
    opacity: 0.6;
  }
  50% {
    transform: scale(1.08);
    opacity: 1;
  }
}

.empty-state__icon {
  position: relative;
  font-size: 72rpx;
  line-height: 1;
  animation: emptyFloat 3s ease-in-out infinite;
}

@keyframes emptyFloat {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
}

.empty-state__title {
  font-size: 32rpx;
  font-weight: 600;
  color: #424240;
  margin-bottom: 12rpx;
}

.empty-state__desc {
  font-size: 26rpx;
  color: #9E9E99;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 40rpx;
  max-width: 480rpx;
}

.empty-state__btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 18rpx 48rpx;
  background: linear-gradient(135deg, #2E7D32 0%, #43A047 100%);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 40rpx;
  box-shadow: 0 4rpx 16rpx rgba(46, 125, 50, 0.3);
  transition: all 200ms cubic-bezier(0.4, 0, 0.2, 1);
}

.empty-state__btn:active,
.empty-state__btn--hover {
  transform: scale(0.96);
  box-shadow: 0 2rpx 8rpx rgba(46, 125, 50, 0.2);
}

.empty-state__btn-text {
  color: #FFFFFF;
}
