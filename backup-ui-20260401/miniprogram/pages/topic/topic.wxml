<view class="container">
  <!-- 自定义头部：封面头图 -->
  <view class="header" style="background-color: {{themeColor}}; padding-top: {{statusBarHeight}}px;">
    <view class="status-bar">
      <view class="back-btn" bindtap="onBackTap">
        <text class="back-icon">‹</text>
        <text class="back-text">返回</text>
      </view>
    </view>
    <view class="header-content">
      <text class="header-icon">{{icon}}</text>
      <text class="header-title">{{category}}</text>
      <text class="header-subtitle">{{subtitle}}</text>
    </view>
  </view>

  <!-- 文章列表 -->
  <view class="article-list">
    <view
      class="article-card"
      wx:for="{{articles}}"
      wx:key="_id"
      bindtap="onArticleTap"
      data-id="{{item._id}}"
    >
      <view class="card-index" style="background-color: {{themeColor}};">
        <text class="index-text">{{index + 1}}</text>
      </view>
      <view class="card-body">
        <text class="card-title">{{item.title}}</text>
        <text class="card-summary">{{item.summary}}</text>
      </view>
      <view class="card-arrow">›</view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{!loading && articles.length === 0}}">
      <text class="empty-icon">📭</text>
      <text class="empty-text">暂无该分类的文章</text>
    </view>

    <!-- 加载中 -->
    <view class="loading" wx:if="{{loading}}">
      <view class="loading-spinner"></view>
      <text class="loading-text">加载中...</text>
    </view>

    <!-- 没有更多 -->
    <view class="no-more" wx:if="{{!hasMore && articles.length > 0}}">
      <text class="no-more-text">— 已加载全部文章 —</text>
    </view>

    <!-- 底部返回按钮 -->
    <view class="bottom-back" wx:if="{{articles.length > 0}}">
      <button class="back-btn-bottom" style="background-color: {{themeColor}};" bindtap="onBackTap">
        <text class="back-btn-icon">‹</text>
        <text class="back-btn-text">返回上一页</text>
      </button>
    </view>
  </view>
</view>
