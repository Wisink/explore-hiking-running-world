.complete-panel__options {
  display: flex;
  gap: 16rpx;
}

.complete-panel__option {
  padding: 14rpx 28rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #757570;
  background: #F5F5F0;
  border: 2rpx solid transparent;
  transition: all 200ms ease;
}

.complete-panel__option--on {
  background: #E8F5E9;
  color: #2E7D32;
  font-weight: 600;
  border-color: #A5D6A7;
}

.complete-panel__input {
  width: 100%;
  padding: 22rpx 22rpx;
  background: #F5F5F0;
  border: 2rpx solid #E0E0DB;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #303028;
  box-sizing: border-box;
  min-height: 80rpx;
  line-height: 1.4;
}

.complete-panel__textarea {
  width: 100%;
  padding: 18rpx 22rpx;
  background: #F5F5F0;
  border: 2rpx solid #E0E0DB;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #303028;
  min-height: 120rpx;
  box-sizing: border-box;
  line-height: 1.6;
}

.complete-panel__row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.complete-panel__info-item {
  flex: 1;
  padding: 12rpx 16rpx;
  background: #F5F5F0;
  border: 1rpx solid #E0E0DB;
  border-radius: 10rpx;
}

.complete-panel__info-label {
  display: block;
  font-size: 22rpx;
  color: #9E9E99;
  margin-bottom: 4rpx;
}

.complete-panel__info-val {
  font-size: 26rpx;
  color: #303028;
  font-weight: 500;
}

.complete-panel__picker {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.complete-panel__picker-val {
  font-size: 28rpx;
  color: #303028;
  font-weight: 500;
}

.complete-panel__picker-arrow {
  font-size: 24rpx;
}

.complete-panel__weather-input {
  padding: 8rpx 16rpx;
  background: #F5F5F0;
  border-radius: 8rpx;
  border: 1rpx solid #E0E0DB;
  font-size: 26rpx;
  color: #303028;
  width: 180rpx;
  box-sizing: border-box;
}

.complete-panel__save {
  width: 100%;
  padding: 24rpx 0;
  text-align: center;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
  background: linear-gradient(135deg, #43A047, #2E7D32);
  box-shadow: 0 4rpx 16rpx rgba(46, 125, 50, 0.3);
}

.complete-panel__save:active {
  transform: scale(0.97);
}

.complete-panel__delete {
  width: 100%;
  padding: 24rpx 0;
  text-align: center;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #E74C3C;
  background: #FFF5F5;
  border: 2rpx solid #FECACA;
  margin-top: 16rpx;
}

.complete-panel__delete:active {
  transform: scale(0.97);
  background: #FEE2E2;
}

/* ===== 离线状态提示条 ===== */

.offline-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  background: #FFF3E0;
  border-bottom: 1rpx solid #FFE0B2;
}

.offline-bar--cache {
  background: #E8F5E9;
  border-bottom-color: #C8E6C9;
}

.offline-bar__icon {
  font-size: 24rpx;
}

.offline-bar__text {
  font-size: 24rpx;
  color: #795548;
}

.offline-bar--cache .offline-bar__text {
  color: #2E7D32;
}

/* ===== 已走过记录列表 ===== */

.completed-records {
  background: #FFFFFF;
  border-radius: 16rpx;
  margin: 24rpx;
  padding: 28rpx;
}

.completed-records__head {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 20rpx;
}

.completed-records__icon {
  font-size: 32rpx;
}

.completed-records__title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.completed-records__item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0F0EB;
}

.completed-records__item:last-child {
  border-bottom: none;
}

.completed-records__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.completed-records__date {
  font-size: 28rpx;
  font-weight: 600;
  color: #303028;
}

.completed-records__edit {
  font-size: 24rpx;
  color: #4A90D9;
  padding: 8rpx 16rpx;
}

.completed-records__details {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.completed-records__detail {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: #F5F5F0;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.completed-records__detail-label {
  font-size: 22rpx;
  color: #9E9E99;
}

.completed-records__detail-val {
  font-size: 24rpx;
  color: #303028;
}

