/* pages/admin/admin.wxss */

.admin-page {
  min-height: 100vh;
  background: #F5F5F5;
  padding-bottom: 40rpx;
}

/* ========== 登录 ========== */
.login-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  background: linear-gradient(135deg, #E8F5E9 0%, #F5F5F5 100%);
}

.login-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 60rpx 48rpx;
  margin: 0 40rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.08);
  width: 100%;
}

.login-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.login-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #1A1A1A;
  margin-bottom: 12rpx;
}

.login-desc {
  font-size: 28rpx;
  color: #9E9E99;
  margin-bottom: 40rpx;
}

.login-input {
  width: 100%;
  height: 88rpx;
  background: #F5F5F0;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #1A1A1A;
  margin-bottom: 32rpx;
  box-sizing: border-box;
}

.login-input::placeholder {
  color: #C0C0BB;
}

.login-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #2E7D32 0%, #43A047 100%);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(46, 125, 50, 0.3);
}

.login-btn:active {
  transform: scale(0.98);
}

.login-btn text {
  font-size: 32rpx;
  color: #FFFFFF;
  font-weight: 600;
}

/* ========== 页面头部 ========== */
.page-header {
  position: relative;
  padding: 40rpx 32rpx 20rpx;
  overflow: hidden;
}

.page-header__bg {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(135deg, rgba(46, 125, 50, 0.06) 0%, rgba(67, 160, 71, 0.04) 100%);
}

.page-header__content {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.page-header__emoji {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.page-header__title {
  font-size: 44rpx;
  font-weight: 800;
  color: #1A1A1A;
  letter-spacing: 1rpx;
}

.page-header__sub {
  font-size: 26rpx;
  color: #9E9E99;
}

/* ========== Tab 切换 ========== */
.admin-tabs {
  display: flex;
  background: #FFFFFF;
  margin: 0 24rpx;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.admin-tabs__item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 0;
  position: relative;
  transition: all 250ms ease;
}

.admin-tabs__item--on {
  background: rgba(46, 125, 50, 0.06);
}

.admin-tabs__item--on text {
  color: #2E7D32;
  font-weight: 700;
}

.admin-tabs__item text {
  font-size: 28rpx;
  color: #757575;
  font-weight: 500;
}

/* ========== 内容区 ========== */
.tab-content {
  margin: 24rpx;
}

/* ========== 概览 ========== */
.stats-grid {
  display: flex;
  gap: 20rpx;
}

.stats-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 36rpx 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.stats-item__num {
  font-size: 52rpx;
  font-weight: 800;
  color: #2E7D32;
  margin-bottom: 8rpx;
}

.stats-item__label {
  font-size: 24rpx;
  color: #757575;
}

/* ========== 搜索栏 ========== */
.search-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.search-bar__input {
  flex: 1;
  height: 76rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #1A1A1A;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.search-bar__input::placeholder {
  color: #C0C0BB;
}

.search-bar__btn {
  width: 76rpx;
  height: 76rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.search-bar__btn text {
  font-size: 32rpx;
}

/* ========== 列表信息 ========== */
.list-info {
  margin-bottom: 12rpx;
}

.list-info text {
  font-size: 24rpx;
  color: #9E9E99;
}

/* ========== 滚动容器 ========== */
.admin-scroll {
  height: calc(100vh - 420rpx);
}

/* ========== 通用列表 ========== */
.admin-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.admin-item {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
  transition: transform 150ms ease;
}

.admin-item--hover {
  transform: scale(0.98);
}

.admin-item__cover {
  width: 120rpx;
  height: 90rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  background: #E0E0DB;
}

.admin-item__body {
  flex: 1;
  min-width: 0;
}

.admin-item__title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.admin-item__meta {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.admin-item__tag {
  font-size: 22rpx;
  color: #757575;
  padding: 2rpx 10rpx;
  background: #F5F5F0;
  border-radius: 6rpx;
}

.admin-item__arrow {
  margin-left: 12rpx;
  flex-shrink: 0;
}

.admin-item__arrow text {
  font-size: 36rpx;
  color: #C0C0BB;
  font-weight: 300;
}

/* 用户卡片 */
.admin-item__avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  flex-shrink: 0;
  overflow: hidden;
  background: #E8F5E9;
  display: flex;
  align-items: center;
  justify-content: center;
}

.admin-item__avatar-img {
  width: 100%;
  height: 100%;
}

.admin-item__avatar-placeholder {
  font-size: 32rpx;
  font-weight: 700;
  color: #2E7D32;
}

.admin-item__openid {
  font-size: 20rpx;
  color: #AAAAAA;
  font-family: monospace;
}

/* ========== 弹窗 ========== */
.modal-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  z-index: 1000;
}

.modal-card {
  width: 100%;
  max-height: 80vh;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  overflow: hidden;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 1rpx solid #F0F0EB;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.modal-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #F5F5F0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-close text {
  font-size: 28rpx;
  color: #757575;
}

.modal-scroll {
  max-height: 60vh;
  padding: 24rpx 32rpx 32rpx;
}

.modal-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}

.modal-empty text {
  font-size: 28rpx;
  color: #9E9E99;
}

/* 已走过列表 */
.completed-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.completed-item {
  background: #FAFAF5;
  border-radius: 16rpx;
  padding: 20rpx;
  border-left: 6rpx solid #2E7D32;
}

.completed-item__name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 8rpx;
}

.completed-item__info {
  font-size: 24rpx;
  color: #555;
  margin-bottom: 4rpx;
}

.completed-item__note {
  background: #FFFDE7;
  padding: 12rpx 16rpx;
  border-radius: 10rpx;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #5D4037;
  line-height: 1.6;
}

/* ========== 加载/到底 ========== */
.loading-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 0;
}

.loading-text {
  font-size: 26rpx;
  color: #9E9E99;
}

.list-end {
  text-align: center;
  padding: 32rpx 0;
}

.list-end text {
  font-size: 24rpx;
  color: #C0C0BB;
}

/* ========== Toast ========== */
.admin-toast {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) scale(0.8);
  background: rgba(0, 0, 0, 0.75);
  color: #FFFFFF;
  padding: 20rpx 40rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  z-index: 9999;
  opacity: 0;
  transition: all 300ms ease;
  pointer-events: none;
}

.admin-toast--show {
  opacity: 1;
  transform: translate(-50%, -50%) scale(1);
}

.admin-toast--success {
  background: rgba(46, 125, 50, 0.85);
}

.admin-toast--error {
  background: rgba(244, 67, 54, 0.85);
}
