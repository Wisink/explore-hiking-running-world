<!--pages/equipment/equipment.wxml-->
<view class="equipment-page">
  <!-- 页面标题 -->
  <view class="page-header">
    <text class="page-title">🎒 新手装备清单</text>
    <text class="page-desc">第一次徒步？这些装备帮你做好准备</text>
  </view>

  <!-- 装备分类列表 -->
  <view class="equipment-list">
    <!-- 基础装备 -->
    <view class="equipment-section">
      <view class="section-header">
        <text class="section-icon">👟</text>
        <text class="section-title">基础装备（必备）</text>
      </view>
      <view class="equipment-items">
        <view class="equipment-item" wx:for="{{basicEquipment}}" wx:key="name">
          <view class="item-check {{item.checked ? 'checked' : ''}}" data-index="{{index}}" data-type="basic" bindtap="toggleCheck">
            <text class="check-icon">{{item.checked ? '✅' : '⬜'}}</text>
          </view>
          <view class="item-info">
            <text class="item-name">{{item.name}}</text>
            <text class="item-desc">{{item.desc}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 服装装备 -->
    <view class="equipment-section">
      <view class="section-header">
        <text class="section-icon">👕</text>
        <text class="section-title">服装装备</text>
      </view>
      <view class="equipment-items">
        <view class="equipment-item" wx:for="{{clothingEquipment}}" wx:key="name">
          <view class="item-check {{item.checked ? 'checked' : ''}}" data-index="{{index}}" data-type="clothing" bindtap="toggleCheck">
            <text class="check-icon">{{item.checked ? '✅' : '⬜'}}</text>
          </view>
          <view class="item-info">
            <text class="item-name">{{item.name}}</text>
            <text class="item-desc">{{item.desc}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 安全装备 -->
    <view class="equipment-section">
      <view class="section-header">
        <text class="section-icon">🛡️</text>
        <text class="section-title">安全装备</text>
      </view>
      <view class="equipment-items">
        <view class="equipment-item" wx:for="{{safetyEquipment}}" wx:key="name">
          <view class="item-check {{item.checked ? 'checked' : ''}}" data-index="{{index}}" data-type="safety" bindtap="toggleCheck">
            <text class="check-icon">{{item.checked ? '✅' : '⬜'}}</text>
          </view>
          <view class="item-info">
            <text class="item-name">{{item.name}}</text>
            <text class="item-desc">{{item.desc}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 食品补给 -->
    <view class="equipment-section">
      <view class="section-header">
        <text class="section-icon">🍫</text>
        <text class="section-title">食品补给</text>
      </view>
      <view class="equipment-items">
        <view class="equipment-item" wx:for="{{foodEquipment}}" wx:key="name">
          <view class="item-check {{item.checked ? 'checked' : ''}}" data-index="{{index}}" data-type="food" bindtap="toggleCheck">
            <text class="check-icon">{{item.checked ? '✅' : '⬜'}}</text>
          </view>
          <view class="item-info">
            <text class="item-name">{{item.name}}</text>
            <text class="item-desc">{{item.desc}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部提示 -->
  <view class="footer-tips">
    <text class="tips-text">💡 温馨提示：根据路线难度和天气情况，适当增减装备</text>
  </view>
</view>
