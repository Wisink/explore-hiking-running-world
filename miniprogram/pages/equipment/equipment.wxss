/* pages/equipment/equipment.wxss */

.equipment-page {
  background-color: #F8F6F0;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 页面标题 */
.page-header {
  background: linear-gradient(135deg, #2D5A27 0%, #4A8B3C 100%);
  padding: 40rpx 30rpx;
  text-align: center;
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
  display: block;
  margin-bottom: 12rpx;
}

.page-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 装备列表 */
.equipment-list {
  padding: 20rpx;
}

.equipment-section {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.section-header {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  background-color: #F8F6F0;
  border-bottom: 1rpx solid #E0E0E0;
}

.section-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
}

/* 装备项 */
.equipment-items {
  padding: 0 20rpx;
}

.equipment-item {
  display: flex;
  align-items: center;
  padding: 24rpx 10rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.equipment-item:last-child {
  border-bottom: none;
}

.item-check {
  margin-right: 20rpx;
}

.check-icon {
  font-size: 40rpx;
}

.item-info {
  flex: 1;
}

.item-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #333333;
  display: block;
  margin-bottom: 8rpx;
}

.item-desc {
  font-size: 24rpx;
  color: #999999;
}

/* 底部提示 */
.footer-tips {
  padding: 30rpx;
  text-align: center;
}

.tips-text {
  font-size: 24rpx;
  color: #999999;
}
