<!--pages/assistant/assistant.wxml-->
<view class="assistant-page">

  <!-- 统一头部 -->
  <view class="page-header">
    <view class="page-header__statusbar" style="height: {{statusBarHeight}}px;"></view>
    <view class="page-header__nav">
      <view class="page-header__back" bindtap="onGoBack">
        <text class="page-header__back-icon">{{lt}}</text>
        <text class="page-header__back-text">返回</text>
      </view>
      <text class="page-header__title">🤖 徒步助手</text>
      <view class="page-header__spacer"></view>
    </view>
  </view>
  <view style="height: {{headerHeight}}px;"></view>

  <!-- 步骤指示器 -->
  <view class="steps-bar" wx:if="{{!showResult}}">
    <view class="steps-bar__item {{currentStep >= 1 ? 'active' : ''}}">
      <view class="steps-bar__num">1</view>
      <text class="steps-bar__label">想怎么玩</text>
    </view>
    <view class="steps-bar__line {{currentStep >= 2 ? 'active' : ''}}"></view>
    <view class="steps-bar__item {{currentStep >= 2 ? 'active' : ''}}">
      <view class="steps-bar__num">2</view>
      <text class="steps-bar__label">想看什么</text>
    </view>
    <view class="steps-bar__line {{currentStep >= 3 ? 'active' : ''}}"></view>
    <view class="steps-bar__item {{currentStep >= 3 ? 'active' : ''}}">
      <view class="steps-bar__num">3</view>
      <text class="steps-bar__label">想走多久</text>
    </view>
  </view>

  <!-- ===== Step1: 想怎么玩？ ===== -->
  <view class="step-content" wx:if="{{currentStep === 1 && !showResult}}">
    <view class="step-title">想怎么玩？</view>
    <view class="step-desc">选择你今天的徒步风格</view>

    <view class="option-grid">
      <view class="option-card" data-value="easy" bindtap="onStep1Tap">
        <view class="option-card__icon">🚶</view>
        <view class="option-card__title">轻松散步</view>
        <view class="option-card__desc">距离短、难度低、走走停停很放松，没挑战</view>
      </view>

      <view class="option-card" data-value="serious" bindtap="onStep1Tap">
        <view class="option-card__icon">🥾</view>
        <view class="option-card__title">认真徒步</view>
        <view class="option-card__desc">距离稍远、有点挑战、尽情享受徒步的乐趣</view>
      </view>

      <view class="option-card option-card--wide" data-value="family" bindtap="onStep1Tap">
        <view class="option-card__icon">👶</view>
        <view class="option-card__title">亲子徒步</view>
        <view class="option-card__desc">亲子友好、距离短、安全好走不费腿</view>
      </view>
    </view>
  </view>

  <!-- ===== Step2: 想看什么？ ===== -->
  <view class="step-content" wx:if="{{currentStep === 2 && !showResult}}">
    <view class="step-title">想看什么？</view>
    <view class="step-desc">你喜欢什么样的风景？</view>

    <view class="option-grid">
      <view class="option-card" data-value="stream" bindtap="onStep2Tap">
        <view class="option-card__icon">💧</view>
        <view class="option-card__title">溪水</view>
        <view class="option-card__desc">听水声，感受清凉</view>
      </view>

      <view class="option-card" data-value="forest" bindtap="onStep2Tap">
        <view class="option-card__icon">🌲</view>
        <view class="option-card__title">森林</view>
        <view class="option-card__desc">穿行林间，满目绿意</view>
      </view>

      <view class="option-card" data-value="mountain" bindtap="onStep2Tap">
        <view class="option-card__icon">⛰️</view>
        <view class="option-card__title">山顶</view>
        <view class="option-card__desc">登高望远，一览众山小</view>
      </view>

      <view class="option-card" data-value="historic" bindtap="onStep2Tap">
        <view class="option-card__icon">🏛️</view>
        <view class="option-card__title">古迹</view>
        <view class="option-card__desc">边走边感受历史底蕴</view>
      </view>

      <view class="option-card option-card--wide" data-value="any" bindtap="onStep2Tap">
        <view class="option-card__icon">🌈</view>
        <view class="option-card__title">都行</view>
        <view class="option-card__desc">什么风景都喜欢，不过滤</view>
      </view>
    </view>

    <view class="step-back" bindtap="onPrevStep">
      <text>返回上一步</text>
    </view>
  </view>

  <!-- ===== Step3: 想走多久？ ===== -->
  <view class="step-content" wx:if="{{currentStep === 3 && !showResult}}">
    <view class="step-title">想走多久？</view>
    <view class="step-desc">今天打算花多少时间？</view>

    <view class="option-grid">
      <view class="option-card" data-value="half" bindtap="onStep3Tap">
        <view class="option-card__icon">⏰</view>
        <view class="option-card__title">半天</view>
        <view class="option-card__desc">时间紧张少走一点也没事儿</view>
      </view>

      <view class="option-card" data-value="most" bindtap="onStep3Tap">
        <view class="option-card__icon">☀️</view>
        <view class="option-card__title">大半天</view>
        <view class="option-card__desc">时间充裕那就慢慢赏景</view>
      </view>

      <view class="option-card" data-value="all" bindtap="onStep3Tap">
        <view class="option-card__icon">🌅</view>
        <view class="option-card__title">一整天</view>
        <view class="option-card__desc">把一整天的时光全都交给山野</view>
      </view>

      <view class="option-card" data-value="flexible" bindtap="onStep3Tap">
        <view class="option-card__icon">🤷</view>
        <view class="option-card__title">看情况</view>
        <view class="option-card__desc">时间灵活<br/>不过滤，随便推荐</view>
      </view>
    </view>

    <view class="step-back" bindtap="onPrevStep">
      <text>返回上一步</text>
    </view>
  </view>

  <!-- ===== 推荐结果 ===== -->
  <view class="result-wrap" wx:if="{{showResult}}">
    <view class="result-header">
      <view class="result-header__title">为你推荐以下路线</view>
      <view class="result-header__desc" wx:if="{{resultReason}}">{{resultReason}}</view>
      <view class="result-header__count">从 {{allMatched.length}} 条路线中精选</view>
    </view>

    <view class="route-list">
      <view
        class="route-card"
        wx:for="{{results}}"
        wx:key="_id"
        data-id="{{item._id}}"
        bindtap="onRouteTap"
        hover-class="route-card--hover"
        style="animation-delay: {{index * 80}}ms"
      >
        <!-- 封面图 -->
        <view class="route-card__cover">
          <image
            class="route-card__image"
            src="{{item.coverImage || '/images/scenery/scenery-general.jpg'}}"
            mode="aspectFill"
            lazy-load
          />
          <view class="route-card__overlay"></view>

          <view class="route-card__badge" style="background: {{item.diffColor}}">
            {{item.diffText}}
          </view>

          <!-- 推荐理由 -->
          <view class="route-card__reason">
            💡 {{resultReason}}
          </view>

          <view class="route-card__hero">
            <text class="route-card__name">{{item.name}}</text>
            <view class="route-card__meta">
              <view class="route-card__meta-item" wx:if="{{item.distanceText}}">
                <text>📏 {{item.distanceText}}</text>
              </view>
              <view class="route-card__meta-item" wx:if="{{item.durationText}}">
                <text>⏱ {{item.durationText}}</text>
              </view>
              <view class="route-card__meta-item" wx:if="{{item.cost}}">
                <text>💰 {{item.isFree ? '免费' : item.cost}}</text>
              </view>
            </view>
          </view>
        </view>

        <view class="route-card__body">
          <text class="route-card__desc">{{item.description || '探索这条美丽的路线'}}</text>

          <view class="route-card__tags" wx:if="{{item.features && item.features.length > 0}}">
            <text class="route-card__tag" wx:for="{{item.features}}" wx:for-item="feat" wx:key="*this">{{feat}}</text>
          </view>

          <view class="route-card__family" wx:if="{{item.family_friendly}}">
            <text>👶 亲子友好</text>
          </view>
        </view>
      </view>

      <!-- 空状态 -->
      <view class="empty-wrap" wx:if="{{results.length === 0}}">
        <text class="empty-icon">🤔</text>
        <text class="empty-title">没有找到匹配的路线</text>
        <text class="empty-desc">试试换个条件？</text>
      </view>
    </view>

    <!-- 操作按钮 -->
    <view class="result-actions" wx:if="{{results.length > 0}}">
      <view class="result-btn result-btn--secondary" bindtap="onRefresh">
        <text>🔄 换一批</text>
      </view>
      <view class="result-btn result-btn--primary" bindtap="onRestart">
        <text>🔁 重新选</text>
      </view>
    </view>
  </view>

</view>
