<!--pages/assistant/assistant.wxml-->
<view class="assistant-page">

  <!-- 状态栏 -->
  <view class="page-statusbar" style="height: {{statusBarHeight}}px;"></view>

  <!-- 顶部栏 -->
  <view class="header">
    <view class="header__bg"></view>
    <view class="header__content">
      <view class="header__back" bindtap="onGoBack">
        <text class="header__back-icon">‹</text>
      </view>
      <view class="header__text">
        <text class="header__title">🤖 徒步助手</text>
        <text class="header__sub">基于你的需求给你推荐路线</text>
      </view>
    </view>
  </view>

  <!-- 步骤指示器 -->
  <view class="steps-bar" wx:if="{{!showResult}}">
    <view class="step-header {{currentStep >= 1 ? 'active' : ''}}">
      <view class="step-icon">🎯</view>
      <text class="steps-bar__label">想怎么玩</text>
    </view>
    <view class="steps-bar__line {{currentStep >= 2 ? 'active' : ''}}"></view>
    <view class="step-header {{currentStep >= 2 ? 'active' : ''}}">
      <view class="step-icon">🌳</view>
      <text class="steps-bar__label">想看什么</text>
    </view>
    <view class="steps-bar__line {{currentStep >= 3 ? 'active' : ''}}"></view>
    <view class="step-header {{currentStep >= 3 ? 'active' : ''}}">
      <view class="step-icon">⏳</view>
      <text class="steps-bar__label">想走多久</text>
    </view>
  </view>

  <!-- ===== Step1: 想怎么玩？ ===== -->
  <view class="step-content" wx:if="{{currentStep === 1 && !showResult}}">
    <view class="step-title">想怎么玩？</view>
    <view class="step-desc">选择你今天的徒步风格</view>

    <view class="option-grid">
      <view class="option-pill {{step1Choice === 'easy' ? 'option-pill--active' : ''}}" data-value="easy" bindtap="onStep1Tap">
        🚶 轻松散步
      </view>
      <view class="option-pill {{step1Choice === 'serious' ? 'option-pill--active' : ''}}" data-value="serious" bindtap="onStep1Tap">
        🥾 认真徒步
      </view>
      <view class="option-pill {{step1Choice === 'family' ? 'option-pill--active' : ''}}" data-value="family" bindtap="onStep1Tap">
        👨‍👩‍👧 带娃出去
      </view>
    </view>
  </view>

  <!-- ===== Step2: 想看什么？ ===== -->
  <view class="step-content" wx:if="{{currentStep === 2 && !showResult}}">
    <view class="step-title">想看什么？</view>
    <view class="step-desc">你喜欢什么样的风景？</view>

    <view class="option-grid">
      <view class="option-pill {{step2Choice === 'stream' ? 'option-pill--active' : ''}}" data-value="stream" bindtap="onStep2Tap">
        💧 溪水
      </view>
      <view class="option-pill {{step2Choice === 'forest' ? 'option-pill--active' : ''}}" data-value="forest" bindtap="onStep2Tap">
        🌲 森林
      </view>
      <view class="option-pill {{step2Choice === 'mountain' ? 'option-pill--active' : ''}}" data-value="mountain" bindtap="onStep2Tap">
        ⛰️ 山顶
      </view>
      <view class="option-pill {{step2Choice === 'historic' ? 'option-pill--active' : ''}}" data-value="historic" bindtap="onStep2Tap">
        🏛️ 古迹
      </view>
      <view class="option-pill {{step2Choice === 'any' ? 'option-pill--active' : ''}}" data-value="any" bindtap="onStep2Tap">
        🌈 都行
      </view>
    </view>

    <view class="back-btn" bindtap="onPrevStep">
      <text class="back-btn__icon">←</text>
      <text class="back-btn__text">返回上一步</text>
    </view>
  </view>

  <!-- ===== Step3: 想走多久？ ===== -->
  <view class="step-content" wx:if="{{currentStep === 3 && !showResult}}">
    <view class="step-title">想走多久？</view>
    <view class="step-desc">今天打算花多少时间？</view>

    <view class="option-grid">
      <view class="option-pill {{step3Choice === 'half' ? 'option-pill--active' : ''}}" data-value="half" bindtap="onStep3Tap">
        ⏰ 半天
      </view>
      <view class="option-pill {{step3Choice === 'most' ? 'option-pill--active' : ''}}" data-value="most" bindtap="onStep3Tap">
        ☀️ 大半天
      </view>
      <view class="option-pill {{step3Choice === 'all' ? 'option-pill--active' : ''}}" data-value="all" bindtap="onStep3Tap">
        🌅 一整天
      </view>
      <view class="option-pill {{step3Choice === 'flexible' ? 'option-pill--active' : ''}}" data-value="flexible" bindtap="onStep3Tap">
        🤷 看情况
      </view>
    </view>

    <view class="back-btn" bindtap="onPrevStep">
      <text class="back-btn__icon">←</text>
      <text class="back-btn__text">返回上一步</text>
    </view>
  </view>

  <!-- ===== 推荐结果 ===== -->
  <view class="result-wrap" wx:if="{{showResult}}">
    <view class="result-header">
      <view class="result-header__title">为你推荐</view>
      <view class="result-header__desc" wx:if="{{resultReason}}">{{resultReason}}</view>
      <view class="result-header__count">从 {{allMatched.length}} 条路线中精选</view>
    </view>

    <view class="route-list">
      <view
        class="route-card"
        wx:for="{{results}}"
        wx:key="_id"
        data-id="{{item._id}}"
        bindtap="onRouteTap"
        hover-class="route-card--hover"
        style="animation-delay: {{index * 80}}ms"
      >
        <!-- 封面图 -->
        <view class="route-card__cover">
          <image
            class="route-card__image"
            src="{{item.coverImage || '/images/scenery/scenery-general.jpg'}}"
            mode="aspectFill"
            lazy-load
          />
          <view class="route-card__overlay"></view>

          <view class="route-card__badge" style="background: {{item.diffColor}}">
            {{item.diffText}}
          </view>

          <!-- 推荐理由 -->
          <view class="route-card__reason">
            💡 {{resultReason}}
          </view>

          <view class="route-card__hero">
            <text class="route-card__name">{{item.name}}</text>
            <view class="route-card__meta">
              <view class="route-card__meta-item" wx:if="{{item.distanceText}}">
                <text>📏 {{item.distanceText}}</text>
              </view>
              <view class="route-card__meta-item" wx:if="{{item.durationText}}">
                <text>⏱ {{item.durationText}}</text>
              </view>
              <view class="route-card__meta-item" wx:if="{{item.cost}}">
                <text>💰 {{item.isFree ? '免费' : item.cost}}</text>
              </view>
            </view>
          </view>
        </view>

        <view class="route-card__body">
          <text class="route-card__desc">{{item.description || '探索这条美丽的路线'}}</text>

          <view class="route-card__tags" wx:if="{{item.features && item.features.length > 0}}">
            <text class="route-card__tag" wx:for="{{item.features}}" wx:for-item="feat" wx:key="*this">{{feat}}</text>
          </view>

          <view class="route-card__family" wx:if="{{item.family_friendly}}">
            <text>👨‍👩‍👧 亲子友好</text>
          </view>
        </view>
      </view>

      <!-- 空状态 -->
      <view class="empty-wrap" wx:if="{{results.length === 0}}">
        <text class="empty-icon">🤔</text>
        <text class="empty-title">没有找到匹配的路线</text>
        <text class="empty-desc">试试换个条件？</text>
      </view>
    </view>

    <!-- 操作按钮 -->
    <view class="result-actions" wx:if="{{results.length > 0}}">
      <view class="result-btn result-btn--secondary" bindtap="onRefresh">
        <text>🔄 换一批</text>
      </view>
      <view class="result-btn result-btn--primary" bindtap="onRestart">
        <text>🔁 重新选</text>
      </view>
    </view>
  </view>

</view>
