/* pages/etiquette/etiquette.wxss */

.etiquette-page {
  background-color: #F8F6F0;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 头部 */
.page-header {
  background: linear-gradient(135deg, #2D5A27 0%, #4A8B3C 100%);
  padding: 50rpx 30rpx 40rpx;
  text-align: center;
}

.header-icon {
  font-size: 64rpx;
  display: block;
  margin-bottom: 16rpx;
}

.header-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
  display: block;
  margin-bottom: 12rpx;
}

.header-subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* Tab 栏 */
.tab-bar {
  display: flex;
  background-color: #FFFFFF;
  padding: 16rpx 10rpx;
  margin: -20rpx 20rpx 20rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 8rpx;
  border-radius: 16rpx;
  transition: all 0.3s;
}

.tab-item.active {
  background-color: rgba(45, 90, 39, 0.1);
}

.tab-icon {
  font-size: 36rpx;
  margin-bottom: 8rpx;
}

.tab-name {
  font-size: 22rpx;
  color: #666666;
}

.tab-item.active .tab-name {
  color: #2D5A27;
  font-weight: 600;
}

/* 内容区域 */
.content-area {
  padding: 0 20rpx;
}

.content-section {
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(10rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.section-intro {
  background-color: rgba(45, 90, 39, 0.05);
  padding: 24rpx 30rpx;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  border-left: 6rpx solid #2D5A27;
}

.intro-text {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.6;
}

/* 规则卡片 */
.rule-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.rule-card {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.rule-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.rule-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.rule-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  flex: 1;
}

.rule-badge {
  background-color: #E0E0E0;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.rule-badge.important {
  background-color: rgba(231, 76, 60, 0.1);
}

.badge-text {
  font-size: 20rpx;
  color: #999999;
}

.rule-badge.important .badge-text {
  color: #E74C3C;
}

.rule-content {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.8;
}

/* 底部总结 */
.footer-section {
  padding: 30rpx 20rpx;
}

.footer-card {
  background: linear-gradient(135deg, #2D5A27 0%, #4A8B3C 100%);
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  text-align: center;
}

.footer-quote {
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
  display: block;
  margin-bottom: 16rpx;
}

.footer-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  display: block;
  margin-bottom: 24rpx;
}

.footer-tags {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  background-color: rgba(255, 255, 255, 0.2);
  color: #FFFFFF;
  font-size: 22rpx;
  padding: 8rpx 20rpx;
  border-radius: 16rpx;
}
