<!--pages/safety/safety.wxml-->
<view class="safety-page">
  <!-- 顶部搜索栏 -->
  <view class="search-bar">
    <view class="search-input-wrap">
      <text class="search-icon">🔍</text>
      <input
        class="search-input"
        placeholder="搜索安全知识..."
        value="{{keyword}}"
        bindinput="onSearchInput"
        confirm-type="search"
      />
      <text class="search-clear" wx:if="{{keyword}}" bindtap="onSearchClear">✕</text>
    </view>
  </view>

  <!-- 分类Tab -->
  <scroll-view scroll-x class="tab-scroll" show-scrollbar="{{false}}">
    <view class="tab-bar">
      <view
        class="tab-item {{activeTab === index ? 'tab-active' : ''}}"
        wx:for="{{tabs}}"
        wx:key="*this"
        data-index="{{index}}"
        bindtap="onTabChange"
      >
        <text class="tab-text">{{item}}</text>
        <view class="tab-line" wx:if="{{activeTab === index}}"></view>
      </view>
    </view>
  </scroll-view>

  <!-- 知识卡片列表 -->
  <view class="knowledge-list">
    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{knowledgeList.length === 0}}">
      <text class="empty-icon">📚</text>
      <text class="empty-text">暂无相关知识内容</text>
    </view>

    <!-- 知识卡片 -->
    <view
      class="knowledge-card"
      wx:for="{{knowledgeList}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onKnowledgeTap"
    >
      <!-- 卡片头部 -->
      <view class="card-header">
        <view class="card-title-wrap">
          <text class="card-category-tag">{{item.category}}</text>
          <text class="card-title">{{item.title}}</text>
        </view>
        <text class="expand-icon">{{expandedId === item.id ? '▲' : '▼'}}</text>
      </view>

      <!-- 卡片摘要 -->
      <text class="card-summary">{{item.summary}}</text>

      <!-- 阅读数 -->
      <view class="card-footer">
        <text class="card-reads">👁 {{item.reads}} 人已阅读</text>
      </view>

      <!-- 展开详情 -->
      <view class="card-detail" wx:if="{{expandedId === item.id}}">
        <view class="detail-divider"></view>
        <text class="detail-content">{{item.content}}</text>
      </view>
    </view>
  </view>

  <!-- 底部安全提示 -->
  <view class="safety-footer">
    <view class="footer-title">
      <text class="footer-icon">⚠️</text>
      <text class="footer-title-text">安全出行提示</text>
    </view>
    <view class="tips-list">
      <view class="tip-item" wx:for="{{safetyTips}}" wx:key="*this">
        <text class="tip-bullet">•</text>
        <text class="tip-text">{{item}}</text>
      </view>
    </view>
    <text class="footer-slogan">安全第一，快乐出行 🏔️</text>
  </view>

  <!-- 返回顶部按钮 -->
  <view class="back-top" wx:if="{{showBackTop}}" bindtap="onBackTop">
    <text class="back-top-icon">↑</text>
  </view>
</view>
