/* pages/detail/detail.wxss */
.detail-page {
  padding-bottom: 120rpx;
  background-color: #F8F6F0;
  min-height: 100vh;
}

/* 路线图片 */
.trail-image {
  position: relative;
  width: 100%;
  height: 450rpx;
}

.trail-image .image {
  width: 100%;
  height: 100%;
}

.image-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 30rpx;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.7));
}

.trail-name {
  font-size: 40rpx;
  color: #FFFFFF;
  font-weight: bold;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.5);
  display: block;
  margin-bottom: 12rpx;
}

.trail-badges {
  display: flex;
  align-items: center;
}

.badge {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  margin-right: 12rpx;
}

.badge-difficulty {
  background-color: rgba(255, 140, 66, 0.9);
  color: #FFFFFF;
}

.badge-family {
  background-color: rgba(45, 90, 39, 0.9);
  color: #FFFFFF;
}

/* 信息卡片 */
.info-card {
  margin: -40rpx 24rpx 24rpx;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  position: relative;
  z-index: 1;
}

/* 基础信息 */
.basic-info {
  margin-bottom: 30rpx;
}

.info-row {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 20rpx;
}

.info-row:last-child {
  margin-bottom: 0;
}

.info-item {
  display: flex;
  flex-direction: column;
  margin-right: 40rpx;
  margin-bottom: 16rpx;
}

.item-label {
  font-size: 24rpx;
  color: #999999;
  margin-bottom: 8rpx;
}

.item-value {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}

.stars .star-text {
  color: #FF8C42;
  font-weight: bold;
}

/* 季节标签 */
.season-tags {
  display: flex;
  flex-wrap: wrap;
}

.season-tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  background-color: rgba(255, 140, 66, 0.1);
  color: #FF8C42;
  font-size: 24rpx;
  border-radius: 8rpx;
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}

/* 各个区块通用样式 */
.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
  display: block;
  margin-bottom: 20rpx;
}

/* 景色特点 */
.features-section,
.highlights-section,
.route-section,
.cost-section,
.traffic-section,
.ticket-section,
.desc-section,
.best-time-section,
.route-detail-section,
.checkpoints-section,
.food-section,
.pitfall-section,
.tips-section,
.safety-section,
.law-section,
.eco-section,
.stats-section {
  margin-bottom: 30rpx;
  padding-top: 30rpx;
  border-top: 1rpx solid #F0F0F0;
}

.feature-tags {
  display: flex;
  flex-wrap: wrap;
}

.feature-tag {
  display: inline-block;
  padding: 8rpx 20rpx;
  background-color: rgba(45, 90, 39, 0.1);
  color: #2D5A27;
  font-size: 24rpx;
  border-radius: 8rpx;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
}

/* 文本内容 */
.highlight-text,
.route-text,
.cost-text,
.traffic-text,
.ticket-text,
.desc-text,
.best-time-text,
.route-detail-text,
.checkpoints-text,
.food-text,
.pitfall-text,
.tips-text {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.8;
}

/* 安全/法律/环保 列表 */
.safety-list,
.law-list,
.eco-list {
  padding-left: 10rpx;
}

.safety-item,
.law-item,
.eco-item {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.8;
  display: block;
  margin-bottom: 12rpx;
}

.safety-item {
  color: #E74C3C;
}

/* 统计信息 */
.stats-section {
  margin-bottom: 30rpx;
}

.stats-row {
  display: flex;
  justify-content: space-around;
  text-align: center;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 36rpx;
  font-weight: bold;
  color: #2D5A27;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #999999;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background-color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}

.bar-left {
  display: flex;
  align-items: center;
}

.bar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 40rpx;
}

.bar-item:last-child {
  margin-right: 0;
}

.bar-icon {
  font-size: 40rpx;
  margin-bottom: 4rpx;
}

.bar-text {
  font-size: 20rpx;
  color: #666666;
}

.bar-right {
  flex-shrink: 0;
}

.correction-btn {
  background-color: #FF8C42;
  color: #FFFFFF;
  font-size: 28rpx;
  padding: 16rpx 40rpx;
  border-radius: 40rpx;
  border: none;
  line-height: 1.5;
}

.correction-btn::after {
  border: none;
}

.correction-btn:active {
  background-color: #e67e3a;
}
