<!--pages/checklist/checklist.wxml-->
<view class="checklist-page">

  <!-- 统一头部 -->
  <view class="page-header">
    <view class="page-header__statusbar" style="height: {{statusBarHeight}}px;"></view>
    <view class="page-header__nav">
      <view class="page-header__back" bindtap="onGoBack">
        <text class="page-header__back-icon">{{lt}}</text>
        <text class="page-header__back-text">返回</text>
      </view>
      <text class="page-header__title">📋 装备清单</text>
      <view class="page-header__spacer"></view>
    </view>
  </view>
  <view style="height: {{headerHeight}}px;"></view>

  <!-- 加载中提示 -->
  <view class="loading-overlay" wx:if="{{loading}}">
    <view class="loading-card">
      <view class="loading-spinner"></view>
      <text class="loading-text">{{loadingMsg}}</text>
    </view>
  </view>

  <!-- 进度概览 -->
  <view class="progress-card">
    <view class="progress-card__row">
      <text class="progress-card__label">准备进度</text>
      <text class="progress-card__count">{{checkedCount}}/{{totalCount}}</text>
    </view>
    <view class="progress-card__track">
      <view
        class="progress-card__fill"
        style="width: {{totalCount > 0 ? (checkedCount / totalCount * 100) : 0}}%"
      ></view>
    </view>
    <text class="progress-card__tip" wx:if="{{checkedCount === totalCount && totalCount > 0}}">🎉 全部准备完毕！可以出发了！</text>
    <text class="progress-card__tip" wx:elif="{{checkedCount > 0}}">还差 {{totalCount - checkedCount}} 项，继续加油！</text>
    <text class="progress-card__tip" wx:else>开始准备吧！逐项打勾 ✅</text>
  </view>

  <!-- 天气概况（已移除：天气与出发日不同步，无参考性） -->

  <!-- 必须带 -->
  <view class="check-group" wx:if="{{equipment.must.length > 0}}">
    <view class="check-group__head check-group__head--must">
      <text class="check-group__dot" style="background: #F44336;"></text>
      <text class="check-group__title">必须带</text>
      <text class="check-group__badge">缺了会很麻烦</text>
    </view>
    <view class="check-group__list">
      <view
        class="check-item {{item.checked ? 'check-item--on' : ''}}"
        wx:for="{{equipment.must}}"
        wx:key="id"
        data-id="{{item.id}}"
        data-category="must"
        data-index="{{index}}"
        bindtap="onCheckItem"
      >
        <view class="check-item__box {{item.checked ? 'check-item__box--on' : ''}}">
          <text class="check-item__tick" wx:if="{{item.checked}}">✓</text>
        </view>
        <text class="check-item__text">{{item.displayName || item.name}}</text>
      </view>
    </view>
  </view>

  <!-- 建议带 -->
  <view class="check-group" wx:if="{{equipment.suggest.length > 0}}">
    <view class="check-group__head check-group__head--suggest">
      <text class="check-group__dot" style="background: #FF9800;"></text>
      <text class="check-group__title">建议带</text>
      <text class="check-group__badge">有了更舒适</text>
    </view>
    <view class="check-group__list">
      <view
        class="check-item {{item.checked ? 'check-item--on' : ''}}"
        wx:for="{{equipment.suggest}}"
        wx:key="id"
        data-id="{{item.id}}"
        data-category="suggest"
        data-index="{{index}}"
        bindtap="onCheckItem"
      >
        <view class="check-item__box {{item.checked ? 'check-item__box--on' : ''}}">
          <text class="check-item__tick" wx:if="{{item.checked}}">✓</text>
        </view>
        <text class="check-item__text">{{item.displayName || item.name}}</text>
      </view>
    </view>
    <!-- 添加自定义物品按钮 -->
    <view class="add-custom-btn" bindtap="onAddCustomItem">
      <text class="add-custom-btn__icon">+</text>
      <text class="add-custom-btn__text">添加自定义物品</text>
    </view>
  </view>

  <!-- 不用带 -->
  <view class="check-group" wx:if="{{equipment.noNeed.length > 0}}">
    <view class="check-group__head check-group__head--noneed">
      <text class="check-group__dot" style="background: #4CAF50;"></text>
      <text class="check-group__title">不用带</text>
      <text class="check-group__badge">轻装上阵就好</text>
    </view>
    <view class="check-group__list">
      <view class="check-item check-item--dim" wx:for="{{equipment.noNeed}}" wx:key="id">
        <view class="check-item__box check-item__box--disabled">
          <text class="check-item__cross">✕</text>
        </view>
        <text class="check-item__text">{{item.displayName || item.name}}</text>
      </view>
    </view>
  </view>

  <!-- 底部操作栏 -->
  <view class="bottom-bar">
    <view class="bottom-bar__btn bottom-bar__btn--reset" bindtap="onReset">
      <text>🔄</text>
      <text>重置</text>
    </view>
    <button class="bottom-bar__btn bottom-bar__btn--share" bindtap="onShareChecklist">
      <text>📤</text>
      <text>分享清单</text>
    </button>
  </view>

  <canvas type="2d" id="checklist-canvas" canvas-id="checklist-canvas" class="share-canvas"></canvas>
  <view class="nice-toast nice-toast--{{toastType}} {{showToast ? 'nice-toast--show' : ''}}">{{toastMessage}}</view>
</view>
