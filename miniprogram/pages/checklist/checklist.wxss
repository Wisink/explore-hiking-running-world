/* pages/checklist/checklist.wxss - v2.0 */

.checklist-page {
  min-height: 100vh;
  background: #FAFAF5;
  padding-bottom: 180rpx;
}

/* 顶部标题栏 */
.header {
  position: relative;
  overflow: hidden;
}

.header__bg {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(135deg, #2E7D32 0%, #388E3C 100%);
}

.header__content {
  position: relative;
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
}

.header__back {
  width: 68rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.15);
}

.header__back-icon {
  font-size: 34rpx;
  color: #FFFFFF;
}

.header__center {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.header__title {
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.header__sub {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.75);
  margin-top: 4rpx;
  max-width: 400rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.header__spacer {
  width: 68rpx;
}

/* 进度卡片 */
.progress-card {
  background: #FFFFFF;
  margin: 24rpx;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.progress-card__row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.progress-card__label {
  font-size: 28rpx;
  font-weight: 600;
  color: #303028;
}

.progress-card__count {
  font-size: 28rpx;
  font-weight: 700;
  color: #2E7D32;
}

.progress-card__track {
  width: 100%;
  height: 16rpx;
  background: #F0F0EB;
  border-radius: 8rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.progress-card__fill {
  height: 100%;
  background: linear-gradient(90deg, #4CAF50 0%, #2E7D32 100%);
  border-radius: 8rpx;
  transition: width 350ms cubic-bezier(0.4, 0, 0.2, 1);
}

.progress-card__tip {
  font-size: 24rpx;
  color: #757570;
}

/* 清单分组 */
.check-group {
  background: #FFFFFF;
  margin: 0 24rpx 20rpx;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.check-group__head {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 22rpx 28rpx;
  border-bottom: 1rpx solid #F0F0EB;
}

.check-group__head--must { background: #FFF5F5; }
.check-group__head--suggest { background: #FFFBF0; }
.check-group__head--noneed { background: #F5FFF5; }

.check-group__dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}

.check-group__title {
  font-size: 28rpx;
  font-weight: 600;
  color: #303028;
}

.check-group__badge {
  font-size: 22rpx;
  color: #9E9E99;
  margin-left: auto;
}

/* 清单项 */
.check-group__list {
  padding: 8rpx 0;
}

.check-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 28rpx;
  transition: background 150ms ease;
}

.check-item:active {
  background: #F5F5F0;
}

.check-item--on {
  background: #F9FFF9;
}

.check-item--on .check-item__text {
  color: #C0C0BB;
  text-decoration: line-through;
}

.check-item--dim {
  opacity: 0.55;
}

.check-item--dim .check-item__text {
  color: #9E9E99;
  text-decoration: line-through;
}

/* 勾选框 */
.check-item__box {
  width: 44rpx;
  height: 44rpx;
  border: 3rpx solid #D0D0DB;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all 200ms cubic-bezier(0.34, 1.56, 0.64, 1);
}

.check-item__box--on {
  background: linear-gradient(135deg, #2E7D32 0%, #43A047 100%);
  border-color: #2E7D32;
  transform: scale(1.05);
  box-shadow: 0 2rpx 8rpx rgba(46, 125, 50, 0.3);
}

.check-item__box--disabled {
  background: #F5F5F0;
  border-color: #E0E0DB;
}

.check-item__tick {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: bold;
}

.check-item__cross {
  font-size: 24rpx;
  color: #C0C0BB;
}

.check-item__text {
  font-size: 28rpx;
  color: #303028;
  transition: all 200ms ease;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(12rpx);
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.bottom-bar__btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 88rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  padding: 0;
  line-height: 88rpx;
  margin: 0;
  transition: transform 150ms ease;
}

.bottom-bar__btn:active {
  transform: scale(0.96);
}

.bottom-bar__btn::after { border: none; }

.bottom-bar__btn--reset {
  background: #F5F5F0;
  color: #616156;
}

.bottom-bar__btn--share {
  background: linear-gradient(135deg, #2E7D32 0%, #43A047 100%);
  color: #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(46, 125, 50, 0.25);
}

.share-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 600px;
  height: 2000px;
}
