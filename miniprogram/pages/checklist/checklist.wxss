/* pages/checklist/checklist.wxss - v3.0 自然清新风 + 毛玻璃 */
@import '/styles/common.wxss';

.checklist-page {
  min-height: 100vh;
  padding-bottom: 180rpx;
  background-color: #c8e6c9;
  background:
    radial-gradient(ellipse at 20% 50%, rgba(129,199,132,.35) 0%, transparent 50%),
    radial-gradient(ellipse at 80% 20%, rgba(165,214,167,.25) 0%, transparent 50%),
    radial-gradient(ellipse at 60% 80%, rgba(76,175,80,.2) 0%, transparent 50%),
    linear-gradient(160deg, #e8f5e9 0%, #c8e6c9 25%, #a5d6a7 50%, #81c784 75%, #66bb6a 100%);
}

/* 进度卡片 — 毛玻璃 */
.progress-card {
  background: rgba(255, 255, 255, 0.22);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(255,255,255,.25);
  margin: 24rpx;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(31,38,50,.15);
}

.progress-card__row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.progress-card__label {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a2e1a;
}

.progress-card__count {
  font-size: 28rpx;
  font-weight: 700;
  color: #2d6a4f;
}

.progress-card__track {
  width: 100%;
  height: 16rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 8rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.progress-card__fill {
  height: 100%;
  background: linear-gradient(90deg, rgba(76,175,80,.8) 0%, rgba(46,125,50,.8) 100%);
  border-radius: 8rpx;
  transition: width 350ms cubic-bezier(0.4, 0, 0.2, 1);
}

.progress-card__tip {
  font-size: 24rpx;
  color: #6b8b6b;
}

/* 清单分组 — 毛玻璃 */
.check-group {
  background: rgba(255, 255, 255, 0.18);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border: 1px solid rgba(255,255,255,.2);
  margin: 0 24rpx 20rpx;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(31,38,50,.1);
}

.check-group__head {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 22rpx 28rpx;
  border-bottom: 1px solid rgba(255,255,255,.12);
}

.check-group__head--must { background: rgba(255, 245, 245, 0.3); }
.check-group__head--suggest { background: rgba(255, 251, 240, 0.3); }
.check-group__head--noneed { background: rgba(245, 255, 245, 0.3); }

.check-group__dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}

.check-group__title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a2e1a;
}

.check-group__badge {
  font-size: 22rpx;
  color: #6b8b6b;
  margin-left: auto;
}

/* 清单项 */
.check-group__list { padding: 8rpx 0; }

.check-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 28rpx;
  transition: background 150ms ease;
}

.check-item:active { background: rgba(255,255,255,.08); }

.check-item--on { background: rgba(200, 230, 201, 0.15); }

.check-item--on .check-item__text {
  color: #6b8b6b;
  text-decoration: line-through;
}

.check-item--dim { opacity: 1; }

.check-item--dim .check-item__text {
  color: #6b8b6b;
  text-decoration: line-through;
}

/* 勾选框 */
.check-item__box {
  width: 44rpx;
  height: 44rpx;
  border: 3rpx solid rgba(255,255,255,.3);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
  transition: all 200ms cubic-bezier(0.34, 1.56, 0.64, 1);
}

.check-item__box--on {
  background: linear-gradient(135deg, rgba(46,125,50,.8) 0%, rgba(67,160,71,.8) 100%);
  border-color: rgba(76, 175, 80, 0.5);
  transform: scale(1.05);
  box-shadow: 0 2rpx 8rpx rgba(46, 125, 50, 0.3);
}

.check-item__box--disabled {
  background: rgba(255, 255, 255, 0.08);
  border-color: rgba(255,255,255,.15);
}

.check-item__tick { font-size: 28rpx; color: #FFFFFF; font-weight: bold; }
.check-item__cross { font-size: 24rpx; color: #6b8b6b; }

.check-item__text {
  font-size: 28rpx;
  color: #1a2e1a;
  transition: all 200ms ease;
}

/* 添加自定义物品按钮 */
.add-custom-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 22rpx 28rpx;
  border-top: 1px dashed rgba(255,255,255,.2);
  transition: background 150ms ease;
}

.add-custom-btn:active { background: rgba(255,255,255,.08); }

.add-custom-btn__icon { font-size: 32rpx; color: #2d6a4f; font-weight: 700; }
.add-custom-btn__text { font-size: 26rpx; color: #2d6a4f; font-weight: 500; }

/* 底部操作栏 — 毛玻璃 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.12);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-top: 1px solid rgba(255,255,255,.2);
  box-shadow: 0 -4rpx 16rpx rgba(31,38,50,.06);
  z-index: 100;
}

.bottom-bar__btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 88rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  padding: 0;
  line-height: 88rpx;
  margin: 0;
  transition: transform 150ms ease;
}

.bottom-bar__btn:active { transform: scale(0.96); }
.bottom-bar__btn::after { border: none; }

.bottom-bar__btn--reset {
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  color: #4a6b4a;
  border: 1px solid rgba(255,255,255,.2);
}

.bottom-bar__btn--share {
  background: linear-gradient(135deg, rgba(46,125,50,.85) 0%, rgba(67,160,71,.85) 100%);
  color: #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(46, 125, 50, 0.25);
  border: 1px solid rgba(255,255,255,.2);
}

.share-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 600px;
  height: 2000px;
}

/* 天气概况条 */
.weather-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 20rpx 32rpx 0;
  padding: 16rpx 24rpx;
  background: rgba(255, 255, 255, 0.35);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border-radius: 16rpx;
  border: 1px solid rgba(255, 255, 255, 0.3);
}

.weather-bar__icon {
  font-size: 28rpx;
}

.weather-bar__text {
  font-size: 24rpx;
  color: #2E7D32;
  font-weight: 500;
}

.weather-bar__tip {
  font-size: 20rpx;
  color: #66BB6A;
  margin-left: auto;
  white-space: nowrap;
}
