/* pages/welcome/welcome.wxss */
.welcome-page {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
}

/* 背景图 */
.bg-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.bg-image .bg {
  width: 100%;
  height: 100%;
}

.bg-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(
    to bottom,
    rgba(45, 90, 39, 0.7) 0%,
    rgba(45, 90, 39, 0.5) 50%,
    rgba(45, 90, 39, 0.8) 100%
  );
}

/* 内容区域 */
.content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  height: 100%;
  padding: 120rpx 60rpx 100rpx;
  box-sizing: border-box;
}

/* Logo区域 */
.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.logo-icon {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 30rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
}

.logo-text {
  font-size: 72rpx;
  color: #FFFFFF;
  font-weight: bold;
}

.app-name {
  font-size: 52rpx;
  color: #FFFFFF;
  font-weight: bold;
  margin-bottom: 16rpx;
  letter-spacing: 8rpx;
}

.slogan {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.9);
  letter-spacing: 4rpx;
}

/* 功能亮点 */
.features {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 30rpx;
}

.feature-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 280rpx;
  padding: 30rpx 20rpx;
  background-color: rgba(255, 255, 255, 0.15);
  border-radius: 16rpx;
}

.feature-icon {
  font-size: 36rpx;
  color: #FFFFFF;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.feature-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  text-align: center;
}

/* 安全承诺 */
.safety-promise {
  padding: 20rpx 40rpx;
  background-color: rgba(255, 140, 66, 0.3);
  border-radius: 40rpx;
  border: 2rpx solid rgba(255, 140, 66, 0.5);
}

.promise-text {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 500;
}

/* 开始按钮 */
.btn-area {
  width: 100%;
}

.start-btn {
  width: 100%;
  height: 96rpx;
  background-color: #FFFFFF;
  color: #2D5A27;
  font-size: 34rpx;
  font-weight: bold;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 4rpx;
}

.start-btn:active {
  background-color: #F0F0F0;
}
