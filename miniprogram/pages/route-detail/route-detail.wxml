<!--pages/route-detail/route-detail.wxml - 新版毛玻璃设计 v2.0-->
<view class="detail-page">

  <!-- 状态栏占位 -->
  <view class="statusbar-bg" style="height: {{statusBarHeight}}px;"></view>

  <!-- Loading -->
  <view class="loading-wrap" wx:if="{{loading}}">
    <view class="loading-ring"></view>
    <text class="loading-label">加载路线详情...</text>
  </view>

  <block wx:if="{{!loading}}">

  <!-- 离线状态提示 -->
  <view class="offline-bar" wx:if="{{isOffline}}">
    <text class="offline-bar__icon">📡</text>
    <text class="offline-bar__text">离线模式 · 显示已缓存内容</text>
  </view>

  <!-- 1. 封面图区域 -->
  <view class="hero-section">
    <image 
      class="hero-section__img" 
      src="{{trail.images[0]}}" 
      mode="aspectFill"
      bindtap="onPreviewImage"
      data-src="{{trail.images[0]}}"
    />
    <view class="hero-section__overlay"></view>
    
    <!-- 左上角返回按钮 -->
    <view class="hero-section__back" bindtap="onBack">
      <text class="hero-section__back-icon">←</text>
    </view>
    
    <!-- 右上角收藏分享 -->
    <view class="hero-section__actions">
      <view class="hero-section__action {{isFavorited ? 'hero-section__action--on' : ''}}" bindtap="onFavorite">
        <text class="hero-section__action-icon">{{isFavorited ? '❤️' : '🤍'}}</text>
      </view>
      <view class="hero-section__action" bindtap="onShareTap">
        <text class="hero-section__action-icon">📤</text>
      </view>
    </view>
    
    <!-- 底部叠加信息 -->
    <view class="hero-section__info">
      <!-- 难度徽章 -->
      <view class="diff-badge" style="background: {{trail.diffColor}}">
        <text>{{trail.diffText}}</text>
      </view>
      <!-- 路线名称 -->
      <text class="hero-section__name">{{trail.name}}</text>
      <!-- 短描述 -->
      <text class="hero-section__desc">{{trail.description}}</text>
    </view>
  </view>

  <!-- 2. 核心数据区 -->
  <view class="core-data-card">
    <view class="core-data-card__item">
      <text class="core-data-card__val">{{trail.distanceKm || trail.distance || '--'}}</text>
      <text class="core-data-card__unit">km</text>
      <text class="core-data-card__label">距离</text>
    </view>
    <view class="core-data-card__divider"></view>
    <view class="core-data-card__item">
      <text class="core-data-card__val">{{trail.durationMin || '--'}}{{trail.durationMax ? '-' + trail.durationMax : ''}}</text>
      <text class="core-data-card__unit">h</text>
      <text class="core-data-card__label">时长</text>
    </view>
    <view class="core-data-card__divider"></view>
    <view class="core-data-card__item">
      <text class="core-data-card__val">{{trail.elevationGain || trail.elevation || '--'}}</text>
      <text class="core-data-card__unit">m</text>
      <text class="core-data-card__label">爬升</text>
    </view>
    <view class="core-data-card__divider"></view>
    <view class="core-data-card__item">
      <view class="diff-stars">
        <text class="diff-star" wx:for="{{5}}" wx:key="index">{{index < trail.diffStars ? '★' : '☆'}}</text>
      </view>
      <text class="core-data-card__label">难度</text>
    </view>
  </view>

  <!-- 3. 地形与特色标签区 -->
  <view class="tag-section" wx:if="{{trail.terrainLabels.length > 0 || trail.routeDNALabels.length > 0}}">
    <!-- 地形标签 -->
    <view class="tag-scroll" wx:if="{{trail.terrainLabels.length > 0}}">
      <text class="tag-scroll__label">🏔️ 地形</text>
      <scroll-view class="tag-scroll__wrap" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
        <view class="tag-scroll__inner">
          <text class="tag-pill tag-pill--terrain" wx:for="{{trail.terrainLabels}}" wx:key="*this">{{item}}</text>
        </view>
      </scroll-view>
    </view>
    <!-- DNA特色标签 -->
    <view class="tag-scroll" wx:if="{{trail.routeDNALabels.length > 0}}">
      <text class="tag-scroll__label">✨ 特色</text>
      <scroll-view class="tag-scroll__wrap" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
        <view class="tag-scroll__inner">
          <text class="tag-pill tag-pill--dna" wx:for="{{trail.routeDNALabels}}" wx:key="*this">{{item}}</text>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 4. 基本信息折叠区 -->
  <view class="accordion">
    <view class="accordion__head" data-key="basic" bindtap="onToggleSection">
      <text class="accordion__title">📋 基本信息</text>
      <text class="accordion__arrow {{sectionOpen.basic ? 'accordion__arrow--open' : ''}}">▼</text>
    </view>
    <view class="accordion__body {{sectionOpen.basic ? 'accordion__body--open' : ''}}">
      <!-- 最佳季节 -->
      <view class="info-row" wx:if="{{trail.bestSeasonLabels.length > 0}}">
        <text class="info-row__label">📅 最佳季节</text>
        <view class="info-row__tags">
          <text class="season-tag" wx:for="{{trail.bestSeasonLabels}}" wx:key="*this">{{item}}</text>
        </view>
      </view>
      <!-- 技术等级 -->
      <view class="info-row" wx:if="{{trail.technicalGradeLabel}}">
        <text class="info-row__label">🎯 技术等级</text>
        <text class="info-row__value">{{trail.technicalGradeLabel}}</text>
      </view>
      <!-- 安全等级 -->
      <view class="info-row" wx:if="{{trail.safetyLabel}}">
        <text class="info-row__label">🛡️ 安全等级</text>
        <view class="info-row__progress">
          <view class="progress-bar">
            <view class="progress-bar__fill progress-bar__fill--safety" style="width: {{trail.safetyLevel * 20}}%"></view>
          </view>
          <text class="progress-bar__text">{{trail.safetyLabel}}</text>
        </view>
      </view>
      <!-- 亲子友好 -->
      <view class="info-row" wx:if="{{trail.familyLabel}}">
        <text class="info-row__label">👨‍👩‍👧 亲子友好</text>
        <view class="info-row__progress">
          <view class="progress-bar">
            <view class="progress-bar__fill progress-bar__fill--family" style="width: {{trail.familyFriendly * 20}}%"></view>
          </view>
          <text class="progress-bar__text">{{trail.familyLabel}}</text>
        </view>
      </view>
      <!-- 手机信号 -->
      <view class="info-row" wx:if="{{trail.cellCoverageLabel}}">
        <text class="info-row__label">📶 手机信号</text>
        <text class="info-row__value">{{trail.cellCoverageLabel}}</text>
      </view>
      <!-- 路线标识 -->
      <view class="info-row" wx:if="{{trail.trailMarkingLabel}}">
        <text class="info-row__label">🛤️ 路线标识</text>
        <text class="info-row__value">{{trail.trailMarkingLabel}}</text>
      </view>
      <!-- 水源情况 -->
      <view class="info-row" wx:if="{{trail.waterSupplyLabel}}">
        <text class="info-row__label">💧 水源情况</text>
        <text class="info-row__value">{{trail.waterSupplyLabel}}</text>
      </view>
      <!-- 预计消耗 -->
      <view class="info-row" wx:if="{{trail.estimatedCalories}}">
        <text class="info-row__label">🔥 预计消耗</text>
        <text class="info-row__value">{{trail.estimatedCalories}} 千卡</text>
      </view>
      <!-- 休整点数 -->
      <view class="info-row" wx:if="{{trail.restPoints}}">
        <text class="info-row__label">⛑️ 休整点数</text>
        <text class="info-row__value">{{trail.restPoints}} 个</text>
      </view>
    </view>
  </view>

  <!-- 5. 地区与位置区 -->
  <view class="location-card">
    <view class="location-card__badge" wx:if="{{trail.district}}">
      <text class="location-card__badge-icon">📍</text>
      <text class="location-card__badge-text">{{trail.district}}</text>
    </view>
    <view class="location-card__elevation" wx:if="{{trail.elevationMin || trail.elevationMax}}">
      <text class="location-card__elevation-label">海拔范围</text>
      <text class="location-card__elevation-val">{{trail.elevationMin || '--'}} ~ {{trail.elevationMax || '--'}} m</text>
    </view>
  </view>

  <!-- 6. 路线描述 -->
  <view class="desc-card">
    <view class="desc-card__header">
      <text class="desc-card__title">📝 路线详情</text>
    </view>
    <view class="desc-card__content {{descExpanded ? '' : 'desc-card__content--collapsed'}}">
      <text class="desc-card__text">{{trail.fullDesc || trail.description}}</text>
    </view>
    <view class="desc-card__toggle" bindtap="onToggleDesc" wx:if="{{trail.fullDesc && trail.fullDesc.length > 100}}">
      <text>{{descExpanded ? '收起 ▲' : '展开 ▼'}}</text>
    </view>
  </view>

  <!-- 7. 交通信息区 -->
  <view class="accordion">
    <view class="accordion__head" data-key="traffic" bindtap="onToggleSection">
      <text class="accordion__title">🚗 交通信息</text>
      <text class="accordion__arrow {{sectionOpen.traffic ? 'accordion__arrow--open' : ''}}">▼</text>
    </view>
    <view class="accordion__body {{sectionOpen.traffic ? 'accordion__body--open' : ''}}">
      <!-- 停车信息 -->
      <view class="traffic-item" wx:if="{{trail.hasParking}}">
        <text class="traffic-item__type">🚘 自驾停车</text>
        <text class="traffic-item__detail">{{trail.parkingNote || '有停车场'}}</text>
      </view>
      <!-- 公共交通 -->
      <view class="traffic-item" wx:if="{{trail.publicTransport}}">
        <text class="traffic-item__type">🚌 公共交通</text>
        <text class="traffic-item__detail">{{trail.publicTransport}}</text>
      </view>
      <!-- 自驾指南 -->
      <view class="traffic-item" wx:if="{{trail.drivingGuide}}">
        <text class="traffic-item__type">🚗 自驾指南</text>
        <text class="traffic-item__detail">{{trail.drivingGuide}}</text>
      </view>
      <view class="traffic-item" wx:if="{{!trail.hasParking && !trail.publicTransport && !trail.drivingGuide}}">
        <text class="traffic-item__detail traffic-item__detail--empty">暂无交通信息</text>
      </view>
    </view>
  </view>

  <!-- 8. 起点/终点信息 -->
  <view class="endpoint-card" wx:if="{{trail.startName || trail.endName}}">
    <view class="endpoint-card__item" wx:if="{{trail.startName}}">
      <view class="endpoint-card__icon">🚩</view>
      <view class="endpoint-card__content">
        <text class="endpoint-card__label">起点</text>
        <text class="endpoint-card__name">{{trail.startName}}</text>
      </view>
    </view>
    <view class="endpoint-card__divider" wx:if="{{trail.startName && trail.endName}}"></view>
    <view class="endpoint-card__item" wx:if="{{trail.endName}}">
      <view class="endpoint-card__icon">🏁</view>
      <view class="endpoint-card__content">
        <text class="endpoint-card__label">终点</text>
        <text class="endpoint-card__name">{{trail.endName}}</text>
      </view>
    </view>
  </view>

  <!-- 9. 操作按钮区 -->
  <view class="action-bar">
    <view class="action-bar__btn" bindtap="onNavTap">
      <text class="action-bar__btn-icon">🧭</text>
      <text class="action-bar__btn-text">导航去起点</text>
    </view>
    <view class="action-bar__btn">
      <text class="action-bar__btn-icon">📵</text>
      <text class="action-bar__btn-text">查看离线地图</text>
    </view>
    <view class="action-bar__btn" bindtap="onGoChecklist">
      <text class="action-bar__btn-icon">📋</text>
      <text class="action-bar__btn-text">加入清单</text>
    </view>
    <view class="action-bar__btn action-bar__btn--fav {{isFavorited ? 'action-bar__btn--on' : ''}}" bindtap="onFavorite">
      <text class="action-bar__btn-icon">{{isFavorited ? '❤️' : '🤍'}}</text>
      <text class="action-bar__btn-text">{{isFavorited ? '已收藏' : '收藏'}}</text>
    </view>
  </view>

  <view class="bottom-safe"></view>

  <!-- 分享图片 Canvas（隐藏） -->
  <canvas type="2d" id="share-canvas" style="width: 600px; height: 1500px; position: fixed; top: -9999px; left: 0; opacity: 0;"></canvas>

  </block>

  <!-- ===== 收藏成功提示弹窗 ===== -->
  <view class="hint-overlay" wx:if="{{showFavHint}}" bindtap="onCloseFavHint">
    <view class="hint-popup" catchtap="">
      <view class="hint-popup__icon">❤️</view>
      <view class="hint-popup__title">收藏成功！</view>
      <view class="hint-popup__desc">这条路线收藏好了，你可以在「个人中心」-「我的收藏」中查看所有收藏的路线哦！</view>
      <view class="hint-popup__btn" bindtap="onCloseFavHint">我知道了</view>
    </view>
  </view>

  <!-- ===== 固定底部操作栏 ===== -->
  <view class="fixed-bottom-bar" wx:if="{{!loading}}">
    <view
      class="fixed-bottom-bar__btn {{completedToday ? 'fixed-bottom-bar__btn--today' : ''}}"
      bindtap="onCompleteTrail"
    >
      <text wx:if="{{completedToday}}">✅ 今日已走过</text>
      <text wx:elif="{{isCompleted}}">✅ 标记为已走过（已走过{{completedCount}}次）</text>
      <text wx:else>✅ 标记为已走过</text>
    </view>
  </view>

  <view class="nice-toast nice-toast--{{toastType}} {{showToast ? 'nice-toast--show' : ''}}">{{toastMessage}}</view>
</view>

function showNiceToast(that, message, type = 'info', duration = 2000) {
  that.setData({ showToast: true, toastMessage: message, toastType: type })
  setTimeout(function() { that.setData({ showToast: false }) }, duration)
}
