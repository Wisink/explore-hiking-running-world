<!--pages/route-detail/route-detail.wxml-->
<view class="detail-page">

  <!-- Loading -->
  <view class="loading-wrap" wx:if="{{loading}}">
    <view class="loading-ring"></view>
    <text class="loading-label">加载路线详情...</text>
  </view>

  <block wx:if="{{!loading}}">

  <!-- 1. 图片轮播区 -->
  <view class="hero-swiper">
    <swiper
      class="hero-swiper__main"
      autoplay
      circular
      interval="4000"
      duration="300"
      bindchange="onSwiperChange"
    >
      <swiper-item wx:for="{{trail.images}}" wx:key="index">
        <image
          class="hero-swiper__img"
          src="{{item}}"
          mode="aspectFill"
          bindtap="onPreviewImage"
          data-src="{{item}}"
        />
      </swiper-item>
    </swiper>
    <view class="hero-swiper__overlay"></view>
    <view class="hero-swiper__dots">
      <view
        class="hero-swiper__dot {{currentSwiperIndex === index ? 'hero-swiper__dot--on' : ''}}"
        wx:for="{{trail.images}}"
        wx:key="index"
      ></view>
    </view>
    <view class="hero-swiper__count">{{currentSwiperIndex + 1}}/{{trail.images.length}}</view>
  </view>

  <!-- 2. 路线信息卡 -->
  <view class="info-card">
    <text class="info-card__name">{{trail.name}}</text>
    <text class="info-card__desc">{{trail.description}}</text>

    <!-- 难度 -->
    <view class="info-card__diff">
      <view class="diff-badge" style="background: {{trail.diffColor}}">
        <text>{{trail.difficulty}}</text>
      </view>
      <view class="diff-stars">
        <text class="diff-star" wx:for="{{5}}" wx:key="index">{{index < trail.diffStars ? '★' : '☆'}}</text>
      </view>
      <text class="diff-hint">{{trail.diffText}}</text>
    </view>

    <!-- 核心数据 -->
    <view class="data-grid">
      <view class="data-grid__item" wx:if="{{trail.distance}}">
        <text class="data-grid__icon">📏</text>
        <text class="data-grid__val">{{trail.distance}}</text>
        <text class="data-grid__label">距离</text>
      </view>
      <view class="data-grid__item" wx:if="{{trail.duration}}">
        <text class="data-grid__icon">⏱</text>
        <text class="data-grid__val">{{trail.duration}}</text>
        <text class="data-grid__label">耗时</text>
      </view>
      <view class="data-grid__item" wx:if="{{trail.elevation}}">
        <text class="data-grid__icon">📈</text>
        <text class="data-grid__val">{{trail.elevation}}</text>
        <text class="data-grid__label">爬升</text>
      </view>
    </view>

    <!-- 费用 -->
    <view class="cost-row" wx:if="{{trail.cost}}">
      <text class="cost-row__icon">💰</text>
      <text class="cost-row__label">费用</text>
      <text class="cost-row__val">{{trail.cost}}</text>
    </view>

    <!-- 适合人群 -->
    <view class="tag-section" wx:if="{{trail.suitableFor.length > 0}}">
      <text class="tag-section__label">👥 适合人群</text>
      <view class="tag-section__list">
        <text class="tag-section__item" wx:for="{{trail.suitableFor}}" wx:key="*this">{{item}}</text>
      </view>
    </view>

    <!-- 最佳季节 -->
    <view class="tag-section" wx:if="{{trail.bestSeason.length > 0}}">
      <text class="tag-section__label">📅 最佳季节</text>
      <view class="tag-section__list">
        <text class="tag-section__item tag-section__item--season" wx:for="{{trail.bestSeason}}" wx:key="*this">{{item}}</text>
      </view>
    </view>
  </view>

  <!-- 3. 操作按钮区 -->
  <view class="action-bar">
    <view class="action-bar__item {{isFavorited ? 'action-bar__item--on' : ''}}" bindtap="onFavorite">
      <text class="action-bar__icon">{{isFavorited ? '❤️' : '🤍'}}</text>
      <text class="action-bar__text">{{isFavorited ? '已收藏' : '收藏'}}</text>
    </view>
    <button class="action-bar__item" open-type="share">
      <text class="action-bar__icon">📤</text>
      <text class="action-bar__text">分享</text>
    </button>
    <view class="action-bar__item" bindtap="onGoChecklist">
      <text class="action-bar__icon">📋</text>
      <text class="action-bar__text">行前清单</text>
    </view>
    <view class="action-bar__item" bindtap="onCopyNavAddress">
      <text class="action-bar__icon">📍</text>
      <text class="action-bar__text">复制地址</text>
    </view>
  </view>

  <!-- 4. Accordion 折叠区 -->
  <!-- 分段路况 -->
  <view class="accordion" wx:if="{{trail.sections && trail.sections.length > 0}}">
    <view class="accordion__head" data-key="sections" bindtap="onToggleSection">
      <text class="accordion__title">🗺️ 分段路况</text>
      <text class="accordion__arrow {{sectionOpen.sections ? 'accordion__arrow--open' : ''}}">▼</text>
    </view>
    <view class="accordion__body {{sectionOpen.sections ? 'accordion__body--open' : ''}}">
      <view class="timeline" wx:for="{{trail.sections}}" wx:key="index">
        <view class="timeline__dot"></view>
        <view class="timeline__line" wx:if="{{index < trail.sections.length - 1}}"></view>
        <view class="timeline__content">
          <text class="timeline__name">{{item.name}}</text>
          <text class="timeline__desc">{{item.desc}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 风景亮点 -->
  <view class="accordion" wx:if="{{trail.highlights}}">
    <view class="accordion__head" data-key="scenery" bindtap="onToggleSection">
      <text class="accordion__title">🌿 风景亮点</text>
      <text class="accordion__arrow {{sectionOpen.scenery ? 'accordion__arrow--open' : ''}}">▼</text>
    </view>
    <view class="accordion__body {{sectionOpen.scenery ? 'accordion__body--open' : ''}}">
      <text class="highlight-text">{{trail.highlights}}</text>
      <view class="checkpoint" wx:if="{{trail.checkpoints}}">
        <text class="checkpoint__title">📸 打卡点</text>
        <text class="checkpoint__text">{{trail.checkpoints}}</text>
      </view>
    </view>
  </view>

  <!-- 交通方案 -->
  <view class="accordion">
    <view class="accordion__head" data-key="traffic" bindtap="onToggleSection">
      <text class="accordion__title">🚗 交通方案</text>
      <text class="accordion__arrow {{sectionOpen.traffic ? 'accordion__arrow--open' : ''}}">▼</text>
    </view>
    <view class="accordion__body {{sectionOpen.traffic ? 'accordion__body--open' : ''}}">
      <view class="traffic-item">
        <text class="traffic-item__type">🚘 自驾</text>
        <text class="traffic-item__detail">{{trail.navAddress}}</text>
        <view class="traffic-item__copy" bindtap="onCopyNavAddress">
          <text>📋 复制导航地址</text>
        </view>
      </view>
      <view class="traffic-item" wx:if="{{trail.publicTransport}}">
        <text class="traffic-item__type">🚌 公交</text>
        <text class="traffic-item__detail">{{trail.publicTransport}}</text>
      </view>
    </view>
  </view>

  <!-- 5. 装备清单 -->
  <view class="accordion">
    <view class="accordion__head" data-key="equipment" bindtap="onToggleSection">
      <text class="accordion__title">🎒 装备清单</text>
      <text class="accordion__arrow {{sectionOpen.equipment ? 'accordion__arrow--open' : ''}}">▼</text>
    </view>
    <view class="accordion__body {{sectionOpen.equipment ? 'accordion__body--open' : ''}}">
      <!-- 必须 -->
      <view class="equip-group">
        <view class="equip-group__head equip-group__head--must">
          <text class="equip-group__dot" style="background: #F44336;"></text>
          <text class="equip-group__title">必须带</text>
        </view>
        <text class="equip-group__item" wx:for="{{trail.equipment.must}}" wx:key="*this">• {{item}}</text>
      </view>
      <!-- 建议 -->
      <view class="equip-group">
        <view class="equip-group__head equip-group__head--suggest">
          <text class="equip-group__dot" style="background: #FF9800;"></text>
          <text class="equip-group__title">建议带</text>
        </view>
        <text class="equip-group__item" wx:for="{{trail.equipment.suggest}}" wx:key="*this">• {{item}}</text>
      </view>
      <!-- 不用 -->
      <view class="equip-group">
        <view class="equip-group__head equip-group__head--noneed">
          <text class="equip-group__dot" style="background: #4CAF50;"></text>
          <text class="equip-group__title">不用带</text>
        </view>
        <text class="equip-group__item equip-group__item--dim" wx:for="{{trail.equipment.noNeed}}" wx:key="*this">• {{item}}</text>
      </view>
      <view class="equip-link" bindtap="onGoChecklist">
        <text>📋 查看完整行前清单 →</text>
      </view>
    </view>
  </view>

  <!-- 门票 / 餐饮 / 避坑 / 贴士 -->
  <view class="info-block" wx:if="{{trail.ticket_info}}">
    <text class="info-block__title">🎫 门票信息</text>
    <text class="info-block__text">{{trail.ticket_info}}</text>
  </view>

  <view class="info-block" wx:if="{{trail.food}}">
    <text class="info-block__title">🍜 餐饮推荐</text>
    <text class="info-block__text">{{trail.food}}</text>
  </view>

  <view class="info-block info-block--warn" wx:if="{{trail.pitfall}}">
    <text class="info-block__title">⚠️ 避坑提示</text>
    <text class="info-block__text">{{trail.pitfall}}</text>
  </view>

  <view class="info-block info-block--tip" wx:if="{{trail.tips}}">
    <text class="info-block__title">💡 小贴士</text>
    <text class="info-block__text">{{trail.tips}}</text>
  </view>

  <!-- 6. 安全提醒 -->
  <view class="safety-card" wx:if="{{trail.safety_tips && trail.safety_tips.length > 0}}">
    <view class="safety-card__head">
      <text class="safety-card__icon">🚨</text>
      <text class="safety-card__title">安全提醒</text>
    </view>
    <view class="safety-card__list">
      <view class="safety-card__item" wx:for="{{trail.safety_tips}}" wx:key="index">
        <text class="safety-card__bullet">⚠️</text>
        <text class="safety-card__text">{{item}}</text>
      </view>
    </view>
  </view>

  <!-- 法律法规 & 环保 -->
  <view class="info-block" wx:if="{{trail.law_tips && trail.law_tips.length > 0}}">
    <text class="info-block__title">📜 法律法规</text>
    <text class="info-block__item" wx:for="{{trail.law_tips}}" wx:key="*this">• {{item}}</text>
  </view>

  <view class="info-block" wx:if="{{trail.eco_tips && trail.eco_tips.length > 0}}">
    <text class="info-block__title">🌿 环保提醒</text>
    <text class="info-block__item" wx:for="{{trail.eco_tips}}" wx:key="*this">• {{item}}</text>
  </view>

  <!-- 紧急电话 -->
  <view class="emergency-card" wx:if="{{trail.emergencyPhone}}">
    <view class="emergency-card__head">
      <text class="emergency-card__icon">📞</text>
      <text class="emergency-card__title">紧急联系电话</text>
    </view>
    <view class="emergency-card__phone" bindtap="onCallEmergency">
      <text class="emergency-card__number">{{trail.emergencyPhone}}</text>
      <text class="emergency-card__action">点击拨打 →</text>
    </view>
  </view>

  <!-- 天气 -->
  <view class="weather-card" wx:if="{{weather}}">
    <text class="weather-card__title">🌤️ 当前天气参考</text>
    <view class="weather-card__info">
      <text class="weather-card__icon">{{weather.icon}}</text>
      <text class="weather-card__temp">{{weather.temp}}°C</text>
      <text class="weather-card__desc">{{weather.desc}}</text>
    </view>
  </view>

  <view class="bottom-safe"></view>

  </block>
</view>
