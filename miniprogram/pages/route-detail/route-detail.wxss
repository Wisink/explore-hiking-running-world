/* pages/route-detail/route-detail.wxss - 新版毛玻璃设计 v2.0 */

/* ===== CSS Variables ===== */
page {
  --glass-bg: rgba(255, 255, 255, 0.22);
  --glass-bg-light: rgba(255, 255, 255, 0.12);
  --glass-bg-strong: rgba(255, 255, 255, 0.35);
  --glass-border: rgba(255, 255, 255, 0.25);
  --glass-blur: blur(16px);
  --glass-shadow: 0 8rpx 32rpx rgba(31, 38, 50, 0.18);
  --text: #1a2e1a;
  --text2: #4a6b4a;
  --primary: #4CAF50;
  --primary-dark: #2d6a4f;
  --r: 36rpx;
  --tr: all 350ms cubic-bezier(0.4, 0, 0.2, 1);
}

/* 页面背景 */
.detail-page {
  min-height: 100vh;
  background-color: #c8e6c9;
  background:
    radial-gradient(ellipse at 20% 50%, rgba(129,199,132,.6) 0%, transparent 50%),
    radial-gradient(ellipse at 80% 20%, rgba(165,214,167,.5) 0%, transparent 50%),
    radial-gradient(ellipse at 60% 80%, rgba(76,175,80,.4) 0%, transparent 50%),
    radial-gradient(ellipse at 10% 90%, rgba(200,230,201,.6) 0%, transparent 40%),
    linear-gradient(160deg, #e8f5e9 0%, #c8e6c9 25%, #a5d6a7 50%, #81c784 75%, #66bb6a 100%);
  padding-bottom: 180rpx;
}

/* Loading */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 60vh;
  gap: 24rpx;
}

.loading-ring {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #E0E0DB;
  border-top-color: #2d6a4f;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin { to { transform: rotate(360deg); } }

.loading-label {
  font-size: 28rpx;
  color: var(--text2);
}

/* ===== 状态栏 ===== */
.statusbar-bg {
  background: linear-gradient(135deg,
    rgba(129, 199, 132, 0.5) 0%,
    rgba(76, 175, 80, 0.4) 100%
  );
}

/* ===== 离线提示条 ===== */
.offline-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  background: rgba(255, 213, 79, 0.15);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
}

.offline-bar__icon { font-size: 24rpx; }
.offline-bar__text { font-size: 24rpx; color: var(--text2); }

/* ===== 1. 封面图区域 ===== */
.hero-section {
  position: relative;
  width: 100%;
  height: 450rpx;
  overflow: hidden;
}

.hero-section__img {
  width: 100%;
  height: 100%;
}

.hero-section__overlay {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  height: 60%;
  background: linear-gradient(180deg, rgba(0,0,0,0) 0%, rgba(0,0,0,0.5) 100%);
  pointer-events: none;
}

/* 返回按钮 */
.hero-section__back {
  position: absolute;
  top: calc(20rpx + env(safe-area-inset-top));
  left: 24rpx;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

.hero-section__back-icon {
  font-size: 36rpx;
  color: #fff;
}

/* 右上角操作按钮 */
.hero-section__actions {
  position: absolute;
  top: calc(20rpx + env(safe-area-inset-top) + 44px);
  right: 24rpx;
  display: flex;
  gap: 16rpx;
}

.hero-section__action {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

.hero-section__action--on .hero-section__action-icon {
  transform: scale(1.1);
}

.hero-section__action-icon {
  font-size: 36rpx;
}

/* 底部叠加信息 */
.hero-section__info {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.hero-section__name {
  font-size: 40rpx;
  font-weight: 800;
  color: #fff;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.3);
}

.hero-section__desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  line-height: 1.5;
}

/* 难度徽章 */
.diff-badge {
  display: inline-flex;
  align-self: flex-start;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  color: #fff;
  font-weight: 600;
}

/* 难度星级 */
.diff-stars {
  display: flex;
  gap: 2rpx;
}

.diff-star {
  font-size: 28rpx;
  color: #FFB300;
}

/* ===== 2. 核心数据区 ===== */
.core-data-card {
  display: flex;
  align-items: center;
  justify-content: space-around;
  margin: 24rpx;
  padding: 28rpx 16rpx;
  background: rgba(255, 255, 255, 0.22);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1rpx solid rgba(255, 255, 255, 0.25);
  border-radius: 28rpx;
  box-shadow: var(--glass-shadow);
}

.core-data-card__item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  flex: 1;
}

.core-data-card__val {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text);
}

.core-data-card__unit {
  font-size: 22rpx;
  color: var(--text2);
}

.core-data-card__label {
  font-size: 22rpx;
  color: var(--text2);
}

.core-data-card__divider {
  width: 1rpx;
  height: 60rpx;
  background: rgba(0, 0, 0, 0.08);
}

/* ===== 3. 地形与特色标签区 ===== */
.tag-section {
  margin: 0 24rpx 16rpx;
  padding: 20rpx 24rpx;
  background: rgba(255, 255, 255, 0.18);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 24rpx;
}

.tag-scroll {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.tag-scroll:last-child {
  margin-bottom: 0;
}

.tag-scroll__label {
  font-size: 24rpx;
  color: var(--text2);
  flex-shrink: 0;
}

.tag-scroll__wrap {
  flex: 1;
  width: 0;
}

.tag-scroll__inner {
  display: flex;
  gap: 10rpx;
  white-space: nowrap;
}

/* 标签胶囊 */
.tag-pill {
  display: inline-flex;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  white-space: nowrap;
}

.tag-pill--terrain {
  background: rgba(76, 175, 80, 0.15);
  color: var(--primary-dark);
  border: 1rpx solid rgba(76, 175, 80, 0.25);
}

.tag-pill--dna {
  background: rgba(255, 152, 0, 0.15);
  color: #E65100;
  border: 1rpx solid rgba(255, 152, 0, 0.25);
}

/* 季节标签 */
.season-tag {
  display: inline-flex;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  background: rgba(255, 193, 7, 0.2);
  color: #F57C00;
  border: 1rpx solid rgba(255, 193, 7, 0.3);
  margin-right: 8rpx;
}

/* ===== 4. 基本信息折叠区 ===== */
.accordion {
  background: rgba(255, 255, 255, 0.22);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1rpx solid rgba(255, 255, 255, 0.25);
  margin: 16rpx 24rpx;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: var(--glass-shadow);
}

.accordion__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx;
}

.accordion__title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}

.accordion__arrow {
  font-size: 24rpx;
  color: var(--text2);
  transition: transform 300ms cubic-bezier(0.4, 0, 0.2, 1);
}

.accordion__arrow--open {
  transform: rotate(180deg);
}

.accordion__body {
  max-height: 0;
  overflow: hidden;
  transition: max-height 350ms cubic-bezier(0.4, 0, 0.2, 1);
}

.accordion__body--open {
  max-height: 2000rpx;
  padding: 0 28rpx 28rpx;
}

/* 信息行 */
.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
}

.info-row:last-child {
  border-bottom: none;
}

.info-row__label {
  font-size: 26rpx;
  color: var(--text2);
  flex-shrink: 0;
}

.info-row__value {
  font-size: 26rpx;
  color: var(--text);
  font-weight: 500;
}

.info-row__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

/* 进度条 */
.info-row__progress {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.progress-bar {
  width: 120rpx;
  height: 10rpx;
  background: rgba(0, 0, 0, 0.08);
  border-radius: 5rpx;
  overflow: hidden;
}

.progress-bar__fill {
  height: 100%;
  border-radius: 5rpx;
  transition: width 500ms ease;
}

.progress-bar__fill--safety {
  background: linear-gradient(90deg, #F44336, #FF9800, #4CAF50);
}

.progress-bar__fill--family {
  background: linear-gradient(90deg, #F44336, #FFC107, #4CAF50);
}

.progress-bar__text {
  font-size: 22rpx;
  color: var(--text);
}

/* ===== 5. 地区与位置区 ===== */
.location-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 16rpx 24rpx;
  padding: 20rpx 24rpx;
  background: rgba(255, 255, 255, 0.22);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1rpx solid rgba(255, 255, 255, 0.25);
  border-radius: 24rpx;
}

.location-card__badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 18rpx;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 20rpx;
}

.location-card__badge-icon {
  font-size: 24rpx;
}

.location-card__badge-text {
  font-size: 24rpx;
  color: var(--text);
  font-weight: 500;
}

.location-card__elevation {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 2rpx;
}

.location-card__elevation-label {
  font-size: 20rpx;
  color: var(--text2);
}

.location-card__elevation-val {
  font-size: 26rpx;
  color: var(--text);
  font-weight: 500;
}

/* ===== 6. 路线描述 ===== */
.desc-card {
  margin: 16rpx 24rpx;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.22);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1rpx solid rgba(255, 255, 255, 0.25);
  border-radius: 28rpx;
}

.desc-card__header {
  margin-bottom: 16rpx;
}

.desc-card__title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}

.desc-card__content {
  max-height: none;
}

.desc-card__content--collapsed {
  max-height: 200rpx;
  overflow: hidden;
}

.desc-card__text {
  font-size: 26rpx;
  color: var(--text2);
  line-height: 1.8;
}

.desc-card__toggle {
  text-align: center;
  padding: 16rpx 0 8rpx;
  font-size: 24rpx;
  color: var(--primary);
}

/* ===== 7. 交通信息 ===== */
.traffic-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(255,255,255,0.1);
}

.traffic-item:last-child { border-bottom: none; }

.traffic-item__type {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 6rpx;
}

.traffic-item__detail {
  display: block;
  font-size: 24rpx;
  color: var(--text2);
  line-height: 1.6;
}

.traffic-item__detail--empty {
  color: #999;
}

/* ===== 8. 起点/终点信息 ===== */
.endpoint-card {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 16rpx 24rpx;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.22);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1rpx solid rgba(255, 255, 255, 0.25);
  border-radius: 28rpx;
}

.endpoint-card__item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  justify-content: center;
}

.endpoint-card__divider {
  width: 1rpx;
  height: 60rpx;
  background: rgba(0, 0, 0, 0.08);
}

.endpoint-card__icon {
  font-size: 36rpx;
}

.endpoint-card__content {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.endpoint-card__label {
  font-size: 20rpx;
  color: var(--text2);
}

.endpoint-card__name {
  font-size: 26rpx;
  color: var(--text);
  font-weight: 500;
}

/* ===== 9. 操作按钮区 ===== */
.action-bar {
  display: flex;
  justify-content: space-between;
  margin: 20rpx 24rpx;
  padding: 20rpx;
  background: rgba(255, 255, 255, 0.22);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1rpx solid rgba(255, 255, 255, 0.25);
  border-radius: 24rpx;
  gap: 12rpx;
}

.action-bar__btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  flex: 1;
  padding: 16rpx 8rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 16rpx;
  transition: all 200ms ease;
}

.action-bar__btn:active {
  transform: scale(0.95);
  background: rgba(255, 255, 255, 0.25);
}

.action-bar__btn--on .action-bar__btn-text {
  color: #E53935;
}

.action-bar__btn--fav.action-bar__btn--on {
  background: rgba(229, 57, 53, 0.1);
}

.action-bar__btn-icon {
  font-size: 32rpx;
}

.action-bar__btn-text {
  font-size: 20rpx;
  color: var(--text2);
}

.bottom-safe { height: 40rpx; }

/* ===== 固定底部操作栏 ===== */
.fixed-bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16rpx 32rpx;
  padding-bottom: calc(16rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(232, 245, 234, 0.85);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-top: 1rpx solid rgba(255, 255, 255, 0.25);
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
  z-index: 200;
}

.fixed-bottom-bar__btn {
  width: 100%;
  padding: 24rpx 0;
  text-align: center;
  border-radius: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
  background: linear-gradient(135deg, #40916c, #2d6a4f);
  box-shadow: 0 4rpx 16rpx rgba(46, 125, 50, 0.3);
}

.fixed-bottom-bar__btn:active {
  transform: scale(0.97);
}

.fixed-bottom-bar__btn--today {
  background: linear-gradient(135deg, #C8E6C9, #A5D6A7);
  color: #2d6a4f;
  opacity: 0.85;
}

/* ===== 提示弹窗 ===== */
.hint-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.35);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hint-popup {
  width: 80%;
  max-width: 320px;
  background: rgba(232, 245, 234, 0.9);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 28rpx;
  padding: 40rpx 32rpx;
  text-align: center;
  animation: popIn 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes popIn {
  from { opacity: 0; transform: scale(0.85); }
  to { opacity: 1; transform: scale(1); }
}

.hint-popup__icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.hint-popup__title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text);
  margin-bottom: 12rpx;
}

.hint-popup__desc {
  font-size: 26rpx;
  color: var(--text2);
  line-height: 1.7;
  margin-bottom: 24rpx;
}

.hint-popup__btn {
  display: inline-block;
  padding: 20rpx 60rpx;
  background: linear-gradient(135deg, #74c69d, #4CAF50);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 28rpx;
}

/* ===== Toast ===== */
.nice-toast {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) scale(0.8);
  padding: 20rpx 40rpx;
  background: rgba(0, 0, 0, 0.75);
  color: #fff;
  font-size: 26rpx;
  border-radius: 12rpx;
  opacity: 0;
  transition: all 300ms ease;
  z-index: 10000;
  pointer-events: none;
}

.nice-toast--show {
  opacity: 1;
  transform: translate(-50%, -50%) scale(1);
}

.nice-toast--success { background: rgba(76, 175, 80, 0.9); }
.nice-toast--error { background: rgba(244, 67, 54, 0.9); }
.nice-toast--info { background: rgba(33, 150, 243, 0.9); }

/* ===== 已走过记录面板 ===== */
.complete-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.35);
  z-index: 200;
}

.complete-panel {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(232, 245, 234, 0.85);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  border: 1px solid rgba(255, 255, 255, 0.3);
  border-radius: 32rpx 32rpx 0 0;
  padding: 36rpx;
  padding-bottom: calc(36rpx + env(safe-area-inset-bottom));
  z-index: 201;
  transform: translateY(100%);
  transition: transform 300ms cubic-bezier(0.4, 0, 0.2, 1);
}

.complete-panel--show {
  transform: translateY(0);
}

.complete-panel__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.complete-panel__title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text);
}

.complete-panel__close {
  font-size: 36rpx;
  color: #6b8b6b;
  padding: 8rpx;
}

.complete-panel__section {
  margin-bottom: 28rpx;
}

.complete-panel__label {
  display: block;
  font-size: 28rpx;
  color: var(--text);
  font-weight: 500;
  margin-bottom: 12rpx;
}

.complete-panel__distance-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
}

.complete-panel__distance-label {
  font-size: 28rpx;
  color: var(--text);
  font-weight: 500;
  flex-shrink: 0;
}

.complete-panel__distance-display {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 24rpx;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 16rpx;
}

.complete-panel__distance-value {
  font-size: 30rpx;
  color: var(--text);
  font-weight: 600;
  min-width: 80rpx;
  text-align: center;
}

.complete-panel__distance-arrow {
  font-size: 18rpx;
  color: #6b8b6b;
}

.complete-panel__distance-unit {
  flex-shrink: 0;
  font-size: 28rpx;
  color: #4a6b4a;
}

/* 距离选择器 — 毛玻璃 */
.distance-picker-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.35);
  z-index: 200;
}

.distance-picker-modal {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(232, 245, 234, 0.85);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  border: 1px solid rgba(255, 255, 255, 0.3);
  border-radius: 28rpx 28rpx 0 0;
  z-index: 201;
  transform: translateY(100%);
  transition: transform 0.3s ease;
}

.distance-picker-modal--show {
  transform: translateY(0);
}

