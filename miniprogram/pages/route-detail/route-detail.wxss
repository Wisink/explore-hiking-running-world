/* pages/route-detail/route-detail.wxss - v3.0 自然清新风 + 毛玻璃 */

/* 状态栏 — 毛玻璃 */
.statusbar-bg {
  background: linear-gradient(135deg,
    rgba(129, 199, 132, 0.5) 0%,
    rgba(76, 175, 80, 0.4) 100%
  );
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
}

/* 导航栏 — 毛玻璃 */
.detail-nav {
  position: relative;
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 24rpx;
  background: linear-gradient(135deg,
    rgba(129, 199, 132, 0.5) 0%,
    rgba(76, 175, 80, 0.4) 100%
  );
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-bottom: 1px solid rgba(255, 255, 255, 0.25);
}

.detail-nav__back {
  width: 68rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(26, 46, 26, 0.08);
}

.detail-nav__back-icon {
  font-size: 34rpx;
  color: #1a2e1a;
}

.detail-nav__title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #1a2e1a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.detail-nav__spacer {
  width: 60rpx;
}

/* ===== CSS Variables ===== */
:host {
  --glass-bg: rgba(255, 255, 255, 0.22);
  --glass-bg-light: rgba(255, 255, 255, 0.12);
  --glass-bg-strong: rgba(255, 255, 255, 0.35);
  --glass-border: rgba(255, 255, 255, 0.25);
  --glass-blur: blur(16px);
  --glass-shadow: 0 8rpx 32rpx rgba(31, 38, 50, 0.18);
  --text: #1a2e1a;
  --text2: #4a6b4a;
  --primary: #4CAF50;
  --primary-dark: #2d6a4f;
  --r: 36rpx;
  --tr: all 350ms cubic-bezier(0.4, 0, 0.2, 1);
}

.detail-page {
  min-height: 100vh;
  background-color: #c8e6c9;
  background:
    radial-gradient(ellipse at 20% 50%, rgba(129,199,132,.6) 0%, transparent 50%),
    radial-gradient(ellipse at 80% 20%, rgba(165,214,167,.5) 0%, transparent 50%),
    radial-gradient(ellipse at 60% 80%, rgba(76,175,80,.4) 0%, transparent 50%),
    radial-gradient(ellipse at 10% 90%, rgba(200,230,201,.6) 0%, transparent 40%),
    linear-gradient(160deg, #e8f5e9 0%, #c8e6c9 25%, #a5d6a7 50%, #81c784 75%, #66bb6a 100%);
  padding-bottom: 140rpx;
}

/* Loading */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 60vh;
  gap: 24rpx;
}

.loading-ring {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #E0E0DB;
  border-top-color: #2d6a4f;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin { to { transform: rotate(360deg); } }

.loading-label {
  font-size: 28rpx;
  color: var(--text2);
}

/* ===== 1. 图片轮播 ===== */
.hero-swiper {
  position: relative;
  width: 100%;
  height: 520rpx;
  border-radius: 0 0 36rpx 36rpx;
  overflow: hidden;
}

.hero-swiper__main {
  width: 100%;
  height: 100%;
}

.hero-swiper__img {
  width: 100%;
  height: 100%;
}

.hero-swiper__overlay {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  height: 40%;
  background: linear-gradient(180deg, rgba(0,0,0,0) 0%, rgba(0,0,0,0.4) 100%);
  pointer-events: none;
}

.hero-swiper__dots {
  position: absolute;
  bottom: 24rpx;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 8rpx;
}

.hero-swiper__dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.45);
  transition: all 250ms ease;
}

.hero-swiper__dot--on {
  width: 32rpx;
  border-radius: 6rpx;
  background: #FFFFFF;
}

.hero-swiper__count {
  position: absolute;
  bottom: 24rpx;
  right: 24rpx;
  background: rgba(0, 0, 0, 0.35);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(4rpx);
}

/* ===== 2. 路线信息卡 — 毛玻璃 ===== */
.info-card {
  background: rgba(255, 255, 255, 0.22);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(255, 255, 255, 0.25);
  margin: -40rpx 24rpx 0;
  border-radius: 36rpx;
  padding: 36rpx;
  box-shadow: 0 8rpx 32rpx rgba(31, 38, 50, 0.18);
  position: relative;
  z-index: 10;
  transition: var(--tr);
}

.info-card:active {
  background: rgba(255, 255, 255, 0.3);
}

.info-card__name {
  display: block;
  font-size: 42rpx;
  font-weight: 800;
  color: var(--text);
  margin-bottom: 10rpx;
  letter-spacing: 1rpx;
  text-shadow: 0 1px 6px rgba(255,255,255,0.5);
}

.info-card__desc {
  display: block;
  font-size: 26rpx;
  color: var(--text2);
  line-height: 1.6;
  margin-bottom: 24rpx;
}

/* 难度行 */
.info-card__diff {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
  flex-wrap: wrap;
}

.diff-badge {
  padding: 8rpx 18rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #FFFFFF;
  font-weight: 600;
}

.diff-stars {
  display: flex;
  gap: 4rpx;
}

.diff-star {
  font-size: 26rpx;
  color: #FFB300;
}

.diff-hint {
  font-size: 24rpx;
  color: var(--text2);
}

/* 数据网格 — 毛玻璃 */
.data-grid {
  display: flex;
  background: rgba(255, 255, 255, 0.12);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 28rpx;
  padding: 24rpx 0;
  margin-bottom: 20rpx;
}

.data-grid__item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  border-right: 1rpx solid rgba(0,0,0,0.05);
}

.data-grid__item:last-child {
  border-right: none;
}

.data-grid__icon {
  font-size: 28rpx;
}

.data-grid__val {
  font-size: 26rpx;
  color: var(--text);
  font-weight: 600;
  text-align: center;
}

.data-grid__label {
  font-size: 22rpx;
  color: var(--text2);
}

/* 收藏 & 已走过统计 — 毛玻璃 */
.stats-row {
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.12);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 20rpx;
  padding: 18rpx 0;
  margin-bottom: 20rpx;
  gap: 0;
}

.stats-row__item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.stats-row__icon {
  font-size: 26rpx;
}

.stats-row__val {
  font-size: 28rpx;
  color: var(--text);
  font-weight: 700;
}

.stats-row__label {
  font-size: 22rpx;
  color: var(--text2);
}

.stats-row__divider {
  width: 1rpx;
  height: 32rpx;
  background: rgba(0, 0, 0, 0.08);
}

/* 费用行 — 毛玻璃 */
.cost-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 20rpx;
  background: rgba(255, 213, 79, 0.15);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border: 1px solid rgba(255, 213, 79, 0.2);
  border-radius: 20rpx;
  margin-bottom: 16rpx;
}

.cost-row__icon { font-size: 24rpx; }
.cost-row__label { font-size: 24rpx; color: #6b8b6b; }
.cost-row__val { font-size: 26rpx; color: #E65100; font-weight: 600; }

/* 标签区块 */
.tag-section {
  margin-top: 16rpx;
}

.tag-section__label {
  display: block;
  font-size: 24rpx;
  color: #4a6b4a;
  margin-bottom: 10rpx;
}

.tag-section__list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.tag-section__item {
  padding: 6rpx 16rpx;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 16rpx;
  font-size: 22rpx;
  color: var(--text2);
}

.tag-section__item--season {
  background: rgba(76, 175, 80, 0.15);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border: 1px solid rgba(76, 175, 80, 0.2);
  color: var(--primary-dark);
}

/* ===== 3. 操作按钮 — 毛玻璃 ===== */
.action-bar {
  display: flex;
  justify-content: space-around;
  background: rgba(255, 255, 255, 0.22);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(255, 255, 255, 0.25);
  margin: 20rpx 24rpx;
  border-radius: 28rpx;
  padding: 28rpx 0;
  box-shadow: 0 8rpx 32rpx rgba(31, 38, 50, 0.12);
}

.action-bar__item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  background: transparent;
  border: none;
  padding: 0;
  line-height: normal;
  margin: 0;
  transition: transform 150ms ease;
}

.action-bar__item:active {
  transform: scale(0.9);
}

.action-bar__item::after {
  border: none;
}

.action-bar__item--on .action-bar__text {
  color: #E53935;
}

.action-bar__icon {
  font-size: 40rpx;
}

.action-bar__text {
  font-size: 22rpx;
  color: var(--text2);
}

/* ===== 4. Accordion — 毛玻璃 ===== */
.accordion {
  background: rgba(255, 255, 255, 0.22);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(255, 255, 255, 0.25);
  margin: 16rpx 24rpx;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: var(--glass-shadow);
  transition: var(--tr);
}

.accordion__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 28rpx;
}

.accordion__title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}

.accordion__arrow {
  font-size: 24rpx;
  color: var(--text2);
  transition: transform 300ms cubic-bezier(0.4, 0, 0.2, 1);
}

.accordion__arrow--open {
  transform: rotate(180deg);
}

.accordion__body {
  max-height: 0;
  overflow: hidden;
  transition: max-height 350ms cubic-bezier(0.4, 0, 0.2, 1), padding 350ms ease;
  padding: 0 28rpx;
}

.accordion__body--open {
  max-height: 3000rpx;
  padding: 0 28rpx 28rpx;
}

/* 时间线 */
.timeline {
  position: relative;
  padding-left: 32rpx;
  margin-bottom: 20rpx;
}

.timeline__dot {
  position: absolute;
  left: 0;
  top: 8rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #2d6a4f;
  border: 3rpx solid #C8E6C9;
}

.timeline__line {
  position: absolute;
  left: 8rpx;
  top: 28rpx;
  bottom: -12rpx;
  width: 2rpx;
  background: #C8E6C9;
}

.timeline__content {
  flex: 1;
}

.timeline__name {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 6rpx;
}

.timeline__desc {
  display: block;
  font-size: 24rpx;
  color: var(--text2);
  line-height: 1.6;
}

/* 风景亮点 */
.highlight-text {
  display: block;
  font-size: 26rpx;
  color: var(--text2);
  line-height: 1.8;
  margin-bottom: 16rpx;
}

.checkpoint {
  padding: 16rpx;
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 20rpx;
}

.checkpoint__title {
  display: block;
  font-size: 24rpx;
  color: var(--text);
  font-weight: 500;
  margin-bottom: 8rpx;
}

.checkpoint__text {
  font-size: 24rpx;
  color: var(--text2);
  line-height: 1.6;
}

/* 交通 */
.traffic-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(255,255,255,0.12);
}

.traffic-item:last-child { border-bottom: none; }

.traffic-item__type {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 8rpx;
}

.traffic-item__detail {
  display: block;
  font-size: 24rpx;
  color: var(--text2);
  line-height: 1.6;
  margin-bottom: 12rpx;
}

.traffic-item__copy {
  display: inline-flex;
  padding: 8rpx 20rpx;
  background: rgba(76, 175, 80, 0.15);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border: 1px solid rgba(76, 175, 80, 0.2);
  border-radius: 16rpx;
  font-size: 22rpx;
  color: var(--primary-dark);
}

/* 装备 */
.equip-group {
  margin-bottom: 20rpx;
}

.equip-group__head {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 0;
  margin-bottom: 8rpx;
}

.equip-group__dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  box-shadow: 0 0 8px currentColor;
}

.equip-group__title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
}

.equip-group__item {
  display: block;
  font-size: 24rpx;
  color: #4a6b4a;
  line-height: 2;
  padding-left: 8rpx;
}

.equip-group__item--dim {
  color: #6b8b6b;
}

.equip-link {
  text-align: center;
  padding: 16rpx;
  font-size: 24rpx;
  color: #2d6a4f;
  font-weight: 500;
}

/* 信息块 — 毛玻璃 */
.info-block {
  background: rgba(255, 255, 255, 0.22);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(255, 255, 255, 0.25);
  margin: 16rpx 24rpx;
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: var(--glass-shadow);
}

.info-block--warn {
  border-left: 6rpx solid rgba(255, 152, 0, 0.6);
  background: rgba(255, 213, 79, 0.15);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
}

.info-block--tip {
  border-left: 6rpx solid rgba(76, 175, 80, 0.6);
}

.info-block__title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 12rpx;
  text-shadow: 0 1px 4px rgba(255,255,255,0.4);
}

.info-block__text {
  font-size: 26rpx;
  color: var(--text2);
  line-height: 1.8;
}

.info-block__item {
  display: block;
  font-size: 24rpx;
  color: var(--text2);
  line-height: 2;
}

/* 安全卡片 — 毛玻璃 */
.safety-card {
  background: rgba(244, 67, 54, 0.1);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(244, 67, 54, 0.15);
  margin: 16rpx 24rpx;
  border-radius: 28rpx;
  padding: 28rpx;
  border-left: 6rpx solid rgba(244, 67, 54, 0.5);
}

.safety-card__head {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 16rpx;
}

.safety-card__icon { font-size: 32rpx; }

.safety-card__title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text);
}

.safety-card__list {
  margin-top: 16rpx;
}

.safety-card__item {
  display: flex;
  gap: 10rpx;
  margin-bottom: 10rpx;
  align-items: flex-start;
}

.safety-card__bullet {
  font-size: 22rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.safety-card__text {
  font-size: 24rpx;
  color: var(--text2);
  line-height: 1.6;
}

/* 紧急电话 — 毛玻璃 */
.emergency-card {
  background: rgba(255, 152, 0, 0.1);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(255, 152, 0, 0.15);
  margin: 16rpx 24rpx;
  border-radius: 28rpx;
  padding: 28rpx;
  border-left: 6rpx solid rgba(255, 152, 0, 0.5);
}

.emergency-card__head {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 16rpx;
}

.emergency-card__icon { font-size: 32rpx; }

.emergency-card__title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
}

.emergency-card__phone {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border: 1px solid rgba(255, 255, 255, 0.2);
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
}

.emergency-card__number {
  font-size: 28rpx;
  color: #303028;
  font-weight: 600;
}

.emergency-card__action {
  font-size: 24rpx;
  color: #FF6D00;
  font-weight: 500;
}

/* 天气 — 毛玻璃 */
.weather-card {
  background: rgba(79, 195, 247, 0.1);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(79, 195, 247, 0.15);
  margin: 16rpx 24rpx;
  border-radius: 28rpx;
  padding: 28rpx;
}

.weather-card__title {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text);
  margin-bottom: 12rpx;
}

.weather-card__info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.weather-card__icon { font-size: 40rpx; }
.weather-card__temp {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--text);
}
.weather-card__desc {
  font-size: 26rpx;
  color: var(--text2);
}

.bottom-safe { height: 40rpx; }

/* ===== 升级1：分段路况颜色编码 ===== */

.timeline__head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 6rpx;
}

.timeline__diff-tag {
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
  font-weight: 500;
}

.timeline__progress-bar {
  width: 100%;
  height: 8rpx;
  background: #F0F0EB;
  border-radius: 4rpx;
  margin: 10rpx 0 4rpx;
  overflow: hidden;
}

.timeline__progress-fill {
  height: 100%;
  border-radius: 4rpx;
  transition: width 600ms ease;
}

.timeline__progress-label {
  font-size: 20rpx;
  color: #6b8b6b;
}

.timeline__meta {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 8rpx;
}

.timeline__meta-item {
  font-size: 22rpx;
  color: var(--text2);
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.timeline__summary {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 16rpx;
  border-left: 4rpx solid rgba(76, 175, 80, 0.6);
}

.timeline__summary-text {
  font-size: 24rpx;
  color: var(--primary-dark);
  font-weight: 500;
}

/* ===== 升级3：时间规划模块 ===== */

.timeplan-grid {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.timeplan-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 16rpx 0;
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border: 1px solid rgba(255, 255, 255, 0.15);
