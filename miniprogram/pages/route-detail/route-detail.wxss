  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 16rpx;
  font-size: 28rpx;
  color: var(--text);
  box-sizing: border-box;
  min-height: 80rpx;
  line-height: 1.4;
}

.complete-panel__textarea {
  width: 100%;
  padding: 18rpx 22rpx;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border: 1px solid rgba(255, 255, 255, 0.2);
