/* pages/route-detail/route-detail.wxss - v2.0 */

.detail-page {
  min-height: 100vh;
  background: #FAFAF5;
  padding-bottom: 60rpx;
}

/* Loading */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 60vh;
  gap: 24rpx;
}

.loading-ring {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #E0E0DB;
  border-top-color: #2E7D32;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin { to { transform: rotate(360deg); } }

.loading-label {
  font-size: 28rpx;
  color: #9E9E99;
}

/* ===== 1. 图片轮播 ===== */
.hero-swiper {
  position: relative;
  width: 100%;
  height: 520rpx;
}

.hero-swiper__main {
  width: 100%;
  height: 100%;
}

.hero-swiper__img {
  width: 100%;
  height: 100%;
}

.hero-swiper__overlay {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  height: 40%;
  background: linear-gradient(180deg, rgba(0,0,0,0) 0%, rgba(0,0,0,0.4) 100%);
  pointer-events: none;
}

.hero-swiper__dots {
  position: absolute;
  bottom: 24rpx;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 8rpx;
}

.hero-swiper__dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.45);
  transition: all 250ms ease;
}

.hero-swiper__dot--on {
  width: 32rpx;
  border-radius: 6rpx;
  background: #FFFFFF;
}

.hero-swiper__count {
  position: absolute;
  bottom: 24rpx;
  right: 24rpx;
  background: rgba(0, 0, 0, 0.35);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(4rpx);
}

/* ===== 2. 路线信息卡 ===== */
.info-card {
  background: #FFFFFF;
  margin: -40rpx 24rpx 0;
  border-radius: 24rpx;
  padding: 36rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
  position: relative;
  z-index: 10;
}

.info-card__name {
  display: block;
  font-size: 42rpx;
  font-weight: 800;
  color: #212121;
  margin-bottom: 10rpx;
  letter-spacing: 1rpx;
}

.info-card__desc {
  display: block;
  font-size: 26rpx;
  color: #757570;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

/* 难度行 */
.info-card__diff {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
  flex-wrap: wrap;
}

.diff-badge {
  padding: 8rpx 18rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #FFFFFF;
  font-weight: 600;
}

.diff-stars {
  display: flex;
  gap: 4rpx;
}

.diff-star {
  font-size: 26rpx;
  color: #FFB300;
}

.diff-hint {
  font-size: 24rpx;
  color: #9E9E99;
}

/* 数据网格 */
.data-grid {
  display: flex;
  background: #F5FAF5;
  border-radius: 16rpx;
  padding: 24rpx 0;
  margin-bottom: 20rpx;
}

.data-grid__item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  border-right: 1rpx solid rgba(0,0,0,0.05);
}

.data-grid__item:last-child {
  border-right: none;
}

.data-grid__icon {
  font-size: 28rpx;
}

.data-grid__val {
  font-size: 26rpx;
  color: #303028;
  font-weight: 600;
  text-align: center;
}

.data-grid__label {
  font-size: 22rpx;
  color: #9E9E99;
}

/* 费用行 */
.cost-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 20rpx;
  background: #FFF8E1;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.cost-row__icon { font-size: 24rpx; }
.cost-row__label { font-size: 24rpx; color: #9E9E99; }
.cost-row__val { font-size: 26rpx; color: #E65100; font-weight: 600; }

/* 标签区块 */
.tag-section {
  margin-top: 16rpx;
}

.tag-section__label {
  display: block;
  font-size: 24rpx;
  color: #616156;
  margin-bottom: 10rpx;
}

.tag-section__list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.tag-section__item {
  padding: 6rpx 16rpx;
  background: #E3F2FD;
  border-radius: 8rpx;
  font-size: 22rpx;
  color: #1565C0;
}

.tag-section__item--season {
  background: #E8F5E9;
  color: #2E7D32;
}

/* ===== 3. 操作按钮 ===== */
.action-bar {
  display: flex;
  justify-content: space-around;
  background: #FFFFFF;
  margin: 20rpx 24rpx;
  border-radius: 20rpx;
  padding: 28rpx 0;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.action-bar__item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  background: transparent;
  border: none;
  padding: 0;
  line-height: normal;
  margin: 0;
  transition: transform 150ms ease;
}

.action-bar__item:active {
  transform: scale(0.9);
}

.action-bar__item::after {
  border: none;
}

.action-bar__item--on .action-bar__text {
  color: #E53935;
}

.action-bar__icon {
  font-size: 40rpx;
}

.action-bar__text {
  font-size: 22rpx;
  color: #616156;
}

/* ===== 4. Accordion ===== */
.accordion {
  background: #FFFFFF;
  margin: 16rpx 24rpx;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.accordion__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 28rpx;
}

.accordion__title {
  font-size: 30rpx;
  font-weight: 600;
  color: #303028;
}

.accordion__arrow {
  font-size: 24rpx;
  color: #C0C0BB;
  transition: transform 300ms cubic-bezier(0.4, 0, 0.2, 1);
}

.accordion__arrow--open {
  transform: rotate(180deg);
}

.accordion__body {
  max-height: 0;
  overflow: hidden;
  transition: max-height 350ms cubic-bezier(0.4, 0, 0.2, 1), padding 350ms ease;
  padding: 0 28rpx;
}

.accordion__body--open {
  max-height: 3000rpx;
  padding: 0 28rpx 28rpx;
}

/* 时间线 */
.timeline {
  position: relative;
  padding-left: 32rpx;
  margin-bottom: 20rpx;
}

.timeline__dot {
  position: absolute;
  left: 0;
  top: 8rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #2E7D32;
  border: 3rpx solid #C8E6C9;
}

.timeline__line {
  position: absolute;
  left: 8rpx;
  top: 28rpx;
  bottom: -12rpx;
  width: 2rpx;
  background: #C8E6C9;
}

.timeline__content {
  flex: 1;
}

.timeline__name {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #303028;
  margin-bottom: 6rpx;
}

.timeline__desc {
  display: block;
  font-size: 24rpx;
  color: #757570;
  line-height: 1.6;
}

/* 风景亮点 */
.highlight-text {
  display: block;
  font-size: 26rpx;
  color: #616156;
  line-height: 1.8;
  margin-bottom: 16rpx;
}

.checkpoint {
  padding: 16rpx;
  background: #F1F8E9;
  border-radius: 12rpx;
}

.checkpoint__title {
  display: block;
  font-size: 24rpx;
  color: #303028;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.checkpoint__text {
  font-size: 24rpx;
  color: #616156;
  line-height: 1.6;
}

/* 交通 */
.traffic-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F0F0EB;
}

.traffic-item:last-child { border-bottom: none; }

.traffic-item__type {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #303028;
  margin-bottom: 8rpx;
}

.traffic-item__detail {
  display: block;
  font-size: 24rpx;
  color: #616156;
  line-height: 1.6;
  margin-bottom: 12rpx;
}

.traffic-item__copy {
  display: inline-flex;
  padding: 8rpx 20rpx;
  background: #E8F5E9;
  border-radius: 8rpx;
  font-size: 22rpx;
  color: #2E7D32;
}

/* 装备 */
.equip-group {
  margin-bottom: 20rpx;
}

.equip-group__head {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 0;
  margin-bottom: 8rpx;
}

.equip-group__dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}

.equip-group__title {
  font-size: 26rpx;
  font-weight: 600;
  color: #303028;
}

.equip-group__item {
  display: block;
  font-size: 24rpx;
  color: #616156;
  line-height: 2;
  padding-left: 8rpx;
}

.equip-group__item--dim {
  color: #9E9E99;
}

.equip-link {
  text-align: center;
  padding: 16rpx;
  font-size: 24rpx;
  color: #2E7D32;
  font-weight: 500;
}

/* 信息块 */
.info-block {
  background: #FFFFFF;
  margin: 16rpx 24rpx;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.info-block--warn {
  border-left: 6rpx solid #FF9800;
  background: #FFF8E1;
}

.info-block--tip {
  border-left: 6rpx solid #2E7D32;
}

.info-block__title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #303028;
  margin-bottom: 12rpx;
}

.info-block__text {
  font-size: 26rpx;
  color: #616156;
  line-height: 1.8;
}

.info-block__item {
  display: block;
  font-size: 24rpx;
  color: #616156;
  line-height: 2;
}

/* 安全卡片 */
.safety-card {
  background: #FFEBEE;
  margin: 16rpx 24rpx;
  border-radius: 20rpx;
  padding: 28rpx;
  border-left: 6rpx solid #F44336;
}

.safety-card__head {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 16rpx;
}

.safety-card__icon { font-size: 32rpx; }

.safety-card__title {
  font-size: 30rpx;
  font-weight: 700;
  color: #C62828;
}

.safety-card__item {
  display: flex;
  gap: 10rpx;
  margin-bottom: 10rpx;
  align-items: flex-start;
}

.safety-card__bullet {
  font-size: 22rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.safety-card__text {
  font-size: 24rpx;
  color: #616156;
  line-height: 1.6;
}

/* 紧急电话 */
.emergency-card {
  background: #FFF3E0;
  margin: 16rpx 24rpx;
  border-radius: 20rpx;
  padding: 28rpx;
  border-left: 6rpx solid #FF9800;
}

.emergency-card__head {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 16rpx;
}

.emergency-card__icon { font-size: 32rpx; }

.emergency-card__title {
  font-size: 28rpx;
  font-weight: 600;
  color: #E65100;
}

.emergency-card__phone {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFFFFF;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
}

.emergency-card__number {
  font-size: 28rpx;
  color: #303028;
  font-weight: 600;
}

.emergency-card__action {
  font-size: 24rpx;
  color: #FF6D00;
  font-weight: 500;
}

/* 天气 */
.weather-card {
  background: #E3F2FD;
  margin: 16rpx 24rpx;
  border-radius: 20rpx;
  padding: 28rpx;
}

.weather-card__title {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
  color: #1565C0;
  margin-bottom: 12rpx;
}

.weather-card__info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.weather-card__icon { font-size: 40rpx; }
.weather-card__temp {
  font-size: 36rpx;
  font-weight: bold;
  color: #1565C0;
}
.weather-card__desc {
  font-size: 26rpx;
  color: #616156;
}

.bottom-safe { height: 40rpx; }
