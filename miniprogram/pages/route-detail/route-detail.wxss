  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(255,255,255,0.1);
}

.knowledge-links__item:last-child {
  border-bottom: none;
}

.knowledge-links__item text:first-child {
  font-size: 28rpx;
  color: var(--text);
}

.knowledge-links__arrow {
  font-size: 32rpx;
  color: #6b8b6b;
}

/* ===== 装备清单完成度角标 ===== */

.action-bar__badge {
  font-size: 20rpx;
  color: #FFFFFF;
  background: #FF5722;
  padding: 2rpx 8rpx;
  border-radius: 20rpx;
  margin-left: 6rpx;
  font-weight: 600;
}
