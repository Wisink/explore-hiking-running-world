/* pages/route-detail/route-detail.wxss */

.detail-page {
  min-height: 100vh;
  background: #F5F5F5;
  padding-bottom: 60rpx;
}

/* ===== Loading ===== */
.loading-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 60vh;
  gap: 20rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #E0E0E0;
  border-top-color: #2E7D32;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

/* ===== 1. 图片轮播区 ===== */
.swiper-section {
  position: relative;
  width: 100%;
  height: 480rpx;
}

.image-swiper {
  width: 100%;
  height: 100%;
}

.swiper-image {
  width: 100%;
  height: 100%;
}

.swiper-indicators {
  position: absolute;
  bottom: 20rpx;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 8rpx;
}

.indicator {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.5);
  transition: all 200ms ease;
}

.indicator.active {
  width: 32rpx;
  border-radius: 6rpx;
  background: #FFFFFF;
}

.swiper-counter {
  position: absolute;
  bottom: 20rpx;
  right: 24rpx;
  background: rgba(0, 0, 0, 0.4);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #FFFFFF;
}

/* ===== 2. 路线基本信息卡 ===== */
.info-card {
  background: #FFFFFF;
  margin: -40rpx 24rpx 0;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  position: relative;
  z-index: 10;
}

.card-header {
  margin-bottom: 24rpx;
}

.trail-name {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #212121;
  margin-bottom: 12rpx;
}

.trail-desc {
  display: block;
  font-size: 26rpx;
  color: #757575;
  line-height: 1.6;
}

/* 难度行 */
.difficulty-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
  flex-wrap: wrap;
}

.diff-badge {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
}

.diff-icon {
  font-size: 20rpx;
}

.diff-text {
  font-size: 24rpx;
  color: #FFFFFF;
  font-weight: 500;
}

.diff-stars {
  display: flex;
  gap: 4rpx;
}

.star {
  font-size: 28rpx;
  color: #E0E0E0;
}

.star.filled {
  color: #FFB300;
}

.diff-desc {
  font-size: 24rpx;
  color: #757575;
}

/* 数据行 */
.data-row {
  display: flex;
  gap: 0;
  margin-bottom: 20rpx;
  background: #F9FBF7;
  border-radius: 12rpx;
  padding: 20rpx 0;
}

.data-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  border-right: 1rpx solid #E8E8E8;
}

.data-item:last-child {
  border-right: none;
}

.data-icon {
  font-size: 28rpx;
}

.data-label {
  font-size: 22rpx;
  color: #999;
}

.data-value {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
  text-align: center;
}

/* 费用行 */
.cost-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 20rpx;
  background: #FFF8E1;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}

.cost-icon {
  font-size: 24rpx;
}

.cost-label {
  font-size: 24rpx;
  color: #999;
}

.cost-value {
  font-size: 26rpx;
  color: #F57F17;
  font-weight: 500;
}

/* 适合人群 */
.suitable-row, .season-row {
  margin-top: 12rpx;
}

.suitable-label, .season-label {
  display: block;
  font-size: 24rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.suitable-tags, .season-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.suitable-tag {
  padding: 6rpx 16rpx;
  background: #E3F2FD;
  border-radius: 6rpx;
  font-size: 22rpx;
  color: #1565C0;
}

.season-tag {
  padding: 6rpx 16rpx;
  background: #E8F5E9;
  border-radius: 6rpx;
  font-size: 22rpx;
  color: #2E7D32;
}

/* ===== 3. 操作按钮区 ===== */
.action-bar {
  display: flex;
  justify-content: space-around;
  background: #FFFFFF;
  margin: 20rpx 24rpx;
  border-radius: 16rpx;
  padding: 24rpx 0;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  background: transparent;
  border: none;
  padding: 0;
  line-height: normal;
  margin: 0;
}

.action-btn::after {
  border: none;
}

.action-btn.active .action-text {
  color: #E53935;
}

.share-btn {
  background: transparent;
  font-size: inherit;
}

.share-btn::after {
  border: none;
}

.action-icon {
  font-size: 40rpx;
}

.action-text {
  font-size: 22rpx;
  color: #555;
}

/* ===== Section Card (Accordion) ===== */
.section-card {
  background: #FFFFFF;
  margin: 16rpx 24rpx;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.section-arrow {
  font-size: 24rpx;
  color: #999;
  transition: transform 300ms ease;
}

.section-arrow.open {
  transform: rotate(180deg);
}

.section-body {
  max-height: 0;
  overflow: hidden;
  transition: max-height 300ms ease, padding 300ms ease;
  padding: 0 24rpx;
}

.section-body.expanded {
  max-height: 2000rpx;
  padding: 0 24rpx 28rpx;
}

/* 分段路况 */
.section-item {
  position: relative;
  padding-left: 32rpx;
  margin-bottom: 20rpx;
}

.section-item::before {
  content: '';
  position: absolute;
  left: 8rpx;
  top: 16rpx;
  bottom: -12rpx;
  width: 2rpx;
  background: #C8E6C9;
}

.section-item:last-child::before {
  display: none;
}

.section-item-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.section-dot {
  position: absolute;
  left: 0;
  top: 8rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #2E7D32;
  border: 3rpx solid #C8E6C9;
}

.section-item-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
}

.section-item-desc {
  font-size: 24rpx;
  color: #666;
  line-height: 1.6;
  padding-left: 4rpx;
}

/* 风景亮点 */
.highlight-text {
  display: block;
  font-size: 26rpx;
  color: #555;
  line-height: 1.8;
  margin-bottom: 16rpx;
}

.checkpoint-list {
  padding: 16rpx;
  background: #F1F8E9;
  border-radius: 8rpx;
}

.checkpoint-title {
  display: block;
  font-size: 24rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.checkpoint-text {
  font-size: 24rpx;
  color: #555;
  line-height: 1.6;
}

/* 交通方案 */
.traffic-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.traffic-item:last-child {
  border-bottom: none;
}

.traffic-type {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 8rpx;
}

.traffic-detail {
  display: block;
  font-size: 24rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 12rpx;
}

.traffic-copy {
  display: inline-flex;
  padding: 8rpx 20rpx;
  background: #E8F5E9;
  border-radius: 8rpx;
  font-size: 22rpx;
  color: #2E7D32;
}

/* 装备清单 */
.equip-group {
  margin-bottom: 20rpx;
}

.equip-group-header {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 16rpx;
  border-radius: 8rpx;
  margin-bottom: 10rpx;
}

.equip-group-header.must {
  background: #FFEBEE;
}

.equip-group-header.suggest {
  background: #FFF8E1;
}

.equip-group-header.noneed {
  background: #E8F5E9;
}

.equip-icon {
  font-size: 20rpx;
}

.equip-title {
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
}

.equip-list {
  padding-left: 16rpx;
}

.equip-item {
  display: block;
  font-size: 24rpx;
  color: #555;
  line-height: 2;
}

.equip-more {
  text-align: center;
  padding: 16rpx;
  font-size: 24rpx;
  color: #2E7D32;
}

/* ===== 信息段落 ===== */
.info-section {
  background: #FFFFFF;
  margin: 16rpx 24rpx;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.info-section.warn {
  border-left: 6rpx solid #FF9800;
  background: #FFF8E1;
}

.info-section.tip {
  border-left: 6rpx solid #2E7D32;
}

.info-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.info-content {
  font-size: 26rpx;
  color: #555;
  line-height: 1.8;
}

/* ===== 安全提醒 ===== */
.safety-card {
  background: #FFEBEE;
  margin: 16rpx 24rpx;
  border-radius: 16rpx;
  padding: 24rpx;
  border-left: 6rpx solid #F44336;
}

.safety-header {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.safety-icon {
  font-size: 32rpx;
}

.safety-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #C62828;
}

.safety-item {
  display: flex;
  gap: 10rpx;
  margin-bottom: 10rpx;
  align-items: flex-start;
}

.safety-bullet {
  font-size: 22rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.safety-text {
  font-size: 24rpx;
  color: #555;
  line-height: 1.6;
}

/* ===== 法律法规 & 环保 ===== */
.law-card, .eco-card {
  background: #FFFFFF;
  margin: 16rpx 24rpx;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.law-title, .eco-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.law-item, .eco-item {
  display: block;
  font-size: 24rpx;
  color: #555;
  line-height: 2;
}

/* ===== 紧急电话 ===== */
.emergency-card {
  background: #FFF3E0;
  margin: 16rpx 24rpx;
  border-radius: 16rpx;
  padding: 24rpx;
  border-left: 6rpx solid #FF9800;
}

.emergency-header {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.emergency-icon {
  font-size: 32rpx;
}

.emergency-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #E65100;
}

.emergency-phone {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFFFFF;
  padding: 20rpx;
  border-radius: 12rpx;
}

.phone-text {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.phone-action {
  font-size: 24rpx;
  color: #FF6D00;
}

/* ===== 天气提示 ===== */
.weather-tip {
  background: #E3F2FD;
  margin: 16rpx 24rpx;
  border-radius: 16rpx;
  padding: 24rpx;
}

.weather-title {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
  color: #1565C0;
  margin-bottom: 12rpx;
}

.weather-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.weather-icon {
  font-size: 40rpx;
}

.weather-temp {
  font-size: 36rpx;
  font-weight: bold;
  color: #1565C0;
}

.weather-desc {
  font-size: 26rpx;
  color: #555;
}

/* ===== 底部间距 ===== */
.bottom-safe {
  height: 40rpx;
}
