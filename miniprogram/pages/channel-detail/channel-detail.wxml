<!--pages/channel-detail/channel-detail.wxml-->
<view class="channel-detail">
  <!-- 状态栏占位 -->
  <view class="page-statusbar" style="height: {{statusBarHeight}}px;"></view>

  <!-- 固定顶部标题栏 -->
  <view class="fixed-header" style="padding-top: {{statusBarHeight}}px;">
    <view class="fixed-header__bg"></view>
    <view class="fixed-header__content">
      <view class="back-btn" bindtap="onBackTap">
        <text class="back-btn__icon">‹</text>
        <text class="back-btn__text">返回</text>
      </view>
      <text class="header-title">{{channelName}}</text>
      <view class="header-spacer"></view>
    </view>
  </view>

  <!-- 固定头部占位 -->
  <view class="fixed-header-spacer" style="height: {{headerHeight}}px;"></view>

  <!-- 搜索框 -->
  <view class="search-bar" bindtap="onSearchTap">
    <view class="search-bar__bg"></view>
    <view class="search-bar__inner">
      <text class="search-bar__icon">🔍</text>
      <text class="search-bar__text">搜索{{channelName}}内容...</text>
    </view>
  </view>

  <!-- 子分类列表 -->
  <view class="subcategory-section">
    <view class="section__head">
      <view class="section__title-wrap">
        <text class="section__icon">📋</text>
        <text class="section__title">内容分类</text>
      </view>
      <view class="section__count">
        <text>{{subcategories.length}}个分类</text>
      </view>
    </view>
    
    <view class="subcategory-list">
      <view class="subcategory-item" wx:for="{{subcategories}}" wx:key="key" data-subcategory="{{item.key}}" data-name="{{item.name}}" bindtap="onSubcategoryTap">
        <view class="subcategory-item__bg"></view>
        <view class="subcategory-item__inner">
          <view class="subcategory-item__index">
            <text class="subcategory-item__index-text">{{item.key}}</text>
          </view>
          <view class="subcategory-item__body">
            <text class="subcategory-item__name">{{item.name}}</text>
            <text class="subcategory-item__count">{{item.count}}篇文章</text>
          </view>
          <text class="subcategory-item__arrow">›</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部 -->
  <view class="footer">
    <text class="footer__icon">📚</text>
    <text class="footer__main">深入学习，成为跑步达人</text>
    <text class="footer__sub">每个分类都有精选内容</text>
  </view>
</view>