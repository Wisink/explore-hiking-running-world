/* pages/nearby/nearby.wxss */
@import '/styles/common.wxss';

.nearby-page {
  min-height: 100vh;
  padding-bottom: 60rpx;
  background-color: #c8e6c9;
  background:
    radial-gradient(ellipse at 20% 50%, rgba(129,199,132,.35) 0%, transparent 50%),
    radial-gradient(ellipse at 80% 20%, rgba(165,214,167,.25) 0%, transparent 50%),
    radial-gradient(ellipse at 60% 80%, rgba(76,175,80,.2) 0%, transparent 50%),
    linear-gradient(160deg, #e8f5e9 0%, #c8e6c9 25%, #a5d6a7 50%, #81c784 75%, #66bb6a 100%);
}

/* ===== 定位引导区 ===== */
.locate-area {
  display: flex;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.locate-card {
  width: 100%;
  background: rgba(255, 255, 255, 0.25);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255,255,255,.3);
  border-radius: 28rpx;
  padding: 60rpx 40rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  box-shadow: 0 16rpx 48rpx rgba(31,38,50,.15);
}

.locate-card__icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.locate-card__title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a2e1a;
  margin-bottom: 12rpx;
}

.locate-card__desc {
  font-size: 26rpx;
  color: #4a6b4a;
  margin-bottom: 48rpx;
  line-height: 1.5;
}

.locate-card__btn {
  width: 100%;
  height: 90rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 45rpx;
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  transition: all 200ms ease;
}

.locate-card__btn:active {
  transform: scale(0.97);
}

.locate-card__btn--primary {
  background: linear-gradient(135deg, rgba(129,199,132,.85), rgba(76,175,80,.85));
  color: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(76,175,80,.3);
  border: 1px solid rgba(255,255,255,.2);
}

.locate-card__btn--secondary {
  background: rgba(255, 255, 255, 0.3);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  color: #2d6a4f;
  border: 1px solid rgba(255,255,255,.25);
}

/* ===== 路线列表 ===== */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 28rpx 8rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a2e1a;
}

.section-count {
  font-size: 24rpx;
  color: #6b8b6b;
}

.route-list {
  padding: 0 24rpx 24rpx;
}

/* ===== 路线卡片 ===== */
.route-card {
  background: rgba(255, 255, 255, 0.22);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(255,255,255,.25);
  border-radius: 20rpx;
  margin-bottom: 28rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(31,38,50,.18);
  animation: fadeInUp 400ms cubic-bezier(0.25, 0.46, 0.45, 0.94) both;
  transition: all .35s cubic-bezier(.4,0,.2,1);
}

.route-card--hover {
  transform: scale(0.97);
  opacity: 0.95;
}

@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(40rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.route-card__cover {
  position: relative;
  width: 100%;
  height: 360rpx;
  overflow: hidden;
}

.route-card__image {
  width: 100%;
  height: 100%;
  transition: transform 500ms ease;
}

.route-card:active .route-card__image {
  transform: scale(1.03);
}

.route-card__overlay {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  height: 65%;
  background: linear-gradient(180deg, rgba(0,0,0,0) 0%, rgba(0,0,0,0.45) 100%);
  pointer-events: none;
}

.route-card__badge {
  position: absolute;
  top: 16rpx; left: 16rpx;
  padding: 8rpx 18rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  color: #FFFFFF;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.15);
}

/* 距离角标 */
.route-card__distance {
  position: absolute;
  top: 16rpx; right: 16rpx;
  padding: 8rpx 18rpx;
  border-radius: 8rpx;
  background: rgba(76, 175, 80, 0.9);
  font-size: 22rpx;
  color: #FFFFFF;
  font-weight: 600;
  backdrop-filter: blur(8rpx);
  -webkit-backdrop-filter: blur(8rpx);
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.15);
}

.route-card__hero {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  padding: 24rpx;
  z-index: 2;
}

.route-card__name {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 10rpx;
  text-shadow: 0 1rpx 6rpx rgba(0,0,0,0.3);
}

.route-card__meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.route-card__meta-item {
  padding: 4rpx 12rpx;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(8rpx);
  -webkit-backdrop-filter: blur(8rpx);
  border-radius: 6rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.9);
  border: 1px solid rgba(255,255,255,.15);
}

.route-card__body {
  padding: 20rpx 24rpx 24rpx;
}

.route-card__desc {
  display: block;
  font-size: 26rpx;
  color: #4a6b4a;
  margin-bottom: 14rpx;
  line-height: 1.5;
}

.route-card__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 10rpx;
}

.route-card__tag {
  padding: 4rpx 12rpx;
  background: rgba(129, 199, 132, 0.2);
  border-radius: 6rpx;
  font-size: 20rpx;
  color: #2d6a4f;
  border: 1px solid rgba(129, 199, 132, 0.2);
}

.route-card__family {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #1565C0;
  background: rgba(227, 242, 253, 0.6);
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  display: inline-block;
}

/* ===== 骨架屏 ===== */
.skeleton-wrap { padding: 24rpx 24rpx; }

.skel-card {
  background: rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(31,38,50,.12);
}

.skel-cover { width: 100%; height: 360rpx; }
.skel-body { padding: 24rpx; }
.skel-line { border-radius: 8rpx; height: 28rpx; }
.skel-line--title { width: 55%; height: 34rpx; margin-bottom: 16rpx; }
.skel-line--desc { width: 80%; height: 24rpx; margin-bottom: 16rpx; }
.skel-row { display: flex; gap: 12rpx; margin-top: 14rpx; }
.skel-chip { width: 100rpx; height: 32rpx; border-radius: 8rpx; }

.skel-shimmer {
  background: linear-gradient(90deg, rgba(255,255,255,.15) 25%, rgba(129,199,132,.2) 37%, rgba(255,255,255,.15) 63%);
  background-size: 400rpx 100%;
  animation: skelShimmer 1.8s ease infinite;
}

@keyframes skelShimmer {
  0% { background-position: -400rpx 0; }
  100% { background-position: 400rpx 0; }
}

/* ===== 空状态 ===== */
.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.empty-icon { font-size: 80rpx; margin-bottom: 20rpx; }
.empty-title { font-size: 30rpx; font-weight: 600; color: #1a2e1a; margin-bottom: 12rpx; }
.empty-desc { font-size: 26rpx; color: #6b8b6b; }

/* ===== 定位确认弹窗 ===== */
.modal-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
  animation: fadeIn 200ms ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.modal-glass {
  width: 80%;
  max-width: 600rpx;
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  border: 1px solid rgba(255,255,255,.4);
  border-radius: 28rpx;
  padding: 56rpx 40rpx 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  box-shadow: 0 20rpx 60rpx rgba(0,0,0,0.15);
  animation: modalPop 300ms cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes modalPop {
  from { opacity: 0; transform: scale(0.85); }
  to { opacity: 1; transform: scale(1); }
}

.modal-glass__icon {
  font-size: 72rpx;
  margin-bottom: 20rpx;
}

.modal-glass__title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a2e1a;
  margin-bottom: 14rpx;
}

.modal-glass__desc {
  font-size: 26rpx;
  color: #4a6b4a;
  line-height: 1.6;
  margin-bottom: 40rpx;
}

.modal-glass__actions {
  display: flex;
  width: 100%;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.modal-glass__btn {
  flex: 1;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 42rpx;
  font-size: 28rpx;
  font-weight: 600;
  transition: all 200ms ease;
}

.modal-glass__btn:active {
  transform: scale(0.96);
}

.modal-glass__btn--primary {
  background: linear-gradient(135deg, #81c784, #4CAF50);
  color: #FFFFFF;
  box-shadow: 0 6rpx 20rpx rgba(76,175,80,.35);
}

.modal-glass__btn--secondary {
  background: rgba(255, 255, 255, 0.6);
  backdrop-filter: blur(10px);
  color: #2d6a4f;
  border: 1px solid rgba(129,199,132,.3);
}

.modal-glass__cancel {
  font-size: 24rpx;
  color: #6b8b6b;
  padding: 16rpx;
}
