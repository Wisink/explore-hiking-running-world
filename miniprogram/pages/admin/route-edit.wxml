<!--pages/admin/route-edit.wxml-->
<view class="edit-page">

  <!-- 统一头部 -->
  <view class="page-header">
    <view class="page-header__statusbar" style="height: {{statusBarHeight}}px;"></view>
    <view class="page-header__nav">
      <view class="page-header__back" bindtap="onBack">
        <text class="page-header__back-icon">{{lt}}</text>
        <text class="page-header__back-text">返回</text>
      </view>
      <text class="page-header__title">{{type === 'article' ? '编辑文章' : '编辑路线'}}</text>
      <view class="page-header__spacer"></view>
    </view>
  </view>
  <view style="height: {{headerHeight}}px;"></view>

  <view class="loading-wrap" wx:if="{{loading}}">
    <text class="loading-text">加载中...</text>
  </view>

  <!-- ========== 路线编辑 ========== -->
  <block wx:elif="{{type === 'route'}}">

    <!-- 智能搜索（仅新增时显示） -->
    <view class="form-section search-section" wx:if="{{!id}}">
      <text class="form-section__title">🔍 智能搜索填充</text>
      <text class="search-hint">输入路线名称，自动从百度搜索提取路线信息</text>
      <view class="search-bar">
        <input class="search-input" placeholder="输入路线名称，如：子午峪凤凰岭小环线" value="{{searchQuery}}" bindinput="onSearchInput" bindconfirm="onSearchRoute" confirm-type="search" />
        <view class="search-btn {{searching ? 'search-btn--loading' : ''}}" bindtap="onSearchRoute">
          <text>{{searching ? '搜索中...' : '搜索'}}</text>
        </view>
      </view>
      <view class="search-status" wx:if="{{searchStatus}}">
        <text class="search-status__text {{searchStatusType}}">{{searchStatus}}</text>
      </view>
    </view>

    <!-- 基本信息 -->
    <view class="form-section">
      <text class="form-section__title">基本信息</text>

      <view class="form-item">
        <text class="form-label">路线名称 *</text>
        <input class="form-input" placeholder="如：嘉午台原返" value="{{form.name}}" data-field="name" bindinput="onFieldInput" />
      </view>

      <view class="form-item">
        <text class="form-label">一句话简介</text>
        <input class="form-input" placeholder="如：秦岭北麓经典登山路线" value="{{form.shortDesc}}" data-field="shortDesc" bindinput="onFieldInput" />
      </view>

      <view class="form-item">
        <text class="form-label">详细描述</text>
        <textarea class="form-textarea form-textarea--tall" placeholder="路线的完整介绍" value="{{form.fullDesc}}" data-field="fullDesc" bindinput="onFieldInput" maxlength="2000" />
      </view>

      <view class="form-item">
        <text class="form-label">封面图片</text>
        <input class="form-input" placeholder="图片URL" value="{{form.coverImage}}" data-field="coverImage" bindinput="onFieldInput" />
        <image wx:if="{{form.coverImage}}" class="form-preview" src="{{form.coverImage}}" mode="aspectFill" />
      </view>

      <view class="form-row">
        <view class="form-item form-item--half">
          <text class="form-label">状态</text>
          <picker range="{{['开放', '关闭']}}" value="{{form.status === 'open' ? 0 : 1}}" bindchange="onStatusChange">
            <view class="form-picker">
              <text>{{form.status === 'open' ? '开放' : '关闭'}}</text>
              <text class="form-picker__arrow">▾</text>
            </view>
          </picker>
        </view>
        <view class="form-item form-item--half">
          <text class="form-label">数据来源</text>
          <input class="form-input" placeholder="如：用户贡献" value="{{form.dataSource}}" data-field="dataSource" bindinput="onFieldInput" />
        </view>
      </view>
    </view>

    <!-- 图片列表 -->
    <view class="form-section">
      <text class="form-section__title">图片列表</text>
      <view class="tag-list">
        <view class="tag-item" wx:for="{{form.images}}" wx:key="*this">
          <text class="tag-item__url">{{item}}</text>
          <view class="tag-item__remove" bindtap="removeImage" data-index="{{index}}">
            <text>✕</text>
          </view>
        </view>
      </view>
      <view class="tag-add">
        <input class="form-input form-input--small" placeholder="输入图片URL" value="{{imagesInput}}" bindinput="onImagesInput" confirm-type="done" bindconfirm="addImage" />
        <view class="tag-add__btn" bindtap="addImage">
          <text>+ 添加</text>
        </view>
      </view>
    </view>

    <!-- 位置信息 -->
    <view class="form-section">
      <text class="form-section__title">位置信息</text>

      <view class="form-item">
        <text class="form-label">区县</text>
        <input class="form-input" placeholder="如：长安区" value="{{form.location_district}}" data-field="location_district" bindinput="onFieldInput" />
      </view>

      <view class="form-row">
        <view class="form-item form-item--half">
          <text class="form-label">纬度</text>
          <input class="form-input" type="digit" placeholder="如：34.0125" value="{{form.location_lat}}" data-field="location_lat" bindinput="onFieldInput" />
        </view>
        <view class="form-item form-item--half">
          <text class="form-label">经度</text>
          <input class="form-input" type="digit" placeholder="如：108.9645" value="{{form.location_lng}}" data-field="location_lng" bindinput="onFieldInput" />
        </view>
      </view>
    </view>

    <!-- 路线参数 -->
    <view class="form-section">
      <text class="form-section__title">路线参数</text>

      <view class="form-item">
        <text class="form-label">距离 (km)</text>
        <input class="form-input" type="digit" placeholder="如：10" value="{{form.distance}}" data-field="distance" bindinput="onFieldInput" />
      </view>

      <view class="form-row">
        <view class="form-item form-item--half">
          <text class="form-label">最短用时 (h)</text>
          <input class="form-input" type="digit" placeholder="如：3" value="{{form.durationMin}}" data-field="durationMin" bindinput="onFieldInput" />
        </view>
        <view class="form-item form-item--half">
          <text class="form-label">最长用时 (h)</text>
          <input class="form-input" type="digit" placeholder="如：5" value="{{form.durationMax}}" data-field="durationMax" bindinput="onFieldInput" />
        </view>
      </view>

      <view class="form-row">
        <view class="form-item form-item--third">
          <text class="form-label">累计爬升 (m)</text>
          <input class="form-input" type="number" placeholder="950" value="{{form.elevationGain}}" data-field="elevationGain" bindinput="onFieldInput" />
        </view>
        <view class="form-item form-item--third">
          <text class="form-label">最高海拔 (m)</text>
          <input class="form-input" type="number" placeholder="1810" value="{{form.elevationMax}}" data-field="elevationMax" bindinput="onFieldInput" />
        </view>
        <view class="form-item form-item--third">
          <text class="form-label">最低海拔 (m)</text>
          <input class="form-input" type="number" placeholder="860" value="{{form.elevationMin}}" data-field="elevationMin" bindinput="onFieldInput" />
        </view>
      </view>

      <view class="form-row">
        <view class="form-item form-item--half">
          <text class="form-label">难度等级</text>
          <picker range="{{difficultyOptions}}" rangeKey="label" value="{{difficultyIndex}}" bindchange="onDifficultyChange">
            <view class="form-picker">
              <text>{{difficultyOptions[difficultyIndex].label || '请选择'}}</text>
              <text class="form-picker__arrow">▾</text>
            </view>
          </picker>
        </view>
        <view class="form-item form-item--half">
          <text class="form-label">技术等级</text>
          <picker range="{{technicalGradeOptions}}" rangeKey="label" value="{{technicalGradeIndex}}" bindchange="onTechnicalGradeChange">
            <view class="form-picker">
              <text>{{technicalGradeOptions[technicalGradeIndex].label || '请选择'}}</text>
              <text class="form-picker__arrow">▾</text>
            </view>
          </picker>
        </view>
      </view>

      <view class="form-row">
        <view class="form-item form-item--half">
          <text class="form-label">排序序号</text>
          <input class="form-input" type="number" placeholder="0" value="{{form.order}}" data-field="order" bindinput="onFieldInput" />
        </view>
        <view class="form-item form-item--half">
          <text class="form-label">预估卡路里</text>
          <input class="form-input" type="number" placeholder="如：1065" value="{{form.estimatedCalories}}" data-field="estimatedCalories" bindinput="onFieldInput" />
        </view>
      </view>
    </view>

    <!-- 路况特征 -->
    <view class="form-section">
      <text class="form-section__title">路况特征</text>

      <view class="form-item">
        <text class="form-label">地形类型（可多选）</text>
        <view class="checkbox-group">
          <view class="checkbox-item {{terrainChecked[index] ? 'checkbox-item--active' : ''}}" wx:for="{{terrainTypeOptions}}" wx:key="value" wx:for-index="index" bindtap="onTerrainToggle" data-value="{{item.value}}">
            <text class="checkbox-icon">{{terrainChecked[index] ? '☑' : '☐'}}</text>
            <text class="checkbox-label">{{item.label}}</text>
          </view>
        </view>
      </view>

      <view class="form-item">
        <text class="form-label">路线DNA（可多选）</text>
        <view class="checkbox-group">
          <view class="checkbox-item {{dnaChecked[index] ? 'checkbox-item--active' : ''}}" wx:for="{{routeDNAOptions}}" wx:key="value" wx:for-index="index" bindtap="onDNAToggle" data-value="{{item.value}}">
            <text class="checkbox-icon">{{dnaChecked[index] ? '☑' : '☐'}}</text>
            <text class="checkbox-label">{{item.label}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 适配评估 -->
    <view class="form-section">
      <text class="form-section__title">适配评估</text>

      <view class="form-row">
        <view class="form-item form-item--half">
          <text class="form-label">水源补给</text>
          <picker range="{{waterSupplyOptions}}" rangeKey="label" value="{{waterSupplyIndex}}" bindchange="onWaterSupplyChange">
            <view class="form-picker">
              <text>{{waterSupplyOptions[waterSupplyIndex].label}}</text>
              <text class="form-picker__arrow">▾</text>
            </view>
          </picker>
        </view>
        <view class="form-item form-item--half">
          <text class="form-label">安全等级</text>
          <picker range="{{safetyLevelOptions}}" rangeKey="label" value="{{safetyLevelIndex}}" bindchange="onSafetyLevelChange">
            <view class="form-picker">
              <text>{{safetyLevelOptions[safetyLevelIndex].label}}</text>
              <text class="form-picker__arrow">▾</text>
            </view>
          </picker>
        </view>
      </view>

      <view class="form-row">
        <view class="form-item form-item--half">
          <text class="form-label">信号覆盖</text>
          <picker range="{{cellCoverageOptions}}" rangeKey="label" value="{{cellCoverageIndex}}" bindchange="onCellCoverageChange">
            <view class="form-picker">
              <text>{{cellCoverageOptions[cellCoverageIndex].label}}</text>
              <text class="form-picker__arrow">▾</text>
            </view>
          </picker>
        </view>
        <view class="form-item form-item--half">
          <text class="form-label">路标清晰度</text>
          <picker range="{{trailMarkingOptions}}" rangeKey="label" value="{{trailMarkingIndex}}" bindchange="onTrailMarkingChange">
            <view class="form-picker">
              <text>{{trailMarkingOptions[trailMarkingIndex].label}}</text>
              <text class="form-picker__arrow">▾</text>
            </view>
          </picker>
        </view>
      </view>

      <view class="form-row">
        <view class="form-item form-item--half">
          <text class="form-label">亲子友好度</text>
          <picker range="{{familyFriendlyOptions}}" rangeKey="label" value="{{familyFriendlyIndex}}" bindchange="onFamilyFriendlyChange">
            <view class="form-picker">
              <text>{{familyFriendlyOptions[familyFriendlyIndex].label}}</text>
              <text class="form-picker__arrow">▾</text>
            </view>
          </picker>
        </view>
        <view class="form-item form-item--half">
          <text class="form-label">休息点数量</text>
          <input class="form-input" type="number" placeholder="0" value="{{form.restPoints}}" data-field="restPoints" bindinput="onFieldInput" />
        </view>
      </view>
    </view>

    <!-- 补给信息 -->
    <view class="form-section">
      <text class="form-section__title">起点 / 终点</text>

      <view class="form-item">
        <text class="form-label">起点名称</text>
        <input class="form-input" placeholder="如：莲花山庄" value="{{form.trailhead_startName}}" data-field="trailhead_startName" bindinput="onFieldInput" />
      </view>

      <view class="form-item">
        <text class="form-label">起点设施（可多选）</text>
        <view class="checkbox-group">
          <view class="checkbox-item {{startFacilityChecked[index] ? 'checkbox-item--active' : ''}}" wx:for="{{facilityOptions}}" wx:key="*this" wx:for-index="index" bindtap="onStartFacilityToggle" data-value="{{item}}">
            <text class="checkbox-icon">{{startFacilityChecked[index] ? '☑' : '☐'}}</text>
            <text class="checkbox-label">{{item}}</text>
          </view>
        </view>
      </view>

      <view class="form-item">
        <text class="form-label">终点名称</text>
        <input class="form-input" placeholder="如：莲花山庄" value="{{form.trailhead_endName}}" data-field="trailhead_endName" bindinput="onFieldInput" />
      </view>

      <view class="form-item">
        <text class="form-label">终点设施（可多选）</text>
        <view class="checkbox-group">
          <view class="checkbox-item {{endFacilityChecked[index] ? 'checkbox-item--active' : ''}}" wx:for="{{facilityOptions}}" wx:key="*this" wx:for-index="index" bindtap="onEndFacilityToggle" data-value="{{item}}">
            <text class="checkbox-icon">{{endFacilityChecked[index] ? '☑' : '☐'}}</text>
            <text class="checkbox-label">{{item}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 交通信息 -->
    <view class="form-section">
      <text class="form-section__title">交通信息</text>

      <view class="form-item">
        <view class="toggle-row" bindtap="onParkingToggle">
          <text class="checkbox-icon">{{form.transport_hasParking ? '☑' : '☐'}}</text>
          <text class="checkbox-label">有停车场</text>
        </view>
      </view>

      <view class="form-item">
        <text class="form-label">停车备注</text>
        <input class="form-input" placeholder="如：可停约30辆" value="{{form.transport_parkingNote}}" data-field="transport_parkingNote" bindinput="onFieldInput" />
      </view>

      <view class="form-item">
        <text class="form-label">公共交通</text>
        <textarea class="form-textarea" placeholder="公交/地铁信息" value="{{form.transport_publicTransport}}" data-field="transport_publicTransport" bindinput="onFieldInput" />
      </view>

      <view class="form-item">
        <text class="form-label">驾车指引</text>
        <textarea class="form-textarea" placeholder="自驾路线指引" value="{{form.transport_drivingGuide}}" data-field="transport_drivingGuide" bindinput="onFieldInput" />
      </view>
    </view>

    <!-- 附加属性 -->
    <view class="form-section">
      <text class="form-section__title">附加属性</text>

      <view class="form-item">
        <text class="form-label">最佳季节（可多选）</text>
        <view class="checkbox-group">
          <view class="checkbox-item {{seasonChecked[index] ? 'checkbox-item--active' : ''}}" wx:for="{{seasonOptions}}" wx:key="value" wx:for-index="index" bindtap="onSeasonToggle" data-value="{{item.value}}">
            <text class="checkbox-icon">{{seasonChecked[index] ? '☑' : '☐'}}</text>
            <text class="checkbox-label">{{item.label}}</text>
          </view>
        </view>
      </view>
    </view>

  </block>

  <!-- ========== 文章编辑 ========== -->
  <block wx:elif="{{type === 'article'}}">
    <view class="form-section">
      <text class="form-section__title">基本信息</text>

      <view class="form-item">
        <text class="form-label">标题 *</text>
        <input class="form-input" placeholder="请输入文章标题" value="{{articleForm.title}}" data-field="title" bindinput="onArticleFieldInput" />
      </view>

      <view class="form-item">
        <text class="form-label">摘要</text>
        <textarea class="form-textarea" placeholder="请输入文章摘要" value="{{articleForm.summary}}" data-field="summary" bindinput="onArticleFieldInput" maxlength="300" />
      </view>

      <view class="form-item">
        <text class="form-label">作者</text>
        <input class="form-input" placeholder="请输入作者" value="{{articleForm.author}}" data-field="author" bindinput="onArticleFieldInput" />
      </view>

      <view class="form-row">
        <view class="form-item form-item--half">
          <text class="form-label">阅读时长</text>
          <input class="form-input" placeholder="如：5分钟" value="{{articleForm.readTime}}" data-field="readTime" bindinput="onArticleFieldInput" />
        </view>
        <view class="form-item form-item--half">
          <text class="form-label">难度</text>
          <picker range="{{difficultyArticleOptions}}" rangeKey="label" value="{{difficultyArticleIndex}}" bindchange="onArticleDifficultyChange">
            <view class="form-picker">
              <text>{{difficultyArticleOptions[difficultyArticleIndex].label || '请选择'}}</text>
              <text class="form-picker__arrow">▾</text>
            </view>
          </picker>
        </view>
      </view>

      <view class="form-item">
        <text class="form-label">亮点推荐语</text>
        <textarea class="form-textarea" placeholder="亮点推荐语" value="{{articleForm.highlights}}" data-field="highlights" bindinput="onArticleFieldInput" maxlength="500" />
      </view>
    </view>

    <view class="form-section">
      <text class="form-section__title">内容</text>
      <view class="form-item">
        <text class="form-label">文章内容 *</text>
        <textarea class="form-textarea form-textarea--tall" placeholder="请输入文章内容" value="{{articleForm.content}}" data-field="content" bindinput="onArticleFieldInput" maxlength="10000" />
      </view>
    </view>

    <view class="form-section">
      <text class="form-section__title">分类标签</text>

      <view class="form-item">
        <text class="form-label">分类 *</text>
        <picker range="{{categoryOptions}}" value="{{categoryIndex}}" bindchange="onCategoryChange">
          <view class="form-picker">
            <text>{{articleForm.category || '请选择分类'}}</text>
            <text class="form-picker__arrow">▾</text>
          </view>
        </picker>
      </view>

      <view class="form-item">
        <text class="form-label">子分类</text>
        <picker range="{{currentSubcategoryOptions}}" value="{{subcategoryIndex}}" bindchange="onSubcategoryChange">
          <view class="form-picker">
            <text>{{articleForm.subcategory || '请选择子分类'}}</text>
            <text class="form-picker__arrow">▾</text>
          </view>
        </picker>
      </view>

      <view class="form-item">
        <text class="form-label">标签</text>
        <view class="tag-list">
          <view class="tag-item" wx:for="{{articleForm.tags}}" wx:key="*this">
            <text>{{item}}</text>
            <view class="tag-item__remove" bindtap="removeArticleTag" data-index="{{index}}">
              <text>✕</text>
            </view>
          </view>
        </view>
        <view class="tag-add">
          <input class="form-input form-input--small" placeholder="输入标签" value="{{tagInput}}" bindinput="onTagInput" confirm-type="done" bindconfirm="addArticleTag" />
          <view class="tag-add__btn" bindtap="addArticleTag">
            <text>+ 添加</text>
          </view>
        </view>
      </view>

      <view class="form-item">
        <text class="form-label">适合季节</text>
        <view class="season-checkbox-group">
          <view class="season-checkbox-item {{item.checked ? 'season-checkbox-item--active' : ''}}" wx:for="{{seasonOptions}}" wx:key="value" bindtap="onArticleSeasonToggle" data-index="{{index}}">
            <text class="season-checkbox-icon">{{item.checked ? '☑' : '☐'}}</text>
            <text class="season-checkbox-label">{{item.label}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="form-section">
      <text class="form-section__title">封面图</text>
      <view class="form-item">
        <text class="form-label">图片URL</text>
        <input class="form-input" placeholder="封面图片链接" value="{{articleForm.coverImage}}" data-field="coverImage" bindinput="onArticleFieldInput" />
      </view>
      <view class="form-item">
        <view class="cover-upload-btn" bindtap="onChooseCoverImage">
          <text>📷 选择图片</text>
        </view>
        <image wx:if="{{articleForm.coverImage}}" class="form-preview" src="{{articleForm.coverImage}}" mode="aspectFill" />
      </view>
    </view>

    <view class="form-section">
      <text class="form-section__title">排序</text>
      <view class="form-row">
        <view class="form-item form-item--half">
          <text class="form-label">优先级</text>
          <input class="form-input" type="number" placeholder="0" value="{{articleForm.priority}}" data-field="priority" bindinput="onArticleFieldInput" />
        </view>
        <view class="form-item form-item--half">
          <text class="form-label">排序值</text>
          <input class="form-input" type="number" placeholder="0" value="{{articleForm.order}}" data-field="order" bindinput="onArticleFieldInput" />
        </view>
      </view>
    </view>
  </block>

  <!-- 底部操作栏 -->
  <view class="save-bar">
    <view class="save-bar__row">
      <view class="delete-btn" wx:if="{{id}}" bindtap="onDelete">
        <text>删除</text>
      </view>
      <view class="draft-btn {{saving ? 'draft-btn--disabled' : ''}}" bindtap="onSaveDraft">
        <text>{{saving ? '保存中...' : '保存草稿'}}</text>
      </view>
      <view class="save-btn {{saving ? 'save-btn--disabled' : ''}}" bindtap="onPublish">
        <text>{{saving ? '发布中...' : '发布'}}</text>
      </view>
    </view>
  </view>

</view>
