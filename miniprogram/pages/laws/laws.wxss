/* pages/laws/laws.wxss */
.laws-page {
  min-height: 100vh;
  background-color: #F8F6F0;
  padding-bottom: 40rpx;
}

/* 搜索栏 */
.search-bar {
  padding: 20rpx 30rpx;
  background-color: #2D5A27;
}

.search-input-wrap {
  display: flex;
  align-items: center;
  background-color: #FFFFFF;
  border-radius: 40rpx;
  padding: 12rpx 24rpx;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
}

.search-clear {
  font-size: 28rpx;
  color: #999999;
  padding: 8rpx;
}

/* Tab栏 */
.tab-scroll {
  white-space: nowrap;
  background-color: #FFFFFF;
  border-bottom: 1rpx solid #F0F0F0;
}

.tab-bar {
  display: inline-flex;
  padding: 0 16rpx;
}

.tab-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 30rpx;
  position: relative;
  flex-shrink: 0;
}

.tab-text {
  font-size: 28rpx;
  color: #6B7B8D;
}

.tab-active .tab-text {
  color: #2D5A27;
  font-weight: bold;
}

.tab-line {
  position: absolute;
  bottom: 0;
  width: 40rpx;
  height: 4rpx;
  background-color: #2D5A27;
  border-radius: 2rpx;
}

/* 文章列表 */
.article-list {
  padding: 24rpx 30rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}

/* 文章卡片 */
.article-card {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
  border-left: 6rpx solid transparent;
}

.article-important {
  border-left-color: #E74C3C;
  background-color: #FFF9F9;
}

.article-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.article-title-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  min-width: 0;
}

.important-badge {
  display: inline-block;
  padding: 2rpx 10rpx;
  background-color: #E74C3C;
  color: #FFFFFF;
  font-size: 20rpx;
  border-radius: 6rpx;
  margin-right: 10rpx;
  flex-shrink: 0;
}

.article-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333333;
  line-height: 1.5;
}

.expand-icon {
  font-size: 24rpx;
  color: #999999;
  margin-left: 16rpx;
  flex-shrink: 0;
  margin-top: 6rpx;
}

/* 文章元信息 */
.article-meta {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.article-date {
  font-size: 22rpx;
  color: #999999;
  margin-right: 20rpx;
}

.article-category {
  font-size: 22rpx;
  color: #2D5A27;
  background-color: rgba(45, 90, 39, 0.1);
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
}

/* 文章摘要 */
.article-summary {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 文章详情 */
.article-detail {
  margin-top: 16rpx;
}

.detail-divider {
  height: 1rpx;
  background-color: #F0F0F0;
  margin-bottom: 20rpx;
}

.detail-content {
  font-size: 26rpx;
  color: #333333;
  line-height: 1.8;
  white-space: pre-wrap;
}

/* 返回顶部 */
.back-top {
  position: fixed;
  right: 30rpx;
  bottom: 120rpx;
  width: 80rpx;
  height: 80rpx;
  background-color: #2D5A27;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.2);
  z-index: 100;
}

.back-top-icon {
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: bold;
}
