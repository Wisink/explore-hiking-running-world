<!--pages/running-profile/running-profile.wxml-->
<view class="profile-page">

  <!-- 状态栏占位 -->
  <view class="page-statusbar" style="height: {{statusBarHeight}}px;"></view>

  <!-- 顶部标题 -->
  <view class="page-header">
    <view class="page-header__bg"></view>
    <view class="page-header__content">
      <!-- 头像和昵称 -->
      <view class="profile-avatar-wrap">
        <image class="profile-avatar" src="{{avatarUrl}}" mode="aspectFill" />
      </view>
      <text class="profile-nickname">{{runnerNickname}}</text>
      <text class="page-header__title">我的跑步世界！</text>
      <text class="page-header__sub">{{greetingText}}</text>
      <view class="page-header__visit" wx:if="{{userInfo}}">
        <text class="page-header__visit-text">🌍 已访问 {{userInfo.visitCount}} 次</text>
      </view>
    </view>
  </view>

  <!-- 统计卡片 -->
  <view class="stats-card">
    <view class="stats-card__item">
      <text class="stats-card__num">{{readArticleCount}}</text>
      <text class="stats-card__label">📖 累计阅读</text>
    </view>
    <view class="stats-card__divider"></view>
    <view class="stats-card__item">
      <text class="stats-card__num">{{visitCount}}</text>
      <text class="stats-card__label">👁 访问次数</text>
    </view>
  </view>

  <!-- 功能入口列表 -->
  <view class="menu-section">
    <view class="menu-item" bindtap="goToMyFavorites">
      <text class="menu-item__icon">❤️</text>
      <text class="menu-item__text">我的收藏</text>
      <text class="menu-item__arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goToMyReviews">
      <text class="menu-item__icon">✍️</text>
      <text class="menu-item__text">我的阅读感受</text>
      <text class="menu-item__arrow">›</text>
    </view>
    <view class="menu-item" bindtap="switchToHiking">
      <text class="menu-item__icon">🔄</text>
      <text class="menu-item__text">切换到徒步世界</text>
      <text class="menu-item__arrow">›</text>
    </view>
  </view>

  <!-- 管理员入口（仅管理员可见） -->
  <view class="menu-section" wx:if="{{isAdmin}}">
    <view class="menu-item" bindtap="goToAdmin">
      <text class="menu-item__icon">⚙️</text>
      <text class="menu-item__text">后台管理</text>
      <text class="menu-item__arrow">›</text>
    </view>
  </view>

  <!-- 底部 -->
  <view class="footer">
    <text class="footer__icon">🏃</text>
    <text class="footer__text">科学跑步，健康生活</text>
  </view>
  <view class="icp-footer">
    <text class="icp-footer__text" bindtap="onIcpTap">陕ICP备2026006901号</text>
  </view>

  <view class="nice-toast nice-toast--{{toastType}} {{showToast ? 'nice-toast--show' : ''}}">{{toastMessage}}</view>
</view>