/* pages/running-profile/running-profile.wxss - 跑步世界主题色 */

/* 状态栏占位 — 毛玻璃 */
.page-statusbar {
  background: linear-gradient(135deg,
    rgba(21, 101, 192, 0.5) 0%,
    rgba(66, 165, 245, 0.4) 100%
  );
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
}

.profile-page {
  min-height: 100vh;
  padding-bottom: calc(120rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
  background-color: #e3f2fd;
  background:
    radial-gradient(ellipse at 20% 50%, rgba(21,101,192,.35) 0%, transparent 50%),
    radial-gradient(ellipse at 80% 20%, rgba(66,165,245,.25) 0%, transparent 50%),
    radial-gradient(ellipse at 60% 80%, rgba(33,150,243,.2) 0%, transparent 50%),
    linear-gradient(160deg, #e3f2fd 0%, #bbdefb 25%, #90caf9 50%, #64b5f6 75%, #42a5f5 100%);
}

/* 头像和昵称 — 个性化 */
.profile-avatar-wrap {
  display: flex;
  justify-content: center;
  margin-bottom: 16rpx;
  animation: fadeInUp 400ms cubic-bezier(0.34, 1.56, 0.64, 1) both;
}

.profile-avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 4rpx solid #FFFFFF;
  box-shadow:
    0 0 0 4rpx rgba(21, 101, 192, 0.15),
    0 4rpx 20rpx rgba(21, 101, 192, 0.25),
    0 8rpx 32rpx rgba(31, 38, 50, 0.1);
}

.profile-nickname {
  display: block;
  text-align: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #0d47a1;
  margin-bottom: 52rpx;
  letter-spacing: 2rpx;
  text-shadow: 0 1rpx 4rpx rgba(255, 255, 255, 0.5);
  animation: fadeInUp 400ms cubic-bezier(0.34, 1.56, 0.64, 1) 100ms both;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 顶部标题 — 毛玻璃 */
.page-header {
  position: relative;
  padding: 32rpx 32rpx 20rpx;
  overflow: hidden;
}

.page-header__bg {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(135deg, rgba(21,101,192,.5) 0%, rgba(66,165,245,.4) 100%);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-bottom: 1px solid rgba(255,255,255,.25);
}

.page-header__content {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.page-header__title {
  font-size: 44rpx;
  font-weight: 800;
  color: #0d47a1;
  letter-spacing: 1rpx;
  text-shadow: 0 1rpx 6rpx rgba(255,255,255,.5);
}

.page-header__sub {
  font-size: 26rpx;
  color: #1565c0;
}

/* 用户访问信息 */
.page-header__visit {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 12rpx;
}

.page-header__visit-text {
  font-size: 24rpx;
  color: #1565c0;
  background: rgba(255, 255, 255, 0.3);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  border: 1px solid rgba(255, 255, 255, 0.25);
}

/* 统计卡片 — 毛玻璃 */
.stats-card {
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: rgba(255, 255, 255, 0.25);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(255,255,255,.25);
  margin: 16rpx 24rpx 24rpx;
  padding: 36rpx 20rpx;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(31,38,50,.15);
}

.stats-card__item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stats-card__num {
  font-size: 52rpx;
  font-weight: 800;
  color: #0d47a1;
  margin-bottom: 8rpx;
  animation: countUp 500ms cubic-bezier(0.175, 0.885, 0.32, 1.275) both;
}

@keyframes countUp {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.stats-card__label {
  font-size: 26rpx;
  color: #1565c0;
  font-weight: 500;
}

.stats-card__divider {
  width: 1rpx;
  height: 48rpx;
  background: rgba(255,255,255,.3);
}

/* 功能菜单 */
.menu-section {
  margin: 0 24rpx 24rpx;
  background: rgba(255, 255, 255, 0.25);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(255,255,255,.25);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(31,38,50,.15);
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1px solid rgba(255,255,255,.15);
  transition: background-color 200ms ease;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background-color: rgba(21, 101, 192, 0.1);
}

.menu-item__icon {
  font-size: 36rpx;
  margin-right: 24rpx;
}

.menu-item__text {
  flex: 1;
  font-size: 30rpx;
  color: #0d47a1;
  font-weight: 500;
}

.menu-item__arrow {
  font-size: 36rpx;
  color: #90caf9;
  font-weight: 300;
}

/* 底部 */
.footer {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 40rpx 0 20rpx;
}

.footer__icon {
  font-size: 32rpx;
}

.footer__text {
  font-size: 24rpx;
  color: #1565c0;
}

.icp-footer {
  text-align: center;
  padding: 0 0 40rpx;
}

.icp-footer__text {
  font-size: 22rpx;
  color: #90caf9;
}

/* Toast 样式 */
.nice-toast {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: rgba(0, 0, 0, 0.7);
  color: #fff;
  padding: 20rpx 40rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  z-index: 9999;
  opacity: 0;
  transition: opacity 300ms;
}

.nice-toast--show {
  opacity: 1;
}

.nice-toast--success {
  background: rgba(76, 175, 80, 0.9);
}

.nice-toast--error {
  background: rgba(244, 67, 54, 0.9);
}