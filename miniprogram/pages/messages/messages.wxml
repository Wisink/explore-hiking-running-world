<!--pages/messages/messages.wxml-->
<view class="messages-page">
  <!-- 顶部Tab栏 -->
  <view class="tab-bar">
    <view
      class="tab-item {{activeTab === item.key ? 'tab-active' : ''}}"
      wx:for="{{tabs}}"
      wx:key="key"
      data-key="{{item.key}}"
      bindtap="onTabChange"
    >
      <text class="tab-label">{{item.label}}</text>
      <!-- 未读数角标 -->
      <view class="tab-badge" wx:if="{{item.unread > 0}}">
        <text class="badge-text">{{item.unread > 99 ? '99+' : item.unread}}</text>
      </view>
    </view>
  </view>

  <!-- 消息列表 -->
  <view class="message-list" wx:if="{{filteredMessages.length > 0}}">
    <view
      class="message-item"
      wx:for="{{filteredMessages}}"
      wx:key="_id"
      data-message="{{item}}"
      bindtap="onMessageTap"
    >
      <!-- 未读红点 -->
      <view class="unread-dot" wx:if="{{!item.is_read}}"></view>

      <view class="message-content">
        <view class="message-header">
          <text class="message-title {{item.is_read ? '' : 'title-unread'}}">{{item.title}}</text>
          <view class="type-tag tag-{{item.type}}">
            <text class="tag-text">{{item.type_label}}</text>
          </view>
        </view>
        <text class="message-summary">{{item.summary}}</text>
        <text class="message-time">{{item.relative_time}}</text>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{filteredMessages.length === 0 && !loading}}">
    <text class="empty-icon">📭</text>
    <text class="empty-text">暂无消息</text>
    <text class="empty-sub">有新消息时会在这里通知你</text>
  </view>

  <!-- 底部一键已读 -->
  <view class="footer-bar" wx:if="{{unreadCount > 0}}">
    <view class="mark-read-btn" bindtap="onMarkAllRead">
      <text class="btn-text">全部已读</text>
    </view>
  </view>
</view>
