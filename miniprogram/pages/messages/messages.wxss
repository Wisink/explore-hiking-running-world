/* pages/messages/messages.wxss */
.messages-page {
  min-height: 100vh;
  background-color: #F8F6F0;
  padding-bottom: 120rpx;
}

/* 顶部Tab栏 */
.tab-bar {
  display: flex;
  background-color: #FFFFFF;
  border-bottom: 1rpx solid #F0F0F0;
  padding: 0 16rpx;
  position: sticky;
  top: 0;
  z-index: 100;
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 16rpx;
  position: relative;
}

.tab-label {
  font-size: 28rpx;
  color: #6B7B8D;
  font-weight: 400;
}

.tab-active .tab-label {
  color: #2D5A27;
  font-weight: 600;
}

.tab-active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background-color: #2D5A27;
  border-radius: 2rpx;
}

/* Tab未读角标 */
.tab-badge {
  position: absolute;
  top: 12rpx;
  right: 10rpx;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 6rpx;
  background-color: #E74C3C;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.badge-text {
  font-size: 18rpx;
  color: #FFFFFF;
  line-height: 1;
}

/* 消息列表 */
.message-list {
  padding: 16rpx 24rpx;
}

.message-item {
  display: flex;
  align-items: flex-start;
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  position: relative;
}

/* 未读红点 */
.unread-dot {
  width: 16rpx;
  height: 16rpx;
  background-color: #E74C3C;
  border-radius: 50%;
  margin-top: 12rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.message-content {
  flex: 1;
  min-width: 0;
}

.message-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.message-title {
  font-size: 30rpx;
  color: #333333;
  flex: 1;
  margin-right: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.title-unread {
  font-weight: 600;
  color: #1a1a1a;
}

/* 消息类型标签 */
.type-tag {
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.tag-text {
  font-size: 20rpx;
  white-space: nowrap;
}

/* 评论回复 */
.tag-comment_reply {
  background-color: rgba(45, 90, 39, 0.1);
}

.tag-comment_reply .tag-text {
  color: #2D5A27;
}

/* 纠错结果 */
.tag-correction_result {
  background-color: rgba(255, 140, 66, 0.1);
}

.tag-correction_result .tag-text {
  color: #FF8C42;
}

/* 系统通知 */
.tag-system {
  background-color: rgba(107, 123, 141, 0.1);
}

.tag-system .tag-text {
  color: #6B7B8D;
}

/* 安全提醒 */
.tag-safety_alert {
  background-color: rgba(231, 76, 60, 0.1);
}

.tag-safety_alert .tag-text {
  color: #E74C3C;
}

.message-summary {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.message-time {
  font-size: 22rpx;
  color: #999999;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #666666;
  font-weight: 500;
  margin-bottom: 16rpx;
}

.empty-sub {
  font-size: 26rpx;
  color: #999999;
}

/* 底部一键已读栏 */
.footer-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 48rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background-color: #FFFFFF;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

.mark-read-btn {
  background-color: #2D5A27;
  border-radius: 16rpx;
  padding: 24rpx 0;
  text-align: center;
}

.btn-text {
  font-size: 30rpx;
  color: #FFFFFF;
  font-weight: 500;
}
