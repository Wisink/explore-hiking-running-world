/* pages/home/home.wxss */

/* ===== 全局基础 ===== */
.home-page {
  background: linear-gradient(180deg, #E8F5E9 0%, #F8F6F0 15%, #F8F6F0 100%);
  min-height: 100vh;
  padding-bottom: 120rpx;
}

.section {
  margin: 0 24rpx 32rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 0 8rpx;
}

.section-title-wrap {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.section-icon {
  font-size: 32rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1A1A1A;
  letter-spacing: 0.5rpx;
}

.section-action {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: rgba(45, 90, 39, 0.08);
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
}

.action-text {
  font-size: 24rpx;
  color: #2D5A27;
  font-weight: 500;
}

.action-icon {
  font-size: 24rpx;
  color: #2D5A27;
}

/* ===== 天气卡片 ===== */
.weather-card {
  margin: 20rpx 24rpx 32rpx;
  border-radius: 28rpx;
  overflow: hidden;
  position: relative;
  box-shadow: 0 8rpx 32rpx rgba(45, 90, 39, 0.2);
}

.weather-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #1B5E20 0%, #2E7D32 30%, #43A047 70%, #66BB6A 100%);
}

.weather-content {
  position: relative;
  padding: 36rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.weather-main {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.weather-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(10rpx);
}

.weather-icon {
  font-size: 56rpx;
}

.weather-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.weather-temp {
  font-size: 56rpx;
  font-weight: 800;
  color: #FFFFFF;
  letter-spacing: -1rpx;
  line-height: 1;
}

.weather-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  font-weight: 500;
}

.weather-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
}

.weather-advice-badge {
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
  backdrop-filter: blur(10rpx);
}

.weather-advice-badge.good {
  background: rgba(76, 175, 80, 0.3);
  border: 1rpx solid rgba(76, 175, 80, 0.4);
}

.weather-advice-badge.warn {
  background: rgba(255, 152, 0, 0.3);
  border: 1rpx solid rgba(255, 152, 0, 0.4);
}

.advice-text {
  font-size: 22rpx;
  color: #FFFFFF;
  font-weight: 500;
}

.weather-location {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.6);
}

/* ===== 今日推荐卡片 ===== */
.recommend-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
  transition: all 0.3s ease;
}

.recommend-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.recommend-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.recommend-badge {
  background: linear-gradient(135deg, #FF6B35 0%, #FF8F65 100%);
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 600;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  letter-spacing: 1rpx;
}

.recommend-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #1A1A1A;
  letter-spacing: 0.5rpx;
}

.recommend-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.tag {
  padding: 10rpx 18rpx;
  border-radius: 16rpx;
  background: #F5F5F5;
}

.tag-location {
  background: #E3F2FD;
}

.tag-difficulty {
  background: #FFF3E0;
}

.tag-scenery {
  background: #FFF8E1;
}

.tag-text {
  font-size: 22rpx;
  color: #555555;
  font-weight: 500;
}

.recommend-reason {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.7;
  display: block;
  margin-bottom: 24rpx;
}

.recommend-footer {
  display: flex;
  justify-content: flex-end;
}

.recommend-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: linear-gradient(135deg, #2D5A27 0%, #43A047 100%);
  padding: 14rpx 28rpx;
  border-radius: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(45, 90, 39, 0.25);
}

.btn-text {
  font-size: 24rpx;
  color: #FFFFFF;
  font-weight: 600;
}

.btn-arrow {
  font-size: 24rpx;
  color: #FFFFFF;
}

/* ===== 快速入口 ===== */
.quick-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
}

.quick-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: calc(33.33% - 12rpx);
  padding: 16rpx 0;
}

.quick-item-hover {
  opacity: 0.7;
  transform: scale(0.95);
}

.quick-icon-wrap {
  width: 100rpx;
  height: 100rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 14rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.quick-icon-wrap.beginner {
  background: linear-gradient(135deg, #C8E6C9 0%, #A5D6A7 100%);
}

.quick-icon-wrap.family {
  background: linear-gradient(135deg, #FFE0B2 0%, #FFCC80 100%);
}

.quick-icon-wrap.equipment {
  background: linear-gradient(135deg, #BBDEFB 0%, #90CAF9 100%);
}

.quick-icon-wrap.etiquette {
  background: linear-gradient(135deg, #E1BEE7 0%, #CE93D8 100%);
}

.quick-icon-wrap.safety {
  background: linear-gradient(135deg, #FFCDD2 0%, #EF9A9A 100%);
}

.quick-icon {
  font-size: 44rpx;
}

.quick-label {
  font-size: 26rpx;
  color: #1A1A1A;
  font-weight: 600;
  margin-bottom: 4rpx;
}

.quick-desc {
  font-size: 20rpx;
  color: #999999;
}

/* ===== 热门路线 ===== */
.hot-list {
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
  overflow: hidden;
}

.hot-item {
  display: flex;
  align-items: center;
  padding: 26rpx 28rpx;
  border-bottom: 1rpx solid #F5F5F5;
  transition: background 0.2s;
}

.hot-item:last-child {
  border-bottom: none;
}

.hot-item:active {
  background: #FAFAFA;
}

.hot-rank {
  width: 52rpx;
  height: 52rpx;
  border-radius: 16rpx;
  background: #F0F0F0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.hot-rank.rank-top {
  background: linear-gradient(135deg, #FF6B35 0%, #FF8F65 100%);
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 53, 0.3);
}

.rank-num {
  font-size: 24rpx;
  font-weight: 700;
  color: #888888;
}

.hot-rank.rank-top .rank-num {
  color: #FFFFFF;
}

.hot-info {
  flex: 1;
  min-width: 0;
}

.hot-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 6rpx;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hot-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.hot-location {
  font-size: 22rpx;
  color: #999999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hot-difficulty {
  font-size: 20rpx;
  color: #666666;
  background: #F5F5F5;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.hot-likes {
  display: flex;
  align-items: center;
  gap: 6rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.likes-icon {
  font-size: 22rpx;
}

.likes-num {
  font-size: 22rpx;
  color: #888888;
  font-weight: 500;
}

/* ===== 加载状态 ===== */
.loading-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #E0E0E0;
  border-top-color: #2D5A27;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: #999999;
}

/* ===== 底部 ===== */
.footer {
  text-align: center;
  padding: 48rpx 24rpx 32rpx;
}

.footer-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.footer-main {
  font-size: 28rpx;
  color: #666666;
  font-weight: 600;
  display: block;
  margin-bottom: 8rpx;
}

.footer-sub {
  font-size: 22rpx;
  color: #AAAAAA;
}
