<!--pages/home/home.wxml-->
<view class="home-page">

  <!-- 1. 天气卡片（全新设计 - 沉浸式渐变） -->
  <view class="weather-card" bindtap="onWeatherTap">
    <view class="weather-bg"></view>
    <view class="weather-content">
      <view class="weather-main">
        <view class="weather-icon-wrap">
          <text class="weather-icon">{{weather.icon}}</text>
        </view>
        <view class="weather-info">
          <text class="weather-temp">{{weather.temp}}°</text>
          <text class="weather-desc">{{weather.desc}}</text>
        </view>
      </view>
      <view class="weather-side">
        <view class="weather-advice-badge {{weather.advice.includes('适合') ? 'good' : 'warn'}}">
          <text class="advice-text">{{weather.advice}}</text>
        </view>
        <text class="weather-location">📍 西安 · {{weather.updateTime}}</text>
      </view>
    </view>
  </view>

  <!-- 2. 今日路线推荐（大卡片设计） -->
  <view class="section">
    <view class="section-header">
      <view class="section-title-wrap">
        <text class="section-icon">🎯</text>
        <text class="section-title">今日推荐</text>
      </view>
      <view class="section-action" bindtap="refreshTodayRecommend">
        <text class="action-text">换一条</text>
        <text class="action-icon">↻</text>
      </view>
    </view>

    <view class="recommend-card" wx:if="{{todayTrail}}" bindtap="onTrailTap" data-id="{{todayTrail._id}}">
      <view class="recommend-header">
        <view class="recommend-badge">今日精选</view>
        <text class="recommend-name">{{todayTrail.name}}</text>
      </view>
      
      <view class="recommend-tags">
        <view class="tag tag-location">
          <text class="tag-text">📍 {{todayTrail.location}}</text>
        </view>
        <view class="tag tag-difficulty">
          <text class="tag-text">⛰️ {{todayTrail.difficulty}}</text>
        </view>
        <view class="tag tag-scenery">
          <text class="tag-text">⭐ {{todayTrail.scenery}}星</text>
        </view>
      </view>
      
      <text class="recommend-reason">{{todayTrail.reason}}</text>
      
      <view class="recommend-footer">
        <view class="recommend-btn">
          <text class="btn-text">查看详情</text>
          <text class="btn-arrow">→</text>
        </view>
      </view>
    </view>

    <view class="loading-card" wx:if="{{!todayTrail && !loadError}}">
      <view class="loading-spinner"></view>
      <text class="loading-text">正在为你精选路线...</text>
    </view>
  </view>

  <!-- 3. 快速入口（全新网格设计） -->
  <view class="section">
    <view class="section-header">
      <view class="section-title-wrap">
        <text class="section-icon">⚡</text>
        <text class="section-title">快速出发</text>
      </view>
    </view>
    
    <view class="quick-grid">
      <view class="quick-item" bindtap="onQuickTap" data-action="beginner" hover-class="quick-item-hover">
        <view class="quick-icon-wrap beginner">
          <text class="quick-icon">🥾</text>
        </view>
        <text class="quick-label">初级路线</text>
        <text class="quick-desc">新手友好</text>
      </view>
      
      <view class="quick-item" bindtap="onQuickTap" data-action="family" hover-class="quick-item-hover">
        <view class="quick-icon-wrap family">
          <text class="quick-icon">👨‍👩‍👧</text>
        </view>
        <text class="quick-label">亲子路线</text>
        <text class="quick-desc">全家出游</text>
      </view>
      
      <view class="quick-item" bindtap="onQuickTap" data-action="equipment" hover-class="quick-item-hover">
        <view class="quick-icon-wrap equipment">
          <text class="quick-icon">🎒</text>
        </view>
        <text class="quick-label">装备清单</text>
        <text class="quick-desc">出行必备</text>
      </view>
      
      <view class="quick-item" bindtap="onQuickTap" data-action="etiquette" hover-class="quick-item-hover">
        <view class="quick-icon-wrap etiquette">
          <text class="quick-icon">🤝</text>
        </view>
        <text class="quick-label">户外礼仪</text>
        <text class="quick-desc">文明出行</text>
      </view>
      
      <view class="quick-item" bindtap="onQuickTap" data-action="safety" hover-class="quick-item-hover">
        <view class="quick-icon-wrap safety">
          <text class="quick-icon">🛡️</text>
        </view>
        <text class="quick-label">安全指南</text>
        <text class="quick-desc">平安归来</text>
      </view>
    </view>
  </view>

  <!-- 4. 热门路线（全新排行榜设计） -->
  <view class="section">
    <view class="section-header">
      <view class="section-title-wrap">
        <text class="section-icon">🔥</text>
        <text class="section-title">热门路线</text>
      </view>
    </view>

    <view class="hot-list">
      <view class="hot-item" wx:for="{{hotTrails}}" wx:key="_id" bindtap="onTrailTap" data-id="{{item._id}}">
        <view class="hot-rank {{index < 3 ? 'rank-top' : ''}}">
          <text class="rank-num">{{index + 1}}</text>
        </view>
        <view class="hot-info">
          <text class="hot-name">{{item.name}}</text>
          <view class="hot-meta">
            <text class="hot-location">📍 {{item.location}}</text>
            <text class="hot-difficulty">{{item.difficulty}}</text>
          </view>
        </view>
        <view class="hot-likes">
          <text class="likes-icon">👍</text>
          <text class="likes-num">{{item.likes_count || 0}}</text>
        </view>
      </view>
    </view>

    <view class="loading-card" wx:if="{{hotTrails.length === 0 && !loadError}}">
      <view class="loading-spinner"></view>
      <text class="loading-text">加载热门路线中...</text>
    </view>
  </view>

  <!-- 底部安全提示 -->
  <view class="footer">
    <view class="footer-icon">🌿</view>
    <text class="footer-main">安全出行，快乐户外</text>
    <text class="footer-sub">请遵守相关法律法规，文明徒步</text>
  </view>
</view>
