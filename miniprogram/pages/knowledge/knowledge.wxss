/* pages/knowledge/knowledge.wxss - v3.0 自然清新风 + 毛玻璃 */

/* 状态栏占位 — 毛玻璃 */
.page-statusbar {
  background: linear-gradient(135deg,
    rgba(129, 199, 132, 0.5) 0%,
    rgba(76, 175, 80, 0.4) 100%
  );
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
}

/* ===== CSS Variables ===== */
:host {
  --glass-bg: rgba(255, 255, 255, 0.22);
  --glass-bg-light: rgba(255, 255, 255, 0.12);
  --glass-bg-strong: rgba(255, 255, 255, 0.35);
  --glass-border: rgba(255, 255, 255, 0.25);
  --glass-blur: blur(16px);
  --glass-shadow: 0 8rpx 32rpx rgba(31, 38, 50, 0.18);
  --text: #1a2e1a;
  --text2: #4a6b4a;
  --primary: #4CAF50;
  --primary-dark: #2d6a4f;
  --r: 36rpx;
  --tr: all 350ms cubic-bezier(0.4, 0, 0.2, 1);
}

.knowledge-page {
  min-height: 100vh;
  padding-bottom: calc(140rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  background-color: #c8e6c9;
  background:
    radial-gradient(ellipse at 20% 50%, rgba(129,199,132,.6) 0%, transparent 50%),
    radial-gradient(ellipse at 80% 20%, rgba(165,214,167,.5) 0%, transparent 50%),
    radial-gradient(ellipse at 60% 80%, rgba(76,175,80,.4) 0%, transparent 50%),
    radial-gradient(ellipse at 10% 90%, rgba(200,230,201,.6) 0%, transparent 40%),
    linear-gradient(160deg, #e8f5e9 0%, #c8e6c9 25%, #a5d6a7 50%, #81c784 75%, #66bb6a 100%);
}

/* 顶部标题 — 毛玻璃 */
.page-header {
  position: relative;
  padding: 48rpx 32rpx 40rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
}

.page-header__bg {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(135deg, rgba(129,199,132,.5) 0%, rgba(76,175,80,.4) 100%);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-bottom: 1px solid rgba(255,255,255,.25);
}

.page-header__content {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.page-header__emoji { font-size: 48rpx; margin-bottom: 8rpx; }

.page-header__title {
  font-size: 44rpx;
  font-weight: 800;
  color: #1a2e1a;
  letter-spacing: 1rpx;
  text-shadow: 0 1rpx 6rpx rgba(255,255,255,.5);
}

.page-header__sub {
  font-size: 26rpx;
  color: #6b8b6b;
  letter-spacing: 2rpx;
}

/* 通用区块 */
.section { margin: 0 24rpx 36rpx; }

.section__head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 0 8rpx;
}

.section__title-wrap {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.section__icon { font-size: 32rpx; }

.section__title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a2e1a;
}

.section__count {
  background: rgba(129, 199, 132, 0.2);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #2d6a4f;
  font-weight: 500;
  border: 1px solid rgba(129,199,132,.15);
}

/* 文章列表 — 毛玻璃 */
.article-list {
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border: 1px solid rgba(255,255,255,.2);
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(31,38,50,.1);
  overflow: hidden;
}

.article-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1px solid rgba(255,255,255,.12);
  transition: background 150ms ease;
}

.article-item:last-child { border-bottom: none; }

.article-item--hover {
  background: rgba(255,255,255,.1);
}

.article-item__icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
  font-size: 36rpx;
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border: 1px solid rgba(255,255,255,.2);
}

.article-item__icon--equip {
  background: rgba(200, 230, 201, 0.5);
}

.article-item__icon--safety {
  background: rgba(255, 205, 210, 0.5);
}

.article-item__icon--manner {
  background: rgba(225, 190, 231, 0.5);
}

.article-item__icon--other {
  background: rgba(187, 222, 251, 0.5);
}

.article-item__body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.article-item__title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a2e1a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.article-item__summary {
  font-size: 24rpx;
  color: #6b8b6b;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.article-item__arrow {
  font-size: 36rpx;
  color: #6b8b6b;
  font-weight: 300;
  margin-left: 12rpx;
  flex-shrink: 0;
}

/* 加载状态 — 毛玻璃 */
.loading-card {
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(255,255,255,.2);
  border-radius: 24rpx;
  padding: 80rpx 60rpx;
  margin: 40rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(31,38,50,.12);
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid rgba(255,255,255,.3);
  border-top-color: #2d6a4f;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin { to { transform: rotate(360deg); } }

.loading-text { font-size: 26rpx; color: #6b8b6b; }

/* 底部 */
.footer {
  text-align: center;
  padding: 48rpx 24rpx 32rpx;
}

.footer__icon { font-size: 48rpx; margin-bottom: 12rpx; display: block; }

.footer__main {
  font-size: 28rpx;
  color: #4a6b4a;
  font-weight: 600;
  display: block;
  margin-bottom: 8rpx;
}

.footer__sub { font-size: 22rpx; color: #6b8b6b; }

/* 新手入门路径 — 毛玻璃 */
.learning-path {
  position: relative;
  margin: 24rpx 24rpx 32rpx;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(31,38,50,.12);
}

.learning-path__bg {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(255, 255, 255, 0.22);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(255,255,255,.25);
  border-radius: 24rpx;
}

.learning-path__inner {
  position: relative;
  padding: 28rpx 24rpx 32rpx;
}

.learning-path__title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a2e1a;
  margin-bottom: 24rpx;
}

.learning-path__steps {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
}

.step {
  flex: 1;
  aspect-ratio: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.35);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border: 1px solid rgba(255,255,255,.3);
  border-radius: 20rpx;
  gap: 10rpx;
  transition: transform 150ms ease;
  box-shadow: 0 4rpx 12rpx rgba(31,38,50,.08);
}

.step:active {
  transform: scale(0.93);
}

.step__icon {
  font-size: 44rpx;
}

.step__label {
  font-size: 24rpx;
  color: #2d6a4f;
  font-weight: 600;
}

.step-arrow {
  font-size: 32rpx;
  color: rgba(45, 106, 79, 0.4);
  font-weight: 300;
  flex-shrink: 0;
  width: 20rpx;
  text-align: center;
}

/* 分类快速入口 — 毛玻璃 */
.category-cards {
  display: flex;
  gap: 16rpx;
  padding: 24rpx;
}

.category-card {
  flex: 1;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border: 1px solid rgba(255,255,255,.2);
  border-radius: 16rpx;
  padding: 24rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  box-shadow: 0 2rpx 8rpx rgba(31,38,50,.08);
}

.category-card--on {
  background: rgba(200, 230, 201, 0.4);
  border-color: rgba(129,199,132,.3);
  box-shadow: 0 2rpx 12rpx rgba(76,175,80,.15);
}

.category-card__icon { font-size: 48rpx; }
.category-card__title { font-size: 26rpx; font-weight: 600; color: #1a2e1a; }
.category-card__count { font-size: 22rpx; color: #6b8b6b; }

/* 查看更多按钮 */
.show-more {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 20rpx 0 10rpx;
}

.show-more__text {
  font-size: 26rpx;
  color: #2d6a4f;
  font-weight: 500;
}

/* 新手路径副标题 */
.learning-path__subtitle {
  font-size: 24rpx;
  color: #6b8b6b;
  margin-bottom: 20rpx;
  margin-top: -16rpx;
}

/* 新手精选推荐 — 横滑卡片 */
.recommended-scroll {
  white-space: nowrap;
  width: 100%;
}

.recommended-card {
  display: inline-flex;
  flex-direction: column;
  width: 320rpx;
  margin-right: 20rpx;
  background: rgba(255, 255, 255, 0.25);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border: 1px solid rgba(255,255,255,.25);
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(31,38,50,.1);
  vertical-align: top;
  transition: transform 150ms ease;
}

.recommended-card:active {
  transform: scale(0.97);
}

.recommended-card__cover {
  height: 140rpx;
  display: flex;
  align-items: flex-start;
  justify-content: flex-end;
  padding: 16rpx;
}

.recommended-card__badge {
  font-size: 20rpx;
  color: #fff;
  background: rgba(0,0,0,.25);
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
}

.recommended-card__title {
  font-size: 26rpx;
  font-weight: 600;
  color: #1a2e1a;
  padding: 16rpx 16rpx 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recommended-card__summary {
  font-size: 22rpx;
  color: #6b8b6b;
  padding: 0 16rpx 20rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  white-space: normal;
  line-height: 1.5;
}
