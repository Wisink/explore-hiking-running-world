/* pages/knowledge/knowledge.wxss */

.knowledge-page {
  background: linear-gradient(180deg, #E8F5E9 0%, #F8F6F0 12%, #F8F6F0 100%);
  min-height: 100vh;
  padding-bottom: 140rpx;
}

/* ===== 顶部标题 ===== */
.page-header {
  position: relative;
  padding: 48rpx 32rpx 40rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, rgba(45, 90, 39, 0.06) 0%, rgba(67, 160, 71, 0.04) 100%);
}

.header-content {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 8rpx;
}

.header-emoji {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.header-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #1A1A1A;
  letter-spacing: 1rpx;
}

.header-subtitle {
  font-size: 26rpx;
  color: #888888;
  font-weight: 400;
  letter-spacing: 2rpx;
}

/* ===== 通用区块 ===== */
.section {
  margin: 0 24rpx 36rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 0 8rpx;
}

.section-title-wrap {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.section-icon {
  font-size: 32rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1A1A1A;
  letter-spacing: 0.5rpx;
}

.article-count {
  background: rgba(45, 90, 39, 0.08);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.count-text {
  font-size: 22rpx;
  color: #2D5A27;
  font-weight: 500;
}

/* ===== 推荐阅读横向滚动 ===== */
.recommend-scroll {
  white-space: nowrap;
  overflow: hidden;
}

.recommend-card {
  display: inline-flex;
  flex-direction: column;
  width: 420rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  margin-right: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
  transition: all 0.3s ease;
}

.recommend-card:active {
  transform: scale(0.97);
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.08);
}

.recommend-card:last-child {
  margin-right: 0;
}

.recommend-cover {
  height: 180rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.recommend-cover-icon {
  font-size: 64rpx;
  opacity: 0.9;
}

.recommend-info {
  padding: 20rpx 24rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.recommend-tag {
  align-self: flex-start;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  background: rgba(45, 90, 39, 0.08);
  font-size: 20rpx;
  color: #2D5A27;
  font-weight: 500;
}

.recommend-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A1A;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recommend-summary {
  font-size: 24rpx;
  color: #888888;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ===== 文章列表 ===== */
.article-list {
  background: #FFFFFF;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  border: 1rpx solid rgba(0, 0, 0, 0.03);
  overflow: hidden;
}

.article-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #F5F5F5;
  transition: background 0.2s;
}

.article-item:last-child {
  border-bottom: none;
}

.article-item:active {
  background: #FAFAFA;
}

.article-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.icon-equip {
  background: linear-gradient(135deg, #C8E6C9 0%, #A5D6A7 100%);
}

.icon-safety {
  background: linear-gradient(135deg, #FFCDD2 0%, #EF9A9A 100%);
}

.icon-etiquette {
  background: linear-gradient(135deg, #E1BEE7 0%, #CE93D8 100%);
}

.article-icon {
  font-size: 36rpx;
}

.article-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.article-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.article-summary {
  font-size: 24rpx;
  color: #999999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.article-arrow {
  flex-shrink: 0;
  margin-left: 12rpx;
}

.arrow-icon {
  font-size: 36rpx;
  color: #CCCCCC;
  font-weight: 300;
}

/* ===== 加载状态 ===== */
.loading-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 80rpx 60rpx;
  margin: 40rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #E0E0E0;
  border-top-color: #2D5A27;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: #999999;
}

/* ===== 底部 ===== */
.footer {
  text-align: center;
  padding: 48rpx 24rpx 32rpx;
}

.footer-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
  display: block;
}

.footer-main {
  font-size: 28rpx;
  color: #666666;
  font-weight: 600;
  display: block;
  margin-bottom: 8rpx;
}

.footer-sub {
  font-size: 22rpx;
  color: #AAAAAA;
}
