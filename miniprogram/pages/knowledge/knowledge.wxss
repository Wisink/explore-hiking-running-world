/* pages/knowledge/knowledge.wxss - v2.0 */

.knowledge-page {
  background: linear-gradient(180deg, #E8F5E9 0%, #FAFAF5 10%);
  min-height: 100vh;
  padding-bottom: 140rpx;
}

/* 顶部标题 */
.page-header {
  position: relative;
  padding: 48rpx 32rpx 40rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
}

.page-header__bg {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(135deg, rgba(46, 125, 50, 0.06) 0%, rgba(67, 160, 71, 0.04) 100%);
}

.page-header__content {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.page-header__emoji {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.page-header__title {
  font-size: 44rpx;
  font-weight: 800;
  color: #1A1A1A;
  letter-spacing: 1rpx;
}

.page-header__sub {
  font-size: 26rpx;
  color: #9E9E99;
  letter-spacing: 2rpx;
}

/* 通用区块 */
.section {
  margin: 0 24rpx 36rpx;
}

.section__head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 0 8rpx;
}

.section__title-wrap {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.section__icon {
  font-size: 32rpx;
}

.section__title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.section__count {
  background: rgba(46, 125, 50, 0.08);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #2E7D32;
  font-weight: 500;
}

/* 推荐阅读横向滚动 */
.recommend-scroll {
  white-space: nowrap;
  overflow: hidden;
}

.recommend-card {
  display: inline-flex;
  flex-direction: column;
  width: 420rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  margin-right: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  transition: transform 200ms ease;
}

.recommend-card:active {
  transform: scale(0.97);
}

.recommend-card__cover {
  height: 180rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.recommend-card__icon {
  font-size: 64rpx;
  opacity: 0.9;
}

.recommend-card__info {
  padding: 20rpx 24rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.recommend-card__tag {
  align-self: flex-start;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  background: rgba(46, 125, 50, 0.08);
  font-size: 20rpx;
  color: #2E7D32;
  font-weight: 500;
}

.recommend-card__title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A1A;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recommend-card__summary {
  font-size: 24rpx;
  color: #9E9E99;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 文章列表 */
.article-list {
  background: #FFFFFF;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  overflow: hidden;
}

.article-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #F5F5F0;
  transition: background 150ms ease;
}

.article-item:last-child {
  border-bottom: none;
}

.article-item--hover {
  background: #FAFAF5;
}

.article-item__icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
  font-size: 36rpx;
}

.article-item__icon--equip {
  background: linear-gradient(135deg, #C8E6C9 0%, #A5D6A7 100%);
}

.article-item__icon--safety {
  background: linear-gradient(135deg, #FFCDD2 0%, #EF9A9A 100%);
}

.article-item__icon--manner {
  background: linear-gradient(135deg, #E1BEE7 0%, #CE93D8 100%);
}

.article-item__body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.article-item__title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.article-item__summary {
  font-size: 24rpx;
  color: #9E9E99;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.article-item__arrow {
  font-size: 36rpx;
  color: #C0C0BB;
  font-weight: 300;
  margin-left: 12rpx;
  flex-shrink: 0;
}

/* 加载状态 */
.loading-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 80rpx 60rpx;
  margin: 40rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.05);
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #E0E0DB;
  border-top-color: #2E7D32;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin { to { transform: rotate(360deg); } }

.loading-text {
  font-size: 26rpx;
  color: #9E9E99;
}

/* 底部 */
.footer {
  text-align: center;
  padding: 48rpx 24rpx 32rpx;
}

.footer__icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
  display: block;
}

.footer__main {
  font-size: 28rpx;
  color: #757570;
  font-weight: 600;
  display: block;
  margin-bottom: 8rpx;
}

.footer__sub {
  font-size: 22rpx;
  color: #C0C0BB;
}

/* 分类快速入口 */
.category-cards {
  display: flex;
  gap: 16rpx;
  padding: 24rpx;
}

.category-card {
  flex: 1;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.category-card--on {
  background: #E8F5E9;
  box-shadow: 0 2rpx 12rpx rgba(76,175,80,0.2);
}

.category-card__icon {
  font-size: 48rpx;
}

.category-card__title {
  font-size: 26rpx;
  font-weight: 600;
  color: #303028;
}

.category-card__count {
  font-size: 22rpx;
  color: #9E9E99;
}
