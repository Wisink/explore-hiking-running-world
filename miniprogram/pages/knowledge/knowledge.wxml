<!--pages/knowledge/knowledge.wxml-->
<view class="knowledge-page">
  <!-- 顶部标题 -->
  <view class="page-header">
    <view class="page-header__bg"></view>
    <view class="page-header__content">
      <text class="page-header__emoji">📚</text>
      <text class="page-header__title">户外知识</text>
      <text class="page-header__sub">装备 · 安全 · 礼仪</text>
    </view>
  </view>

  <!-- 加载状态 -->
  <view class="loading-card" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">正在加载知识库...</text>
  </view>

  <block wx:if="{{!loading}}">
    <!-- 推荐阅读 -->
    <view class="section">
      <view class="section__head">
        <view class="section__title-wrap">
          <text class="section__icon">⭐</text>
          <text class="section__title">推荐阅读</text>
        </view>
      </view>
      <scroll-view class="recommend-scroll" scroll-x enable-flex>
        <view
          class="recommend-card"
          wx:for="{{recommended}}"
          wx:key="_id"
          data-id="{{item._id}}"
          bindtap="onRecommendedTap"
        >
          <view class="recommend-card__cover" style="background: {{item.coverGradient}}">
            <text class="recommend-card__icon">{{item.category === '装备选购' ? '🥾' : item.category === '安全自救' ? '🆘' : '🤝'}}</text>
          </view>
          <view class="recommend-card__info">
            <view class="recommend-card__tag">{{item.category}}</view>
            <text class="recommend-card__title">{{item.title}}</text>
            <text class="recommend-card__summary">{{item.summary}}</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 知识分类列表 -->
    <view class="section" wx:for="{{categories}}" wx:key="key" wx:if="{{categorizedArticles[item.key] && categorizedArticles[item.key].length > 0}}">
      <view class="section__head">
        <view class="section__title-wrap">
          <text class="section__icon">{{item.icon}}</text>
          <text class="section__title">{{item.name}}</text>
        </view>
        <view class="section__count">
          <text>{{categorizedArticles[item.key].length}}篇</text>
        </view>
      </view>

      <view class="article-list">
        <view
          class="article-item"
          wx:for="{{categorizedArticles[item.key]}}"
          wx:for-item="article"
          wx:key="_id"
          data-id="{{article._id}}"
          bindtap="onArticleTap"
          hover-class="article-item--hover"
          hover-stay-time="80"
        >
          <view class="article-item__icon {{article.category === '装备选购' ? 'article-item__icon--equip' : article.category === '安全自救' ? 'article-item__icon--safety' : 'article-item__icon--manner'}}">
            <text>{{article.category === '装备选购' ? '🥾' : article.category === '安全自救' ? '🆘' : '🤝'}}</text>
          </view>
          <view class="article-item__body">
            <text class="article-item__title">{{article.title}}</text>
            <text class="article-item__summary">{{article.summary}}</text>
          </view>
          <text class="article-item__arrow">›</text>
        </view>
      </view>
    </view>

    <!-- 底部 -->
    <view class="footer">
      <text class="footer__icon">🌿</text>
      <text class="footer__main">知识就是力量</text>
      <text class="footer__sub">安全徒步，从学习开始</text>
    </view>
  </block>
</view>
