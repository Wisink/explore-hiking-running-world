<!--pages/knowledge/knowledge.wxml-->
<view class="knowledge-page">
  <!-- 状态栏占位 -->
  <view class="page-statusbar" style="height: {{statusBarHeight}}px;"></view>
  <!-- 顶部标题 -->
  <view class="page-header">
    <view class="page-header__bg"></view>
    <view class="page-header__content">
      <text class="page-header__emoji">📚</text>
      <text class="page-header__title">户外知识</text>
      <text class="page-header__sub">装备 · 安全 · 礼仪</text>
    </view>
  </view>

  <!-- 加载状态 -->
  <view class="loading-card" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">正在加载知识库...</text>
  </view>

  <block wx:if="{{!loading}}">
    <!-- 新手入门路径 -->
    <view class="learning-path">
      <view class="learning-path__bg"></view>
      <view class="learning-path__inner">
        <view class="learning-path__title">🚀 新手入门路径</view>
        <view class="learning-path__steps">
          <view class="step" bindtap="onStepTap" data-category="装备推荐">
            <text class="step__icon">🥾</text>
            <text class="step__label">装备</text>
          </view>
          <view class="step-arrow">›</view>
          <view class="step" bindtap="onStepTap" data-category="安全自救">
            <text class="step__icon">🆘</text>
            <text class="step__label">安全</text>
          </view>
          <view class="step-arrow">›</view>
          <view class="step" bindtap="onStepTap" data-category="户外礼仪">
            <text class="step__icon">🤝</text>
            <text class="step__label">礼仪</text>
          </view>
          <view class="step-arrow">›</view>
          <view class="step" bindtap="onStepTap" data-category="实践">
            <text class="step__icon">🏔️</text>
            <text class="step__label">出发</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 分类快速入口 -->
    <view class="category-cards">
      <view class="category-card {{activeCategory === '装备推荐' ? 'category-card--on' : ''}}" data-category="装备推荐" bindtap="onCategoryTap">
        <text class="category-card__icon">🥾</text>
        <text class="category-card__title">装备推荐</text>
        <text class="category-card__count">{{categoryCount.equipment}}篇</text>
      </view>
      <view class="category-card {{activeCategory === '安全自救' ? 'category-card--on' : ''}}" data-category="安全自救" bindtap="onCategoryTap">
        <text class="category-card__icon">🆘</text>
        <text class="category-card__title">安全自救</text>
        <text class="category-card__count">{{categoryCount.safety}}篇</text>
      </view>
      <view class="category-card {{activeCategory === '户外礼仪' ? 'category-card--on' : ''}}" data-category="户外礼仪" bindtap="onCategoryTap">
        <text class="category-card__icon">🤝</text>
        <text class="category-card__title">户外礼仪</text>
        <text class="category-card__count">{{categoryCount.etiquette}}篇</text>
      </view>
    </view>

    <!-- 知识分类列表 -->
    <view class="section" wx:for="{{categories}}" wx:key="key" wx:if="{{displayedCategorizedArticles[item.key] && displayedCategorizedArticles[item.key].length > 0 || categorizedArticles[item.key] && categorizedArticles[item.key].length > 0}}">
      <view class="section__head">
        <view class="section__title-wrap">
          <text class="section__icon">{{item.icon}}</text>
          <text class="section__title">{{item.name}}</text>
        </view>
        <view class="section__count">
          <text>{{categorizedArticles[item.key].length}}篇</text>
        </view>
      </view>

      <view class="article-list">
        <view
          class="article-item"
          wx:for="{{displayedCategorizedArticles[item.key]}}"
          wx:for-item="article"
          wx:key="_id"
          data-id="{{article._id}}"
          bindtap="onArticleTap"
          hover-class="article-item--hover"
          hover-stay-time="80"
        >
          <view class="article-item__icon {{article.category === '装备推荐' ? 'article-item__icon--equip' : article.category === '安全自救' ? 'article-item__icon--safety' : 'article-item__icon--manner'}}">
            <text>{{article.category === '装备推荐' ? '🥾' : article.category === '安全自救' ? '🆘' : '🤝'}}</text>
          </view>
          <view class="article-item__body">
            <text class="article-item__title">{{article.title}}</text>
            <text class="article-item__summary">{{article.summary}}</text>
          </view>
          <text class="article-item__arrow">›</text>
        </view>
      </view>

      <!-- 查看全部按钮 -->
      <view class="show-more" wx:if="{{categorizedArticles[item.key].length > 5}}" data-category="{{item.key}}" bindtap="onViewAll">
        <text class="show-more__text">查看全部 ›</text>
      </view>
    </view>

    <!-- 底部 -->
    <view class="footer">
      <text class="footer__icon">🌿</text>
      <text class="footer__main">知识就是力量</text>
      <text class="footer__sub">安全徒步，从学习开始</text>
    </view>
  </block>
</view>
