<!--pages/running-article-list/running-article-list.wxml-->
<view class="running-article-list">
  <!-- 状态栏占位 -->
  <view class="page-statusbar" style="height: {{statusBarHeight}}px;"></view>
  
  <!-- 顶部固定栏 -->
  <view class="page-header">
    <view class="page-header__bg"></view>
    <view class="page-header__content">
      <view class="page-header__back" bindtap="onBackTap">
        <text class="page-header__back-text">{{lt}}</text>
      </view>
      <text class="page-header__title">{{subcategoryName}}</text>
    </view>
  </view>

  <!-- 搜索框 -->
  <view class="search-bar" bindtap="onSearchTap">
    <view class="search-bar__bg"></view>
    <view class="search-bar__inner">
      <text class="search-bar__icon">🔍</text>
      <text class="search-bar__text">搜索{{subcategoryName}}文章...</text>
    </view>
  </view>

  <!-- 文章列表 -->
  <view class="article-section">
    <view class="section__head">
      <view class="section__title-wrap">
        <text class="section__icon">📄</text>
        <text class="section__title">文章列表</text>
      </view>
      <view class="section__count">
        <text>{{totalCount}}篇文章</text>
      </view>
    </view>
    
    <!-- 加载状态 -->
    <view class="loading-card" wx:if="{{loading && page === 0}}">
      <skeleton type="list" rows="5"></skeleton>
    </view>
    
    <!-- 文章列表 -->
    <view class="article-list" wx:if="{{!loading || page > 0}}">
      <view class="article-item" wx:for="{{articles}}" wx:key="_id" data-id="{{item._id}}" bindtap="onArticleTap" hover-class="article-item--hover" hover-stay-time="80">
        <view class="article-item__icon">
          <text>{{item.icon || '📄'}}</text>
        </view>
        <view class="article-item__body">
          <text class="article-item__title">{{item.title}}</text>
          <view class="article-item__meta">
            <view class="article-item__tag" wx:if="{{item.difficulty}}">
              <text class="article-item__tag-text">{{item.difficulty}}</text>
            </view>
            <text class="article-item__read-time" wx:if="{{item.readTime}}">{{item.readTime}}分钟</text>
            <text class="article-item__read-count" wx:if="{{item.readCount}}">{{item.readCount}}人阅读</text>
          </view>
        </view>
        <text class="article-item__arrow">›</text>
      </view>
    </view>
    
    <!-- 加载更多 -->
    <view class="load-more" wx:if="{{loading && page > 0}}">
      <view class="load-more__spinner"></view>
      <text class="load-more__text">加载中...</text>
    </view>
    
    <!-- 没有更多 -->
    <view class="no-more" wx:if="{{!hasMore && articles.length > 0}}">
      <text class="no-more__text">没有更多文章了</text>
    </view>
    
    <!-- 空状态 -->
    <empty-state wx:if="{{!loading && articles.length === 0}}" icon="📭" title="暂无文章" text="该分类下还没有文章，敬请期待"></empty-state>
  </view>

  <!-- 底部 -->
  <view class="footer" wx:if="{{articles.length > 0}}">
    <text class="footer__icon">📚</text>
    <text class="footer__main">持续学习，持续进步</text>
    <text class="footer__sub">每篇文章都是知识的积累</text>
  </view>
</view>