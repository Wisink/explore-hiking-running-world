/* pages/running-article-list/running-article-list.wxss - 蓝色系跑步主题 */

/* 状态栏占位 — 毛玻璃 */
.page-statusbar {
  background: linear-gradient(135deg,
    rgba(21, 101, 192, 0.5) 0%,
    rgba(66, 165, 245, 0.4) 100%
  );
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
}

/* ===== CSS Variables ===== */
:host {
  --glass-bg: rgba(255, 255, 255, 0.22);
  --glass-bg-light: rgba(255, 255, 255, 0.12);
  --glass-bg-strong: rgba(255, 255, 255, 0.35);
  --glass-border: rgba(255, 255, 255, 0.25);
  --glass-blur: blur(16px);
  --glass-shadow: 0 8rpx 32rpx rgba(31, 38, 50, 0.18);
  --text: #0d47a1;
  --text2: #1565c0;
  --primary: #1565c0;
  --primary-dark: #0d47a1;
  --r: 36rpx;
  --tr: all 350ms cubic-bezier(0.4, 0, 0.2, 1);
}

.running-article-list {
  min-height: 100vh;
  padding-bottom: calc(140rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  background-color: #bbdefb;
  background:
    radial-gradient(ellipse at 20% 50%, rgba(21,101,192,.6) 0%, transparent 50%),
    radial-gradient(ellipse at 80% 20%, rgba(66,165,245,.5) 0%, transparent 50%),
    radial-gradient(ellipse at 60% 80%, rgba(100,181,246,.4) 0%, transparent 50%),
    radial-gradient(ellipse at 10% 90%, rgba(187,222,251,.6) 0%, transparent 40%),
    linear-gradient(160deg, #e3f2fd 0%, #bbdefb 25%, #90caf9 50%, #64b5f6 75%, #42a5f5 100%);
}

/* 顶部固定栏 — 毛玻璃 */
.page-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  padding: 0 32rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
}

.page-header__bg {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(135deg, rgba(21,101,192,.5) 0%, rgba(66,165,245,.4) 100%);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-bottom: 1px solid rgba(255,255,255,.25);
}

.page-header__content {
  position: relative;
  display: flex;
  align-items: center;
  width: 100%;
  gap: 20rpx;
}

.page-header__back {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border: 1px solid rgba(255,255,255,.2);
}

.page-header__back-text {
  font-size: 36rpx;
  color: #0d47a1;
  font-weight: 300;
}

.page-header__title {
  font-size: 36rpx;
  font-weight: 700;
  color: #0d47a1;
  letter-spacing: 1rpx;
  text-shadow: 0 1rpx 6rpx rgba(255,255,255,.5);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 搜索框 — 毛玻璃 */
.search-bar {
  position: relative;
  margin: 120rpx 24rpx 36rpx;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(31,38,50,.12);
}

.search-bar__bg {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(255, 255, 255, 0.22);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(255,255,255,.25);
  border-radius: 24rpx;
}

.search-bar__inner {
  position: relative;
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  gap: 16rpx;
}

.search-bar__icon {
  font-size: 36rpx;
}

.search-bar__text {
  font-size: 28rpx;
  color: #1565c0;
  opacity: 0.7;
}

/* 文章区域 */
.article-section {
  margin: 0 24rpx 36rpx;
}

.section__head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 0 8rpx;
}

.section__title-wrap {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.section__icon { font-size: 32rpx; }

.section__title {
  font-size: 34rpx;
  font-weight: 700;
  color: #0d47a1;
}

.section__count {
  background: rgba(21, 101, 192, 0.2);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  color: #0d47a1;
  font-weight: 500;
  border: 1px solid rgba(21,101,192,.15);
}

/* 加载状态 */
.loading-card {
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(255,255,255,.2);
  border-radius: 24rpx;
  padding: 40rpx 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(31,38,50,.12);
}

/* 文章列表 — 毛玻璃 */
.article-list {
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border: 1px solid rgba(255,255,255,.2);
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(31,38,50,.1);
  overflow: hidden;
}

.article-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1px solid rgba(255,255,255,.12);
  transition: background 150ms ease;
}

.article-item:last-child { border-bottom: none; }

.article-item--hover {
  background: rgba(255,255,255,.1);
}

.article-item__icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
  font-size: 36rpx;
  background: rgba(21, 101, 192, 0.1);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border: 1px solid rgba(255,255,255,.2);
}

.article-item__body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.article-item__title {
  font-size: 30rpx;
  font-weight: 600;
  color: #0d47a1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.article-item__meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.article-item__tag {
  background: rgba(21, 101, 192, 0.15);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  border: 1px solid rgba(21,101,192,.1);
}

.article-item__tag-text {
  font-size: 20rpx;
  color: #0d47a1;
  font-weight: 500;
}

.article-item__read-time,
.article-item__read-count {
  font-size: 22rpx;
  color: #1565c0;
}

.article-item__arrow {
  font-size: 36rpx;
  color: #1565c0;
  font-weight: 300;
  margin-left: 12rpx;
  flex-shrink: 0;
}

/* 加载更多 */
.load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 0;
  gap: 12rpx;
}

.load-more__spinner {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid rgba(21,101,192,.2);
  border-top-color: #1565c0;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin { to { transform: rotate(360deg); } }

.load-more__text {
  font-size: 24rpx;
  color: #1565c0;
}

/* 没有更多 */
.no-more {
  text-align: center;
  padding: 32rpx 0;
}

.no-more__text {
  font-size: 24rpx;
  color: #1565c0;
  opacity: 0.7;
}

/* 底部 */
.footer {
  text-align: center;
  padding: 48rpx 24rpx 32rpx;
}

.footer__icon { font-size: 48rpx; margin-bottom: 12rpx; display: block; }

.footer__main {
  font-size: 28rpx;
  color: #0d47a1;
  font-weight: 600;
  display: block;
  margin-bottom: 8rpx;
}

.footer__sub { font-size: 22rpx; color: #1565c0; }