/* pages/running-search/running-search.wxss - 蓝色系跑步主题 */

/* ===== CSS Variables ===== */
:host {
  --glass-bg: rgba(255, 255, 255, 0.22);
  --glass-bg-light: rgba(255, 255, 255, 0.12);
  --glass-bg-strong: rgba(255, 255, 255, 0.35);
  --glass-border: rgba(255, 255, 255, 0.25);
  --glass-blur: blur(16px);
  --glass-shadow: 0 8rpx 32rpx rgba(31, 38, 50, 0.18);
  --text: #0d47a1;
  --text2: #1565c0;
  --primary: #1565c0;
  --primary-dark: #0d47a1;
}

/* 页面容器 - 蓝色渐变背景 */
.search-page {
  min-height: 100vh;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  background-color: #bbdefb;
  background:
    radial-gradient(ellipse at 20% 50%, rgba(21,101,192,.6) 0%, transparent 50%),
    radial-gradient(ellipse at 80% 20%, rgba(66,165,245,.5) 0%, transparent 50%),
    radial-gradient(ellipse at 60% 80%, rgba(100,181,246,.4) 0%, transparent 50%),
    radial-gradient(ellipse at 10% 90%, rgba(187,222,251,.6) 0%, transparent 40%),
    linear-gradient(160deg, #e3f2fd 0%, #bbdefb 25%, #90caf9 50%, #64b5f6 75%, #42a5f5 100%);
}

/* 状态栏占位 — 毛玻璃 */
.page-statusbar {
  background: linear-gradient(135deg,
    rgba(21, 101, 192, 0.5) 0%,
    rgba(66, 165, 245, 0.4) 100%
  );
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
}

/* ===== 固定顶部标题栏 ===== */
.fixed-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  overflow: hidden;
}

.fixed-header__bg {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(135deg, rgba(21,101,192,.5) 0%, rgba(66,165,245,.4) 100%);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-bottom: 1px solid rgba(255,255,255,.25);
}

.fixed-header__content {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 32rpx;
}

.back-btn {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 12rpx 8rpx 12rpx 0;
}

.back-btn__icon {
  font-size: 44rpx;
  color: #0d47a1;
  font-weight: 300;
  line-height: 1;
}

.back-btn__text {
  font-size: 28rpx;
  color: #0d47a1;
}

.header-title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
  color: #0d47a1;
  letter-spacing: 1rpx;
}

.header-spacer {
  width: 80rpx;
}

.fixed-header-spacer {
  /* 占位，防止内容被固定头部遮挡 */
}

/* ===== 搜索栏 ===== */
.search-bar-wrap {
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.search-bar {
  position: relative;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: var(--glass-shadow);
}

.search-bar__bg {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: var(--glass-bg);
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
  border: 1px solid var(--glass-border);
  border-radius: 24rpx;
}

.search-bar__inner {
  position: relative;
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  gap: 12rpx;
}

.search-bar__icon {
  font-size: 32rpx;
}

.search-bar__input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text);
  height: 48rpx;
}

.search-bar__input::placeholder {
  color: rgba(21, 101, 192, 0.6);
}

.search-bar__clear {
  font-size: 28rpx;
  color: var(--text2);
  padding: 8rpx 16rpx;
  opacity: 0.7;
}

.search-bar__btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(21, 101, 192, 0.15);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border: 1px solid rgba(255,255,255,.2);
  border-radius: 20rpx;
  padding: 0 28rpx;
  height: 56rpx;
}

.search-bar__btn text {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--primary-dark);
}

.search-bar__btn:active {
  opacity: 0.85;
}

/* ===== 搜索历史 ===== */
.history-section {
  margin: 0 24rpx 24rpx;
}

.section__head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 0 8rpx;
}

.section__title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
}

.section__clear {
  font-size: 24rpx;
  color: var(--text2);
  opacity: 0.7;
}

.history-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.history-tag {
  padding: 12rpx 24rpx;
  background: var(--glass-bg);
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
  border: 1px solid var(--glass-border);
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(31,38,50,.08);
}

.history-tag text {
  font-size: 24rpx;
  color: var(--text2);
}

.history-tag:active {
  opacity: 0.85;
}

/* ===== 热门搜索 ===== */
.hot-section {
  margin: 0 24rpx 24rpx;
}

.hot-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.hot-tag {
  padding: 12rpx 24rpx;
  background: rgba(21, 101, 192, 0.12);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border: 1px solid rgba(255,255,255,.2);
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(31,38,50,.08);
}

.hot-tag text {
  font-size: 24rpx;
  color: var(--primary-dark);
}

.hot-tag:active {
  background: rgba(21, 101, 192, 0.2);
}

/* ===== 搜索结果 ===== */
.results-section {
  margin: 0 24rpx;
}

.results-count {
  padding: 8rpx 0 16rpx;
}

.results-count text {
  font-size: 24rpx;
  color: var(--text2);
  opacity: 0.8;
}

.results-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* 结果卡片 - 毛玻璃 */
.result-card {
  position: relative;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: var(--glass-shadow);
  transition: transform 150ms ease;
}

.result-card:active {
  transform: scale(0.98);
}

.result-card__bg {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: var(--glass-bg);
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
  border: 1px solid var(--glass-border);
  border-radius: 24rpx;
}

.result-card__inner {
  position: relative;
  padding: 24rpx;
}

.result-card__title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 8rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.result-card__summary {
  display: block;
  font-size: 24rpx;
  color: var(--text2);
  opacity: 0.8;
  margin-bottom: 12rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.result-card__meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.result-card__category {
  font-size: 22rpx;
  color: var(--primary);
  background: rgba(21, 101, 192, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border: 1px solid rgba(255,255,255,.15);
}

.result-card__reads {
  font-size: 22rpx;
  color: var(--text2);
  opacity: 0.7;
}

.result-card__arrow {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 36rpx;
  color: var(--text2);
  font-weight: 300;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 80rpx 24rpx;
}

.empty-state__icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 24rpx;
  opacity: 0.8;
}

.empty-state__text {
  display: block;
  font-size: 30rpx;
  color: var(--text);
  margin-bottom: 12rpx;
}

.empty-state__hint {
  display: block;
  font-size: 24rpx;
  color: var(--text2);
  opacity: 0.7;
}

/* ===== 加载状态 ===== */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0;
  gap: 16rpx;
}

.loading-ring {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid rgba(21, 101, 192, 0.2);
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: var(--text2);
}

/* ===== 底部 ===== */
.page-footer {
  text-align: center;
  padding: 48rpx 24rpx;
  margin-top: 32rpx;
}

.page-footer__icon {
  font-size: 48rpx;
  display: block;
  margin-bottom: 12rpx;
}

.page-footer__text {
  font-size: 26rpx;
  color: var(--text);
  opacity: 0.8;
}
