<!--pages/running-search/running-search.wxml - 蓝色系跑步主题-->
<view class="search-page">

  <!-- 状态栏占位 -->
  <view class="page-statusbar" style="height: {{statusBarHeight}}px;"></view>

  <!-- 固定顶部标题栏 -->
  <view class="fixed-header" style="padding-top: {{statusBarHeight}}px;">
    <view class="fixed-header__bg"></view>
    <view class="fixed-header__content">
      <view class="back-btn" bindtap="onBack">
        <text class="back-btn__icon">‹</text>
        <text class="back-btn__text">返回</text>
      </view>
      <text class="header-title">文章搜索</text>
      <view class="header-spacer"></view>
    </view>
  </view>

  <!-- 固定头部占位 -->
  <view class="fixed-header-spacer" style="height: {{headerHeight}}px;"></view>

  <!-- 搜索栏 -->
  <view class="search-bar-wrap">
    <view class="search-bar">
      <view class="search-bar__bg"></view>
      <view class="search-bar__inner">
        <text class="search-bar__icon">🔍</text>
        <input class="search-bar__input" 
               placeholder="搜索跑步知识..." 
               value="{{keyword}}"
               bindinput="onKeywordInput"
               bindconfirm="onSearch"
               confirm-type="search"
               focus="{{autoFocus}}" />
        <text class="search-bar__clear" wx:if="{{keyword}}" bindtap="onClearInput">✕</text>
        <view class="search-bar__btn" bindtap="onSearch">
          <text>搜索</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 搜索历史 -->
  <view class="history-section" wx:if="{{!searched && history.length > 0}}">
    <view class="section__head">
      <text class="section__title">🕐 搜索历史</text>
      <text class="section__clear" bindtap="onClearHistory">清空</text>
    </view>
    <view class="history-tags">
      <view class="history-tag" wx:for="{{history}}" wx:key="index"
            data-keyword="{{item}}" bindtap="onHistoryTap">
        <text>{{item}}</text>
      </view>
    </view>
  </view>

  <!-- 热门搜索 -->
  <view class="hot-section" wx:if="{{!searched}}">
    <view class="section__head">
      <text class="section__title">🔥 热门搜索</text>
    </view>
    <view class="hot-tags">
      <view class="hot-tag" wx:for="{{hotKeywords}}" wx:key="index"
            data-keyword="{{item}}" bindtap="onHotTagTap">
        <text>{{item}}</text>
      </view>
    </view>
  </view>

  <!-- 搜索结果 -->
  <view class="results-section" wx:if="{{searched}}">
    <view class="results-count" wx:if="{{results.length > 0}}">
      <text>找到 {{results.length}} 篇相关文章</text>
    </view>
    
    <view class="results-list">
      <view class="result-card" wx:for="{{results}}" wx:key="_id" 
            data-id="{{item._id}}" bindtap="onArticleTap">
        <view class="result-card__bg"></view>
        <view class="result-card__inner">
          <text class="result-card__title">{{item.title}}</text>
          <text class="result-card__summary">{{item.summary || '暂无简介'}}</text>
          <view class="result-card__meta">
            <text class="result-card__category">{{item.categoryName || '未分类'}}</text>
            <text class="result-card__reads">👁 {{item.readCount || 0}}</text>
          </view>
        </view>
        <text class="result-card__arrow">›</text>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{results.length === 0 && !loading}}">
      <text class="empty-state__icon">🔍</text>
      <text class="empty-state__text">未找到相关文章</text>
      <text class="empty-state__hint">换个关键词试试吧</text>
    </view>
  </view>

  <!-- 加载状态 -->
  <view class="loading-wrap" wx:if="{{loading}}">
    <view class="loading-ring"></view>
    <text class="loading-text">搜索中...</text>
  </view>

  <!-- 底部 -->
  <view class="page-footer" wx:if="{{!searched}}">
    <text class="page-footer__icon">🏃‍♂️</text>
    <text class="page-footer__text">科学跑步，从学习开始</text>
  </view>
</view>
