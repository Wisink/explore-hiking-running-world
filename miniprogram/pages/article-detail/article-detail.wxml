<!--pages/article-detail/article-detail.wxml-->
<view class="detail-page">
  <!-- 加载状态 -->
  <view class="loading-card" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">正在加载文章...</text>
  </view>

  <block wx:if="{{!loading && article}}">
    <!-- 文章头部 -->
    <view class="article-header">
      <!-- 分类标签 + 时间 -->
      <view class="article-meta">
        <view class="category-tag">
          <text class="category-icon">{{article.categoryIcon}}</text>
          <text class="category-text">{{article.category}}</text>
        </view>
        <text class="article-date">{{article.formattedDate}}</text>
      </view>

      <!-- 文章标题 -->
      <text class="article-title">{{article.title}}</text>

      <!-- 摘要 -->
      <text class="article-summary">{{article.summary}}</text>
    </view>

    <!-- 正文内容 -->
    <view class="article-content">
      <rich-text nodes="{{article.content}}"></rich-text>
    </view>

    <!-- 分割线 -->
    <view class="divider-line"></view>

    <!-- 相关推荐 -->
    <view class="related-section" wx:if="{{relatedArticles.length > 0}}">
      <view class="related-header">
        <text class="related-icon">📎</text>
        <text class="related-title">相关推荐</text>
      </view>

      <view class="related-list">
        <view
          class="related-item"
          wx:for="{{relatedArticles}}"
          wx:key="_id"
          data-id="{{item._id}}"
          bindtap="onRelatedTap"
        >
          <view class="related-info">
            <text class="related-name">{{item.title}}</text>
            <text class="related-desc">{{item.summary}}</text>
          </view>
          <view class="related-arrow">
            <text class="arrow-icon">›</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 底部 -->
    <view class="footer">
      <text class="footer-icon">🌿</text>
      <text class="footer-main">安全徒步，快乐出行</text>
    </view>
  </block>
</view>
