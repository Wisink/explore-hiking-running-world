<!--pages/article-detail/article-detail.wxml-->
<view class="detail-page">
  <!-- 加载 -->
  <view class="loading-wrap" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">正在加载文章...</text>
  </view>

  <block wx:if="{{!loading && article}}">
    <!-- 文章头部 -->
    <view class="article-header">
      <view class="article-header__meta">
        <view class="article-header__tag">
          <text class="article-header__tag-icon">{{article.categoryIcon}}</text>
          <text class="article-header__tag-text">{{article.category}}</text>
        </view>
        <view class="article-header__right">
          <text class="article-header__views">👁 {{article.viewCount}} 次阅读</text>
          <text class="article-header__date">{{article.formattedDate}}</text>
        </view>
      </view>

      <text class="article-header__title">{{article.title}}</text>
      <text class="article-header__summary">{{article.summary}}</text>
    </view>

    <!-- 正文 -->
    <view class="article-body">
      <rich-text nodes="{{article.content}}"></rich-text>
    </view>

    <!-- 相关推荐 -->
    <view class="related" wx:if="{{relatedArticles.length > 0}}">
      <view class="related__head">
        <text class="related__icon">📎</text>
        <text class="related__title">相关推荐</text>
      </view>

      <view class="related__list">
        <view
          class="related__item"
          wx:for="{{relatedArticles}}"
          wx:key="_id"
          data-id="{{item._id}}"
          bindtap="onRelatedTap"
          hover-class="related__item--hover"
          hover-stay-time="80"
        >
          <view class="related__info">
            <text class="related__name">{{item.title}}</text>
            <text class="related__desc">{{item.summary}}</text>
          </view>
          <text class="related__arrow">›</text>
        </view>
      </view>
    </view>

    <!-- 底部 -->
    <view class="footer">
      <text class="footer__icon">🌿</text>
      <text class="footer__text">安全徒步，快乐出行</text>
    </view>
  </block>
  <view class="nice-toast nice-toast--{{toastType}} {{showToast ? 'nice-toast--show' : ''}}">{{toastMessage}}</view>
</view>
