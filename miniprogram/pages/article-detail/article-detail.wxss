/* pages/article-detail/article-detail.wxss */

.detail-page {
  background: #F8F6F0;
  min-height: 100vh;
  padding-bottom: 80rpx;
}

/* ===== 文章头部 ===== */
.article-header {
  background: #FFFFFF;
  padding: 40rpx 32rpx 36rpx;
  margin-bottom: 16rpx;
}

.article-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.category-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(45, 90, 39, 0.08);
  padding: 8rpx 18rpx;
  border-radius: 20rpx;
}

.category-icon {
  font-size: 24rpx;
}

.category-text {
  font-size: 22rpx;
  color: #2D5A27;
  font-weight: 500;
}

.article-date {
  font-size: 22rpx;
  color: #AAAAAA;
}

.article-title {
  font-size: 42rpx;
  font-weight: 800;
  color: #1A1A1A;
  line-height: 1.4;
  display: block;
  margin-bottom: 16rpx;
  letter-spacing: 0.5rpx;
}

.article-summary {
  font-size: 28rpx;
  color: #888888;
  line-height: 1.6;
  display: block;
}

/* ===== 正文内容 ===== */
.article-content {
  background: #FFFFFF;
  padding: 36rpx 32rpx;
  margin-bottom: 16rpx;
}

.article-body {
  font-size: 30rpx;
  color: #333333;
  line-height: 1.9;
}

.article-body h2 {
  font-size: 36rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin: 48rpx 0 20rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid #2D5A27;
}

.article-body h2:first-child {
  margin-top: 0;
}

.article-body p {
  margin: 16rpx 0;
  text-align: justify;
}

.article-body strong {
  color: #2D5A27;
  font-weight: 600;
}

.article-body img {
  width: 100%;
  border-radius: 12rpx;
  margin: 24rpx 0;
}

.article-body ul,
.article-body ol {
  padding-left: 32rpx;
  margin: 16rpx 0;
}

.article-body li {
  margin: 8rpx 0;
}

/* ===== 分割线 ===== */
.divider-line {
  height: 16rpx;
  background: #F8F6F0;
}

/* ===== 相关推荐 ===== */
.related-section {
  background: #FFFFFF;
  padding: 32rpx;
}

.related-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 24rpx;
}

.related-icon {
  font-size: 28rpx;
}

.related-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.related-list {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.related-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
  transition: background 0.2s;
}

.related-item:last-child {
  border-bottom: none;
}

.related-item:active {
  background: #FAFAFA;
}

.related-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.related-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.related-desc {
  font-size: 24rpx;
  color: #999999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.related-arrow {
  flex-shrink: 0;
  margin-left: 12rpx;
}

.arrow-icon {
  font-size: 36rpx;
  color: #CCCCCC;
  font-weight: 300;
}

/* ===== 加载状态 ===== */
.loading-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 120rpx 60rpx;
  margin: 40rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #E0E0E0;
  border-top-color: #2D5A27;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: #999999;
}

/* ===== 底部 ===== */
.footer {
  text-align: center;
  padding: 48rpx 24rpx 32rpx;
}

.footer-icon {
  font-size: 40rpx;
  margin-bottom: 12rpx;
  display: block;
}

.footer-main {
  font-size: 24rpx;
  color: #BBBBBB;
}
