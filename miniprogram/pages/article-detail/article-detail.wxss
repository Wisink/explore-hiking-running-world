/* pages/article-detail/article-detail.wxss - v2.0 */

.detail-page {
  background: #FAFAF5;
  min-height: 100vh;
  padding-bottom: 80rpx;
}

/* 加载 */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 60vh;
  gap: 24rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #E0E0DB;
  border-top-color: #2E7D32;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin { to { transform: rotate(360deg); } }

.loading-text {
  font-size: 28rpx;
  color: #9E9E99;
}

/* 文章头部 */
.article-header {
  background: #FFFFFF;
  padding: 40rpx 32rpx 36rpx;
  margin-bottom: 16rpx;
}

.article-header__meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.article-header__tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(46, 125, 50, 0.08);
  padding: 8rpx 18rpx;
  border-radius: 20rpx;
}

.article-header__tag-icon { font-size: 24rpx; }

.article-header__tag-text {
  font-size: 22rpx;
  color: #2E7D32;
  font-weight: 500;
}

.article-header__date {
  font-size: 22rpx;
  color: #C0C0BB;
}

.article-header__title {
  font-size: 42rpx;
  font-weight: 800;
  color: #1A1A1A;
  line-height: 1.4;
  display: block;
  margin-bottom: 16rpx;
  letter-spacing: 0.5rpx;
}

.article-header__summary {
  font-size: 28rpx;
  color: #9E9E99;
  line-height: 1.6;
  display: block;
}

/* 正文 */
.article-body {
  background: #FFFFFF;
  padding: 36rpx 32rpx;
  margin-bottom: 16rpx;
  font-size: 30rpx;
  color: #303028;
  line-height: 1.9;
}

/* 相关推荐 */
.related {
  background: #FFFFFF;
  padding: 32rpx;
}

.related__head {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 24rpx;
}

.related__icon { font-size: 28rpx; }

.related__title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.related__list {
  margin-top: 16rpx;
}

.related__item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F0F0EB;
  transition: background 150ms ease;
}

.related__item:last-child { border-bottom: none; }

.related__item--hover {
  background: #FAFAF5;
}

.related__info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.related__name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.related__desc {
  font-size: 24rpx;
  color: #9E9E99;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.related__arrow {
  font-size: 36rpx;
  color: #C0C0BB;
  font-weight: 300;
  margin-left: 12rpx;
  flex-shrink: 0;
}

/* 底部 */
.footer {
  text-align: center;
  padding: 48rpx 24rpx 32rpx;
}

.footer__icon {
  font-size: 40rpx;
  margin-bottom: 12rpx;
  display: block;
}

.footer__text {
  font-size: 24rpx;
  color: #C0C0BB;
}
