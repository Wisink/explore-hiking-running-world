/* pages/search/search.wxss */

.search-page {
  min-height: 100vh;
  background-color: #F8F6F0;
  padding-bottom: 40rpx;
}

/* ========== 顶部搜索框 ========== */
.search-header {
  padding: 20rpx 24rpx;
  background-color: #fff;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.search-box {
  display: flex;
  align-items: center;
  background-color: #F8F6F0;
  border-radius: 40rpx;
  padding: 0 12rpx 0 28rpx;
  height: 72rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  height: 72rpx;
}

.search-btn {
  background-color: #2D5A27;
  border-radius: 32rpx;
  padding: 0 32rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.search-btn-text {
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
}

/* ========== 筛选条件区域 ========== */
.filter-section {
  margin: 16rpx 24rpx;
  background-color: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
  overflow: hidden;
}

.filter-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
}

.filter-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
}

.filter-arrow {
  font-size: 24rpx;
  color: #6B7B8D;
  transition: transform 0.3s ease;
}

.filter-arrow.expanded {
  transform: rotate(180deg);
}

.filter-body {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.35s ease;
  padding: 0 28rpx;
}

.filter-body.show {
  max-height: 2000rpx;
  padding: 0 28rpx 28rpx;
}

.filter-group {
  margin-bottom: 24rpx;
}

.filter-label {
  font-size: 24rpx;
  color: #6B7B8D;
  margin-bottom: 12rpx;
  display: block;
}

.filter-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.filter-tag {
  padding: 10rpx 24rpx;
  border-radius: 32rpx;
  font-size: 24rpx;
  color: #6B7B8D;
  background-color: #F8F6F0;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.filter-tag.active {
  background-color: #E8F5E3;
  color: #2D5A27;
  border-color: #2D5A27;
}

.filter-reset {
  display: flex;
  justify-content: center;
  margin-top: 8rpx;
}

.filter-reset .reset-text {
  font-size: 26rpx;
  color: #FF8C42;
  padding: 12rpx 40rpx;
  border: 2rpx solid #FF8C42;
  border-radius: 32rpx;
}

/* ========== 搜索结果头部 ========== */
.result-header {
  padding: 20rpx 24rpx 0;
}

.result-count {
  font-size: 24rpx;
  color: #6B7B8D;
}

/* ========== Loading ========== */
.loading-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #E8E8E8;
  border-top-color: #2D5A27;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 26rpx;
  color: #6B7B8D;
  margin-top: 20rpx;
}

/* ========== 路线卡片列表 ========== */
.route-list {
  padding: 16rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.route-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.route-card:active {
  transform: scale(0.98);
  box-shadow: 0 1rpx 6rpx rgba(0, 0, 0, 0.08);
}

/* 卡片头部：名称 + 评分 */
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.route-name {
  font-size: 34rpx;
  color: #333;
  font-weight: 600;
  flex: 1;
  margin-right: 16rpx;
  /* 超长名称换行 */
  word-break: break-all;
}

.route-score {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.score-value {
  font-size: 30rpx;
  color: #FF8C42;
  font-weight: 700;
  margin-right: 4rpx;
}

.score-star {
  font-size: 24rpx;
}

/* 标签行 */
.card-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.tag-difficulty {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  color: #fff;
}

.tag-difficulty.easy {
  background-color: #4CAF50;
}

.tag-difficulty.medium {
  background-color: #FF8C42;
}

.tag-family {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  background-color: #E3F2FD;
  color: #1976D2;
}

.tag-scenic {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  background-color: #F8F6F0;
  color: #6B7B8D;
  border: 1rpx solid #E8E8E8;
}

/* 位置和距离 */
.card-info {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.info-location {
  font-size: 24rpx;
  color: #6B7B8D;
}

.info-distance {
  font-size: 24rpx;
  color: #6B7B8D;
}

/* 点赞数 */
.card-footer {
  display: flex;
  justify-content: flex-end;
}

.likes {
  font-size: 22rpx;
  color: #999;
}

/* ========== 空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 40rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 34rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #6B7B8D;
  margin-bottom: 40rpx;
}

.empty-reset {
  padding: 16rpx 48rpx;
  border: 2rpx solid #2D5A27;
  border-radius: 32rpx;
}

.empty-reset .reset-text {
  font-size: 28rpx;
  color: #2D5A27;
}

/* 底部提示 */
.footer-tips {
  padding: 40rpx 32rpx;
  text-align: center;
}

.tips-text {
  font-size: 24rpx;
  color: #999999;
}
