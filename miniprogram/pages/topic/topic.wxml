<view class="container">
  <!-- 固定顶部：状态栏+返回按钮 -->
  <view class="topic-fixed-bar" style="background-color: {{themeColor}}; padding-top: {{statusBarHeight}}px;">
    <view class="topic-fixed-bar__nav">
      <view class="topic-back" bindtap="onBackTap">
        <text class="topic-back__icon">{{lt}}</text>
        <text class="topic-back__text">返回</text>
      </view>
    </view>
  </view>
  <view style="height: {{headerHeight}}px;"></view>

  <!-- 专题头图（随页面滚动） -->
  <view class="header" style="background-color: {{themeColor}};">
    <view class="header-content">
      <text class="header-icon">{{icon}}</text>
      <text class="header-title">{{category}}</text>
      <text class="header-subtitle">{{subtitle}}</text>
    </view>
  </view>

  <!-- 子分类Tab -->
  <scroll-view scroll-x class="subcategory-tabs" wx:if="{{tabs.length > 1}}">
    <view class="tab {{activeTab === item.value ? 'tab--active' : ''}}"
          wx:for="{{tabs}}" wx:key="value"
          bindtap="onTabChange" data-value="{{item.value}}">
      {{item.label}}
    </view>
  </scroll-view>

  <!-- 文章列表 -->
  <view class="article-list">
    <view
      class="article-card"
      wx:for="{{filteredArticles}}"
      wx:key="_id"
      bindtap="onArticleTap"
      data-id="{{item._id}}"
    >
      <view class="card-index" style="background-color: {{themeColor}};">
        <text class="index-text">{{index + 1}}</text>
      </view>
      <view class="card-body">
        <text class="card-title">{{item.title}}</text>
        <text class="card-summary">{{item.summary}}</text>
        <view class="card-badges" wx:if="{{item.difficulty}}">
          <text class="card-badge card-badge--{{item.difficulty}}">
            {{item.difficulty === 'beginner' ? '🟢入门' : item.difficulty === 'intermediate' ? '🟡进阶' : '🔴资深'}}
          </text>
          <text class="card-badge card-badge--sub" wx:if="{{item.subcategory}}">{{item.subcategory}}</text>
        </view>
      </view>
      <view class="card-arrow">›</view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{!loading && filteredArticles.length === 0}}">
      <text class="empty-icon">📭</text>
      <text class="empty-text">暂无该分类的文章</text>
    </view>

    <!-- 加载中 -->
    <view class="loading" wx:if="{{loading}}">
      <view class="loading-spinner"></view>
      <text class="loading-text">加载中...</text>
    </view>

    <!-- 没有更多 -->
    <view class="no-more" wx:if="{{!hasMore && filteredArticles.length > 0}}">
      <text class="no-more-text">— 已加载全部文章 —</text>
    </view>

    <!-- 底部返回按钮 -->
    <view class="bottom-back" wx:if="{{filteredArticles.length > 0}}">
      <button class="back-btn-bottom" bindtap="onBackTap">
        <text class="back-btn-icon">{{lt}}</text>
        <text class="back-btn-text">返回上一页</text>
      </button>
    </view>
  </view>
</view>
