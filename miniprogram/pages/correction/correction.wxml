<!--pages/correction/correction.wxml-->
<view class="correction-page">

  <!-- 关联路线信息（只读） -->
  <view class="route-info">
    <view class="section-title">
      <text class="section-icon">📍</text>
      <text class="section-text">关联路线</text>
    </view>
    <view class="route-card">
      <view class="route-row">
        <text class="route-label">路线名称</text>
        <text class="route-value">{{routeName || '加载中...'}}</text>
      </view>
      <view class="route-row">
        <text class="route-label">路线位置</text>
        <text class="route-value">{{routeLocation || '加载中...'}}</text>
      </view>
    </view>
  </view>

  <!-- 纠错类型选择（可选） -->
  <view class="form-section">
    <view class="section-title">
      <text class="section-icon">📋</text>
      <text class="section-text">纠错类型</text>
      <text class="optional">（可选）</text>
    </view>
    <view class="type-grid">
      <view
        class="type-item {{selectedTypes.indexOf(item) > -1 ? 'type-item-active' : ''}}"
        wx:for="{{correctionTypes}}"
        wx:key="*this"
        data-type="{{item}}"
        data-index="{{index}}"
        bindtap="onTypeSelect"
      >
        <view class="type-checkbox">
          <text class="checkbox-icon">{{selectedTypes.indexOf(item) > -1 ? '☑' : '☐'}}</text>
        </view>
        <text class="type-text">{{item}}</text>
      </view>
    </view>
  </view>

  <!-- 错误描述（必填） -->
  <view class="form-section">
    <view class="section-title">
      <text class="section-icon">✏️</text>
      <text class="section-text">错误描述</text>
      <text class="required">*</text>
    </view>
    <view class="textarea-wrap">
      <textarea
        class="form-textarea"
        placeholder="请描述哪里有错误，以及正确的信息应该是什么..."
        placeholder-class="placeholder-style"
        value="{{errorDesc}}"
        bindinput="onErrorDescInput"
        maxlength="500"
        auto-height
      />
      <text class="char-count">{{errorDesc.length}}/500</text>
    </view>
  </view>

  <!-- 上传截图/照片 -->
  <view class="form-section">
    <view class="section-title">
      <text class="section-icon">📷</text>
      <text class="section-text">上传截图/照片</text>
      <text class="optional">（选填，最多3张）</text>
    </view>
    <view class="image-list">
      <!-- 已上传图片 -->
      <view class="image-item" wx:for="{{imageList}}" wx:key="*this">
        <image class="image-preview" src="{{item}}" mode="aspectFill" data-src="{{item}}" bindtap="onPreviewImage" />
        <view class="image-remove" data-index="{{index}}" catchtap="onRemoveImage">
          <text class="remove-icon">✕</text>
        </view>
      </view>
      <!-- 上传按钮 -->
      <view class="image-add" wx:if="{{imageList.length < 3}}" bindtap="onChooseImage">
        <text class="add-icon">+</text>
        <text class="add-text">添加</text>
      </view>
    </view>
  </view>

  <!-- 提交按钮 -->
  <view class="submit-section">
    <button class="submit-btn {{canSubmit ? '' : 'submit-btn-disabled'}}" bindtap="onSubmit">
      提交纠错
    </button>
  </view>

  <!-- 底部提示 -->
  <view class="footer-tips">
    <text class="tips-icon">ℹ️</text>
    <text class="tips-text">提交后将由管理员审核，请耐心等待</text>
  </view>

  <!-- 登录弹窗 -->
  <login-popup show="{{showLoginPopup}}" desc="登录后可以提交纠错" bind:close="onLoginClose" bind:success="onLoginSuccess"></login-popup>

</view>
