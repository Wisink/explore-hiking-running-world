/* pages/correction/correction.wxss */

.correction-page {
  min-height: 100vh;
  background-color: #F8F6F0;
  padding-bottom: 60rpx;
}

/* ===== 通用样式 ===== */
.section-title {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.section-icon {
  font-size: 30rpx;
  margin-right: 10rpx;
}

.section-text {
  font-size: 30rpx;
  font-weight: 500;
  color: #333333;
}

.required {
  color: #FF4D4F;
  font-size: 28rpx;
  margin-left: 8rpx;
}

.optional {
  font-size: 24rpx;
  color: #6B7B8D;
  margin-left: 8rpx;
}

/* ===== 关联路线信息 ===== */
.route-info {
  padding: 30rpx;
}

.route-card {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
  border-left: 6rpx solid #2D5A27;
}

.route-row {
  display: flex;
  align-items: flex-start;
  padding: 12rpx 0;
}

.route-row:first-child {
  padding-top: 0;
}

.route-row:last-child {
  padding-bottom: 0;
}

.route-label {
  font-size: 26rpx;
  color: #6B7B8D;
  width: 140rpx;
  flex-shrink: 0;
}

.route-value {
  font-size: 28rpx;
  color: #333333;
  flex: 1;
  line-height: 1.5;
}

/* ===== 表单区块 ===== */
.form-section {
  padding: 20rpx 30rpx;
}

/* 纠错类型网格 */
.type-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.type-item {
  background-color: #FFFFFF;
  border-radius: 12rpx;
  padding: 16rpx 28rpx;
  border: 2rpx solid #E0E0E0;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.type-item-active {
  background-color: rgba(45, 90, 39, 0.08);
  border-color: #2D5A27;
}

.type-checkbox {
  font-size: 28rpx;
  color: #999;
}

.type-item-active .type-checkbox {
  color: #2D5A27;
}

.type-text {
  font-size: 26rpx;
  color: #333333;
}

.type-item-active .type-text {
  color: #2D5A27;
  font-weight: 500;
}

/* ===== 输入框 ===== */
.textarea-wrap {
  background-color: #FFFFFF;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  border: 2rpx solid #E8E8E8;
  position: relative;
}

.form-textarea {
  width: 100%;
  min-height: 140rpx;
  font-size: 28rpx;
  color: #333333;
  line-height: 1.6;
  box-sizing: border-box;
}

.placeholder-style {
  color: #BBBBBB;
  font-size: 28rpx;
}

.char-count {
  display: block;
  text-align: right;
  font-size: 22rpx;
  color: #BBBBBB;
  margin-top: 8rpx;
}

/* ===== 图片上传 ===== */
.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.image-preview {
  width: 100%;
  height: 100%;
}

.image-remove {
  position: absolute;
  top: 0;
  right: 0;
  width: 44rpx;
  height: 44rpx;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 0 0 0 12rpx;
}

.remove-icon {
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: bold;
}

.image-add {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  background-color: #FFFFFF;
  border: 2rpx dashed #CCCCCC;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.add-icon {
  font-size: 56rpx;
  color: #CCCCCC;
  line-height: 1;
}

.add-text {
  font-size: 24rpx;
  color: #999999;
  margin-top: 8rpx;
}

/* ===== 提交按钮 ===== */
.submit-section {
  padding: 40rpx 30rpx 20rpx;
}

.submit-btn {
  width: 100%;
  height: 90rpx;
  line-height: 90rpx;
  background-color: #2D5A27;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 16rpx;
  border: none;
  box-shadow: 0 4rpx 16rpx rgba(45, 90, 39, 0.3);
}

.submit-btn::after {
  border: none;
}

.submit-btn-disabled {
  background-color: #A8C0A4;
  box-shadow: none;
}

/* ===== 底部提示 ===== */
.footer-tips {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 30rpx;
}

.tips-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
}

.tips-text {
  font-size: 24rpx;
  color: #6B7B8D;
}
