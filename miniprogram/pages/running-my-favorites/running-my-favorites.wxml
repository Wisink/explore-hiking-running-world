<!--pages/running-my-favorites/running-my-favorites.wxml-->
<view class="container" style="padding-top: {{statusBarHeight}}px">
  <!-- 顶部栏 -->
  <view class="header">
    <view class="back-btn" bindtap="onBack">{{lt}}</view>
    <text class="header-title">我的收藏</text>
  </view>

  <!-- 收藏列表 -->
  <scroll-view scroll-y class="list-area">
    <block wx:if="{{loading}}">
      <view class="loading-text">加载中...</view>
    </block>
    <block wx:elif="{{favorites.length === 0}}">
      <view class="empty-tip">还没有收藏的文章</view>
    </block>
    <block wx:else>
      <view class="article-item" wx:for="{{favorites}}" wx:key="_id" bindtap="onArticleTap" data-id="{{item.articleId}}">
        <view class="article-title">{{item.title}}</view>
        <view class="article-meta">
          <text>{{item.difficulty}}</text>
          <text>{{item.readTime}}分钟阅读</text>
        </view>
      </view>
    </block>
  </scroll-view>
</view>
