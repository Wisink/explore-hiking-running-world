<!--pages/profile/profile.wxml-->
<view class="profile-page">
  <!-- 用户信息区域 -->
  <view class="user-section" bindtap="onUserTap">
    <view class="user-info" wx:if="{{isLogin}}">
      <view class="avatar-wrap" wx:if="{{userInfo.avatarUrl}}">
        <image class="avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill"></image>
      </view>
      <view class="avatar-wrap" wx:else>
        <image class="avatar" src="/images/avatar-male.jpg" mode="aspectFill"></image>
      </view>
      <view class="user-detail">
        <text class="nickname">{{userInfo.nickName}}</text>
        <view class="level-badge">
          <text class="level-icon">🏅</text>
          <text class="level-text">Lv.{{userLevel.level}} {{userLevel.name}}</text>
        </view>
      </view>
      <text class="arrow">›</text>
    </view>
    <view class="user-info not-login" wx:else>
      <view class="avatar-wrap">
        <image class="avatar" src="/images/avatar-male.jpg" mode="aspectFill"></image>
      </view>
      <view class="login-tip">
        <text class="login-text">点击登录</text>
        <text class="login-desc">登录后享受更多功能</text>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>

  <!-- 我的数据卡片 -->
  <view class="stats-card">
    <view class="stat-item" bindtap="onStatTap" data-type="favorites">
      <text class="stat-num">{{stats.favorites}}</text>
      <text class="stat-label">收藏</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item" bindtap="onStatTap" data-type="footprints">
      <text class="stat-num">{{stats.footprints}}</text>
      <text class="stat-label">足迹</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item" bindtap="onStatTap" data-type="comments">
      <text class="stat-num">{{stats.comments}}</text>
      <text class="stat-label">评论</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item" bindtap="onStatTap" data-type="ecoActions">
      <text class="stat-num">{{stats.ecoActions}}</text>
      <text class="stat-label">环保</text>
    </view>
  </view>

  <!-- 功能菜单列表 -->
  <view class="menu-section">
    <!-- 我的内容 -->
    <view class="menu-group">
      <view class="menu-item" bindtap="onMenuTap" data-page="favorites">
        <view class="menu-left">
          <text class="menu-icon">⭐</text>
          <text class="menu-name">我的收藏</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="onMenuTap" data-page="footprints">
        <view class="menu-left">
          <text class="menu-icon">👣</text>
          <text class="menu-name">我的足迹</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="onMenuTap" data-page="comments">
        <view class="menu-left">
          <text class="menu-icon">💬</text>
          <text class="menu-name">我的评论</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="onMenuTap" data-page="correction">
        <view class="menu-left">
          <text class="menu-icon">✏️</text>
          <text class="menu-name">我的纠错</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <!-- 我的等级 -->
    <view class="menu-group">
      <view class="menu-item" bindtap="onMenuTap" data-page="level">
        <view class="menu-left">
          <text class="menu-icon">🏅</text>
          <text class="menu-name">我的等级</text>
        </view>
        <view class="menu-right">
          <view class="level-progress" wx:if="{{isLogin}}">
            <view class="progress-bar">
              <view class="progress-fill" style="width: {{userLevel.progress}}%"></view>
            </view>
            <text class="progress-text">{{userLevel.current}}/{{userLevel.target}}</text>
          </view>
          <text class="menu-arrow">›</text>
        </view>
      </view>
    </view>

    <!-- 环保与社交 -->
    <view class="menu-group">
      <view class="menu-item" bindtap="onMenuTap" data-page="eco">
        <view class="menu-left">
          <text class="menu-icon">♻️</text>
          <text class="menu-name">我的环保记录</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="onMenuTap" data-page="messages">
        <view class="menu-left">
          <text class="menu-icon">🔔</text>
          <text class="menu-name">我的消息</text>
          <view class="badge" wx:if="{{unreadCount > 0}}">
            <text class="badge-text">{{unreadCount > 99 ? '99+' : unreadCount}}</text>
          </view>
        </view>
        <text class="menu-arrow">›</text>
      </view>
    </view>

    <!-- 知识与法规 -->
    <view class="menu-group">
      <view class="menu-item" bindtap="onMenuTap" data-page="safety">
        <view class="menu-left">
          <text class="menu-icon">📖</text>
          <text class="menu-name">安全知识</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="onMenuTap" data-page="laws">
        <view class="menu-left">
          <text class="menu-icon">⚖️</text>
          <text class="menu-name">法律法规</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 底部安全出行提示 -->
  <view class="footer-tip">
    <text class="tip-icon">🌿</text>
    <text class="tip-text">安全出行，文明登山，带走垃圾，保护秦岭</text>
  </view>

  <!-- 登录弹窗 -->
  <login-popup show="{{showLoginPopup}}" desc="登录后可使用收藏、点赞、评论等功能" bind:close="onLoginClose" bind:success="onLoginSuccess"></login-popup>
</view>
