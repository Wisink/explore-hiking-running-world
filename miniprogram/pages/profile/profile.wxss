/* pages/profile/profile.wxss */

.profile-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #E8F5E9 0%, #F8F6F0 12%, #F8F6F0 100%);
  padding-bottom: 120rpx;
}

/* ===== 顶部标题 ===== */
.header {
  padding: 40rpx 32rpx 20rpx;
}

.header-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #1A1A1A;
  display: block;
  letter-spacing: 1rpx;
}

.header-subtitle {
  font-size: 26rpx;
  color: #888888;
  margin-top: 8rpx;
  display: block;
}

/* ===== 统计卡片 ===== */
.stats-card {
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: #FFFFFF;
  margin: 16rpx 24rpx 24rpx;
  padding: 32rpx 20rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stat-num {
  font-size: 48rpx;
  font-weight: 800;
  color: #2D5A27;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 26rpx;
  color: #6B7B8D;
  font-weight: 500;
}

.stat-divider {
  width: 1rpx;
  height: 48rpx;
  background-color: #EEEEEE;
}

/* ===== Tab 切换栏 ===== */
.tab-bar {
  display: flex;
  background: #FFFFFF;
  margin: 0 24rpx;
  border-radius: 16rpx 16rpx 0 0;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 0 20rpx;
  position: relative;
  transition: all 0.3s ease;
}

.tab-item.active .tab-text {
  color: #2D5A27;
  font-weight: 700;
}

.tab-text {
  font-size: 28rpx;
  color: #888888;
  font-weight: 500;
  transition: color 0.3s ease;
}

.tab-line {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  background: linear-gradient(90deg, #2D5A27, #43A047);
  border-radius: 3rpx;
  animation: tabLineIn 0.3s ease;
}

@keyframes tabLineIn {
  from {
    width: 0;
    opacity: 0;
  }
  to {
    width: 60rpx;
    opacity: 1;
  }
}

/* ===== 列表区域 ===== */
.list-section {
  margin: 0 24rpx;
  background: #FFFFFF;
  border-radius: 0 0 16rpx 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  overflow: hidden;
  min-height: 400rpx;
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
  animation: emptyBounce 2s ease-in-out infinite;
}

@keyframes emptyBounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-12rpx); }
}

.empty-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333333;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999999;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 32rpx;
}

.empty-btn {
  background: linear-gradient(135deg, #2D5A27 0%, #43A047 100%);
  padding: 18rpx 40rpx;
  border-radius: 40rpx;
  box-shadow: 0 4rpx 16rpx rgba(45, 90, 39, 0.3);
  transition: all 0.3s ease;
}

.empty-btn:active {
  transform: scale(0.95);
}

.empty-btn-text {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 600;
}

/* ===== 路线卡片列表 ===== */
.route-list {
  padding: 16rpx;
}

.route-card {
  background: #FAFAFA;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
  transition: all 0.3s ease;
  position: relative;
}

.route-card:last-child {
  margin-bottom: 0;
}

.route-card:active {
  transform: scale(0.98);
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.06);
}

/* 卡片封面 */
.card-cover {
  position: relative;
  height: 200rpx;
  overflow: hidden;
}

.card-image {
  width: 100%;
  height: 100%;
  background: #E0E0E0;
}

.card-difficulty-badge {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
}

.badge-text {
  font-size: 22rpx;
  color: #FFFFFF;
  font-weight: 600;
}

.completed-badge {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  background: rgba(45, 90, 39, 0.85);
  padding: 8rpx 18rpx;
  border-radius: 12rpx;
  backdrop-filter: blur(8rpx);
}

.completed-badge-text {
  font-size: 22rpx;
  color: #FFFFFF;
  font-weight: 600;
}

/* 卡片内容 */
.card-body {
  padding: 20rpx 24rpx 24rpx;
}

.card-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1A1A;
  display: block;
  margin-bottom: 8rpx;
}

.card-desc {
  font-size: 24rpx;
  color: #888888;
  display: block;
  margin-bottom: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 12rpx;
}

.card-tag {
  background: #F0F7F0;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
}

.tag-text {
  font-size: 22rpx;
  color: #2D5A27;
  font-weight: 500;
}

.card-scenery-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.scenery-tag {
  background: #FFF8E1;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
  color: #F57F17;
}

/* 已走过信息 */
.completed-info {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed #E0E0E0;
}

.completed-date {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.date-icon {
  font-size: 24rpx;
}

.date-text {
  font-size: 24rpx;
  color: #2D5A27;
  font-weight: 600;
}

.completed-note {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  background: #FFFDE7;
  padding: 12rpx 16rpx;
  border-radius: 10rpx;
  margin-top: 8rpx;
}

.note-icon {
  font-size: 24rpx;
  flex-shrink: 0;
}

.note-text {
  font-size: 24rpx;
  color: #5D4037;
  line-height: 1.6;
}

/* 卡片操作按钮 */
.card-action {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 50%;
  backdrop-filter: blur(8rpx);
}

.action-dot {
  font-size: 28rpx;
  color: #666666;
  letter-spacing: 2rpx;
}

/* ===== 底部提示 ===== */
.footer-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 24rpx 32rpx;
  gap: 10rpx;
}

.tip-icon {
  font-size: 28rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #AAAAAA;
}

/* ===== 已走过卡片特殊样式 ===== */
.completed-card {
  border-left: 6rpx solid #2D5A27;
}

.completed-card .card-body {
  padding-left: 20rpx;
}
