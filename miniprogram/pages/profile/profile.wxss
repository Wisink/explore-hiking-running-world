/* pages/profile/profile.wxss - v3.0 自然清新风 + 毛玻璃 */

/* 状态栏占位 — 毛玻璃 */
.page-statusbar {
  background: linear-gradient(135deg,
    rgba(129, 199, 132, 0.5) 0%,
    rgba(76, 175, 80, 0.4) 100%
  );
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
}

.profile-page {
  min-height: 100vh;
  padding-bottom: calc(120rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
  background-color: #c8e6c9;
  background:
    radial-gradient(ellipse at 20% 50%, rgba(129,199,132,.35) 0%, transparent 50%),
    radial-gradient(ellipse at 80% 20%, rgba(165,214,167,.25) 0%, transparent 50%),
    radial-gradient(ellipse at 60% 80%, rgba(76,175,80,.2) 0%, transparent 50%),
    linear-gradient(160deg, #e8f5e9 0%, #c8e6c9 25%, #a5d6a7 50%, #81c784 75%, #66bb6a 100%);
}

/* 头像和昵称 — 个性化 */
.profile-avatar-wrap {
  display: flex;
  justify-content: center;
  margin-bottom: 16rpx;
  animation: fadeInUp 400ms cubic-bezier(0.34, 1.56, 0.64, 1) both;
}

.profile-avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 4rpx solid #FFFFFF;
  box-shadow:
    0 0 0 4rpx rgba(46, 125, 50, 0.15),
    0 4rpx 20rpx rgba(46, 125, 50, 0.25),
    0 8rpx 32rpx rgba(31, 38, 50, 0.1);
}

.profile-nickname {
  display: block;
  text-align: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #2d6a4f;
  margin-bottom: 52rpx;
  letter-spacing: 2rpx;
  text-shadow: 0 1rpx 4rpx rgba(255, 255, 255, 0.5);
  animation: fadeInUp 400ms cubic-bezier(0.34, 1.56, 0.64, 1) 100ms both;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 顶部标题 — 毛玻璃 */
.page-header {
  position: relative;
  padding: 32rpx 32rpx 20rpx;
  overflow: hidden;
}

.page-header__bg {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(135deg, rgba(129,199,132,.5) 0%, rgba(76,175,80,.4) 100%);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-bottom: 1px solid rgba(255,255,255,.25);
}

.page-header__content {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.page-header__emoji {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.page-header__title {
  font-size: 44rpx;
  font-weight: 800;
  color: #1a2e1a;
  letter-spacing: 1rpx;
  text-shadow: 0 1rpx 6rpx rgba(255,255,255,.5);
}

.page-header__sub {
  font-size: 26rpx;
  color: #4a6b4a;
}

/* 用户访问信息 */
.page-header__visit {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 12rpx;
}

.page-header__visit-text {
  font-size: 24rpx;
  color: #4a6b4a;
  background: rgba(255, 255, 255, 0.3);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  border: 1px solid rgba(255, 255, 255, 0.25);
}

.page-header__visit-number {
  font-size: 24rpx;
  font-weight: 700;
  color: #2d6a4f;
  background: rgba(255, 255, 255, 0.35);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  border: 1px solid rgba(255, 255, 255, 0.25);
}

/* 同步状态 — 毛玻璃 */
.sync-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  background: rgba(227, 242, 253, 0.5);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border-bottom: 1px solid rgba(255,255,255,.15);
}

.sync-bar--success {
  background: rgba(232, 245, 233, 0.5);
}

.sync-bar--error {
  background: rgba(255, 243, 224, 0.5);
}

.sync-bar__icon { font-size: 24rpx; }
.sync-bar__text { font-size: 24rpx; color: #4a6b4a; }

/* 统计卡片 — 毛玻璃 */
.stats-card {
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: rgba(255, 255, 255, 0.25);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(255,255,255,.25);
  margin: 16rpx 24rpx 24rpx;
  padding: 36rpx 20rpx;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(31,38,50,.15);
}

.stats-card__item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stats-card__num {
  font-size: 52rpx;
  font-weight: 800;
  color: #1a2e1a;
  margin-bottom: 8rpx;
  animation: countUp 500ms cubic-bezier(0.175, 0.885, 0.32, 1.275) both;
}

@keyframes countUp {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.stats-card__label {
  font-size: 26rpx;
  color: #4a6b4a;
  font-weight: 500;
}

.stats-card__divider {
  width: 1rpx;
  height: 48rpx;
  background: rgba(255,255,255,.3);
}

/* Tab 切换 — 毛玻璃 */
.tab-bar {
  display: flex;
  background: rgba(255, 255, 255, 0.18);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1px solid rgba(255,255,255,.2);
  margin: 0 24rpx;
  border-radius: 20rpx 20rpx 0 0;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(31,38,50,.1);
}

.tab-bar__item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 0 20rpx;
  position: relative;
  transition: all 250ms ease;
}

.tab-bar__item--on .tab-bar__text {
  color: #1a2e1a;
  font-weight: 700;
}

.tab-bar__text {
  font-size: 28rpx;
  color: #6b8b6b;
  font-weight: 500;
  transition: color 250ms ease;
}

.tab-bar__line {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60%;
  height: 6rpx;
  background: linear-gradient(90deg, #2d6a4f, #74c69d);
  border-radius: 3rpx;
  animation: tabSlide 250ms cubic-bezier(0, 0, 0.2, 1) both;
}

@keyframes tabSlide {
  from { width: 0; opacity: 0; }
  to { width: 60%; opacity: 1; }
}

/* 列表区域 — 毛玻璃 */
.list-wrap {
  margin: 0 24rpx;
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1px solid rgba(255,255,255,.18);
  border-radius: 0 0 20rpx 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(31,38,50,.1);
  overflow: hidden;
  min-height: 400rpx;
}

/* 空状态 */
.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
}

.empty-visual {
  position: relative;
  width: 140rpx;
  height: 140rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
}

.empty-circle {
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(129,199,132,.3) 0%, rgba(76,175,80,.2) 100%);
  animation: emptyPulse 3s ease-in-out infinite;
}

@keyframes emptyPulse {
  0%, 100% { transform: scale(1); opacity: 0.6; }
  50% { transform: scale(1.08); opacity: 1; }
}

.empty-icon {
  position: relative;
  font-size: 64rpx;
  animation: emptyFloat 3s ease-in-out infinite;
}

@keyframes emptyFloat {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
}

.empty-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a2e1a;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #6b8b6b;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 32rpx;
}

.empty-btn {
  background: linear-gradient(135deg, rgba(46,125,50,.85) 0%, rgba(67,160,71,.85) 100%);
  padding: 18rpx 40rpx;
  border-radius: 40rpx;
  box-shadow: 0 4rpx 16rpx rgba(46, 125, 50, 0.3);
  border: 1px solid rgba(255,255,255,.2);
  transition: transform 150ms ease;
}

.empty-btn:active { transform: scale(0.95); }

.empty-btn text {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 600;
}

/* 路线卡片列表 — 毛玻璃 */
.route-list {
  padding: 16rpx;
}

.route-card {
  background: rgba(250, 250, 245, 0.3);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 1px solid rgba(255,255,255,.2);
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(31,38,50,.08);
  transition: all 200ms ease;
  position: relative;
}

.route-card:last-child { margin-bottom: 0; }

.route-card--hover { transform: scale(0.98); }

/* 卡片封面 */
.route-card__cover {
  position: relative;
  height: 200rpx;
  overflow: hidden;
}

.route-card__img {
  width: 100%;
  height: 100%;
  background: rgba(224,224,219,.4);
}

.route-card__overlay {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  height: 40%;
  background: linear-gradient(180deg, rgba(0,0,0,0) 0%, rgba(0,0,0,0.25) 100%);
  pointer-events: none;
}

.route-card__badge {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  color: #FFFFFF;
  font-weight: 600;
  backdrop-filter: blur(8rpx);
  -webkit-backdrop-filter: blur(8rpx);
}

.route-card__done {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  background: rgba(46, 125, 50, 0.8);
  padding: 8rpx 18rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  color: #FFFFFF;
  font-weight: 600;
  backdrop-filter: blur(8rpx);
  -webkit-backdrop-filter: blur(8rpx);
  border: 1px solid rgba(255,255,255,.2);
}

/* 卡片内容 */
.route-card__body {
  padding: 20rpx 24rpx 24rpx;
}

.route-card__name {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #1a2e1a;
  margin-bottom: 8rpx;
}

.route-card__desc {
  display: block;
  font-size: 24rpx;
  color: #6b8b6b;
  margin-bottom: 14rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.route-card__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.route-card__tag {
  padding: 6rpx 14rpx;
  background: rgba(129, 199, 132, 0.15);
  backdrop-filter: blur(8rpx);
  -webkit-backdrop-filter: blur(8rpx);
  border-radius: 8rpx;
  font-size: 22rpx;
  color: #2d6a4f;
  font-weight: 500;
  border: 1px solid rgba(129,199,132,.15);
}

/* 已走过信息 */
.completed-info {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed rgba(255,255,255,.3);
}

.completed-info__date {
  font-size: 24rpx;
  color: #2d6a4f;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.completed-info__difficulty {
  font-size: 24rpx;
  color: #E65100;
  font-weight: 500;
  margin-bottom: 8rpx;
  background: rgba(255, 243, 224, 0.6);
  backdrop-filter: blur(8rpx);
  -webkit-backdrop-filter: blur(8rpx);
  padding: 8rpx 14rpx;
  border-radius: 8rpx;
  display: inline-block;
}

.completed-info__note {
  background: rgba(255, 253, 231, 0.5);
  backdrop-filter: blur(8rpx);
  -webkit-backdrop-filter: blur(8rpx);
  padding: 12rpx 16rpx;
  border-radius: 10rpx;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #5D4037;
  line-height: 1.6;
}

/* 卡片操作 */
.route-card__action {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.3);
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
  border-radius: 50%;
  font-size: 28rpx;
  color: #4a6b4a;
  border: 1px solid rgba(255,255,255,.25);
}

/* 已走过卡片特殊样式 */
.route-card--completed {
  border-left: 6rpx solid rgba(46, 125, 50, 0.6);
}

/* 查看更多按钮 */
.show-more-routes {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 20rpx 0;
}

.show-more-routes text {
  font-size: 26rpx;
  color: #2d6a4f;
  font-weight: 600;
}

/* ===== 后台管理入口 — 毛玻璃 ===== */
.admin-entry {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border: 1px solid rgba(255,255,255,.2);
  margin: 24rpx 24rpx 0;
  padding: 28rpx 24rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(31,38,50,.1);
}

.admin-entry__icon { font-size: 36rpx; margin-right: 16rpx; }

.admin-entry__text {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #1a2e1a;
}

.admin-entry__arrow {
  font-size: 36rpx;
  color: #6b8b6b;
  font-weight: 300;
}

/* 底部 */
.footer {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx 24rpx 8rpx;
  gap: 10rpx;
}

.footer__icon { font-size: 28rpx; }
.footer__text { font-size: 24rpx; color: #6b8b6b; }

/* 备案号 */
.icp-footer {
  text-align: center;
  padding: 0 24rpx 24rpx;
}

.icp-footer__text {
  font-size: 22rpx;
  color: #4a6b4a;
}

/* ===== 收藏按钮 ===== */
.route-card__fav {
  position: absolute;
  bottom: 16rpx;
  right: 16rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.35);
  backdrop-filter: blur(12rpx);
  -webkit-backdrop-filter: blur(12rpx);
  border: 1px solid rgba(255,255,255,.3);
  border-radius: 50%;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.12);
  font-size: 30rpx;
  transition: transform 200ms cubic-bezier(0.34, 1.56, 0.64, 1);
  z-index: 5;
}

.route-card__fav:active {
  transform: scale(1.3);
}

/* 同步状态栏 */
.sync-status-bar {
  margin: 16rpx 24rpx;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  background: linear-gradient(135deg, #fff5f5 0%, #ffecec 100%);
  border: 1px solid #ffd0d0;
  box-shadow: 0 4rpx 16rpx rgba(255, 75, 75, 0.08);
}
.sync-status--loading {
  background: linear-gradient(135deg, #eff6ff 0%, #e6f0ff 100%);
  border-color: #bed5ff;
  box-shadow: 0 4rpx 16rpx rgba(59, 130, 246, 0.08);
}
.sync-status__content {
  display: flex;
  align-items: center;
  gap: 16rpx;
  justify-content: space-between;
}
.sync-status__left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.sync-status__icon {
  font-size: 32rpx;
}
.sync-status__text {
  font-size: 26rpx;
  color: #e53e3e;
}
.sync-status--loading .sync-status__text {
  color: #3b82f6;
}
.sync-status__retry {
  background: #e53e3e;
  color: #fff;
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  flex-shrink: 0;
}
.sync-status__retry-text {
  color: #fff;
}
