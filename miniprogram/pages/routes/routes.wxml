<!--pages/routes/routes.wxml-->
<view class="routes-page">

  <!-- 状态栏占位 -->
  <view class="page-statusbar" style="height: {{statusBarHeight}}px;"></view>

  <!-- 顶部标题栏 + 搜索栏 -->
  <view class="header">
    <view class="header__bg"></view>
    <view class="header__content">
      <view class="header__left">
        <text class="header__emoji">🏔️</text>
        <view class="header__text">
          <text class="header__title">秦人徒步</text>
          <text class="header__sub">去户外徒步，让身心与自然相融</text>
        </view>
      </view>
      <view class="header__search-inline">
        <view class="search-row">
          <view class="search-inline">
            <text class="search-inline__icon">🔍</text>
            <input
              class="search-inline__field"
              placeholder="输入路线名称或地点..."
              value="{{searchKeyword}}"
              bindinput="onSearchInput"
              bindconfirm="onSearchConfirm"
              confirm-type="search"
            />
            <text class="search-inline__clear" wx:if="{{searchKeyword}}" bindtap="onSearchClear">✕</text>
            <view class="search-inline__search-btn" bindtap="onSearchConfirm">
              <text>搜索</text>
            </view>
          </view>
          <view class="search-advanced-filter-btn {{showAdvancedFilter ? 'active' : ''}}" bindtap="onToggleAdvancedFilter">
            <text>🔬 高级筛选</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 高级筛选 -->
  <view class="advanced-filter" wx:if="{{showAdvancedFilter}}">
    <view class="advanced-filter__row">
      <text class="advanced-filter__label">难度</text>
      <view class="advanced-filter__options">
        <text class="advanced-filter__option {{activeDifficulty === '' ? 'active' : ''}}" data-value="" bindtap="onDifficultyFilter">不限</text>
        <text class="advanced-filter__option {{activeDifficulty === '1' ? 'active' : ''}}" data-value="1" bindtap="onDifficultyFilter">轻松</text>
        <text class="advanced-filter__option {{activeDifficulty === '2' ? 'active' : ''}}" data-value="2" bindtap="onDifficultyFilter">简单</text>
        <text class="advanced-filter__option {{activeDifficulty === '3' ? 'active' : ''}}" data-value="3" bindtap="onDifficultyFilter">适中</text>
        <text class="advanced-filter__option {{activeDifficulty === '4' ? 'active' : ''}}" data-value="4" bindtap="onDifficultyFilter">较难</text>
        <text class="advanced-filter__option {{activeDifficulty === '5' ? 'active' : ''}}" data-value="5" bindtap="onDifficultyFilter">困难</text>
      </view>
    </view>
    <view class="advanced-filter__row">
      <text class="advanced-filter__label">距离</text>
      <view class="advanced-filter__options">
        <text class="advanced-filter__option {{activeDistance === '' ? 'active' : ''}}" data-value="" bindtap="onDistanceFilter">不限</text>
        <text class="advanced-filter__option {{activeDistance === '0-5' ? 'active' : ''}}" data-value="0-5" bindtap="onDistanceFilter">5km以内</text>
        <text class="advanced-filter__option {{activeDistance === '5-10' ? 'active' : ''}}" data-value="5-10" bindtap="onDistanceFilter">5-10km</text>
        <text class="advanced-filter__option {{activeDistance === '10-15' ? 'active' : ''}}" data-value="10-15" bindtap="onDistanceFilter">10-15km</text>
        <text class="advanced-filter__option {{activeDistance === '15-20' ? 'active' : ''}}" data-value="15-20" bindtap="onDistanceFilter">15-20km</text>
        <text class="advanced-filter__option {{activeDistance === '20+' ? 'active' : ''}}" data-value="20+" bindtap="onDistanceFilter">20km+</text>
      </view>
    </view>
    <view class="advanced-filter__row">
      <text class="advanced-filter__label">爬升</text>
      <view class="advanced-filter__options">
        <text class="advanced-filter__option {{activeElevation === '' ? 'active' : ''}}" data-value="" bindtap="onElevationFilter">不限</text>
        <text class="advanced-filter__option {{activeElevation === '0-300' ? 'active' : ''}}" data-value="0-300" bindtap="onElevationFilter">300m以内</text>
        <text class="advanced-filter__option {{activeElevation === '300-600' ? 'active' : ''}}" data-value="300-600" bindtap="onElevationFilter">300-600m</text>
        <text class="advanced-filter__option {{activeElevation === '600-1000' ? 'active' : ''}}" data-value="600-1000" bindtap="onElevationFilter">600-1000m</text>
        <text class="advanced-filter__option {{activeElevation === '1000+' ? 'active' : ''}}" data-value="1000+" bindtap="onElevationFilter">1000m+</text>
      </view>
    </view>
    <view class="advanced-filter__row">
      <text class="advanced-filter__label">地形</text>
      <view class="advanced-filter__options">
        <text class="advanced-filter__option {{activeTerrain === '' ? 'active' : ''}}" data-value="" bindtap="onTerrainFilter">不限</text>
        <text class="advanced-filter__option {{activeTerrain === 'mountain_path' ? 'active' : ''}}" data-value="mountain_path" bindtap="onTerrainFilter">山间小路</text>
        <text class="advanced-filter__option {{activeTerrain === 'forest' ? 'active' : ''}}" data-value="forest" bindtap="onTerrainFilter">穿越森林</text>
        <text class="advanced-filter__option {{activeTerrain === 'stream' ? 'active' : ''}}" data-value="stream" bindtap="onTerrainFilter">溪流路段</text>
        <text class="advanced-filter__option {{activeTerrain === 'ridge' ? 'active' : ''}}" data-value="ridge" bindtap="onTerrainFilter">山脊行走</text>
        <text class="advanced-filter__option {{activeTerrain === 'rock_scramble' ? 'active' : ''}}" data-value="rock_scramble" bindtap="onTerrainFilter">岩石攀爬</text>
        <text class="advanced-filter__option {{activeTerrain === 'grassland' ? 'active' : ''}}" data-value="grassland" bindtap="onTerrainFilter">高山草甸</text>
        <text class="advanced-filter__option {{activeTerrain === 'paved' ? 'active' : ''}}" data-value="paved" bindtap="onTerrainFilter">景区步道</text>
      </view>
    </view>
    <view class="advanced-filter__row">
      <text class="advanced-filter__label">季节</text>
      <view class="advanced-filter__options">
        <text class="advanced-filter__option {{activeSeason === '' ? 'active' : ''}}" data-value="" bindtap="onSeasonFilter">不限</text>
        <text class="advanced-filter__option {{activeSeason === 'spring' ? 'active' : ''}}" data-value="spring" bindtap="onSeasonFilter">春季</text>
        <text class="advanced-filter__option {{activeSeason === 'summer' ? 'active' : ''}}" data-value="summer" bindtap="onSeasonFilter">夏季</text>
        <text class="advanced-filter__option {{activeSeason === 'autumn' ? 'active' : ''}}" data-value="autumn" bindtap="onSeasonFilter">秋季</text>
        <text class="advanced-filter__option {{activeSeason === 'winter' ? 'active' : ''}}" data-value="winter" bindtap="onSeasonFilter">冬季</text>
      </view>
    </view>
    <view class="advanced-filter__row">
      <text class="advanced-filter__label">区县</text>
      <view class="advanced-filter__options">
        <text class="advanced-filter__option {{activeDistrict === '' ? 'active' : ''}}" data-value="" bindtap="onDistrictFilter">不限</text>
        <text class="advanced-filter__option {{activeDistrict === '长安区' ? 'active' : ''}}" data-value="长安区" bindtap="onDistrictFilter">长安区</text>
        <text class="advanced-filter__option {{activeDistrict === '鄠邑区' ? 'active' : ''}}" data-value="鄠邑区" bindtap="onDistrictFilter">鄠邑区</text>
        <text class="advanced-filter__option {{activeDistrict === '蓝田县' ? 'active' : ''}}" data-value="蓝田县" bindtap="onDistrictFilter">蓝田县</text>
        <text class="advanced-filter__option {{activeDistrict === '周至县' ? 'active' : ''}}" data-value="周至县" bindtap="onDistrictFilter">周至县</text>
        <text class="advanced-filter__option {{activeDistrict === '临潼区' ? 'active' : ''}}" data-value="临潼区" bindtap="onDistrictFilter">临潼区</text>
        <text class="advanced-filter__option {{activeDistrict === '泾阳县' ? 'active' : ''}}" data-value="泾阳县" bindtap="onDistrictFilter">泾阳县</text>
      </view>
    </view>
    <view class="advanced-filter__actions">
      <view class="advanced-filter__reset" bindtap="onResetFilters">
        <text>🔄 重置</text>
      </view>
      <view class="advanced-filter__collapse" bindtap="onToggleAdvancedFilter">
        <text>收起</text>
      </view>
      <view class="advanced-filter__apply" bindtap="onViewResults">
        <text>查看结果</text>
      </view>
    </view>
  </view>

  <!-- ★ 功能入口：双卡片横排 -->
  <view class="quick-actions">
    <view class="quick-card quick-card--highlight" bindtap="onNearbyTap">
      <view class="quick-card__icon">📍</view>
      <view class="quick-card__text">
        <text class="quick-card__title">附近路线</text>
        <text class="quick-card__desc">基于定位发现周边路线</text>
      </view>
    </view>
    <view class="quick-card quick-card--assistant" bindtap="onAssistantTap">
      <view class="quick-card__icon">🤖</view>
      <view class="quick-card__text">
        <text class="quick-card__title">徒步助手</text>
        <text class="quick-card__desc">基于需求智能推荐路线</text>
      </view>
    </view>
  </view>

  <!-- 筛选标签栏 -->
  <scroll-view class="filter-scroll" scroll-x enable-flex>
    <view
      class="filter-chip {{activeFilter === item.id ? 'filter-chip--active' : ''}}"
      wx:for="{{filterTags}}"
      wx:key="id"
      data-filter="{{item.id}}"
      bindtap="onFilterTap"
      hover-class="filter-chip--hover"
      hover-stay-time="80"
    >
      <text class="filter-chip__icon" wx:if="{{item.icon}}">{{item.icon}}</text>
      <text class="filter-chip__text">{{item.label}}</text>
    </view>
  </scroll-view>

  <!-- 骨架屏 -->
  <view class="skeleton-wrap" wx:if="{{showSkeleton}}">
    <view class="skel-card" wx:for="{{3}}" wx:key="index">
      <view class="skel-cover skel-shimmer"></view>
      <view class="skel-body">
        <view class="skel-line skel-line--title skel-shimmer"></view>
        <view class="skel-line skel-line--desc skel-shimmer"></view>
        <view class="skel-row">
          <view class="skel-chip skel-shimmer"></view>
          <view class="skel-chip skel-shimmer"></view>
          <view class="skel-chip skel-shimmer"></view>
        </view>
      </view>
    </view>
  </view>

  <!-- ===== 搜索结果列表 ===== -->
  <view class="search-result-wrap" wx:if="{{searchMode && !showSkeleton}}">
    <!-- 搜索骨架屏 -->
    <view class="skeleton-wrap" wx:if="{{searchLoading}}">
      <view class="skel-card" wx:for="{{3}}" wx:key="index">
        <view class="skel-cover skel-shimmer"></view>
        <view class="skel-body">
          <view class="skel-line skel-line--title skel-shimmer"></view>
          <view class="skel-line skel-line--desc skel-shimmer"></view>
          <view class="skel-row">
            <view class="skel-chip skel-shimmer"></view>
            <view class="skel-chip skel-shimmer"></view>
            <view class="skel-chip skel-shimmer"></view>
          </view>
        </view>
      </view>
    </view>

    <!-- 搜索结果卡片列表（复用 route-card 组件） -->
    <view class="route-list" wx:if="{{!searchLoading}}">
      <view class="search-result-header" wx:if="{{searchResults.length > 0}}">
        <text class="search-result-count">找到 {{searchResults.length}} 条路线</text>
        <text class="search-result-keyword">"{{searchKeyword}}"</text>
      </view>

      <view
        wx:for="{{searchResults}}"
        wx:key="_id"
        style="animation: fadeInUp 400ms cubic-bezier(0.25, 0.46, 0.45, 0.94) both; animation-delay: {{index * 80}}ms;"
      >
        <route-card
          route="{{item}}"
          isFavorited="{{item.isFavorited}}"
          bind:tap="onRouteTap"
          bind:fav="onFavoriteTap"
        />
      </view>

      <!-- 搜索无结果空状态 -->
      <view class="empty-wrap" wx:if="{{searchResults.length === 0}}">
        <view class="empty-visual">
          <view class="empty-circle"></view>
          <text class="empty-icon">🔍</text>
        </view>
        <text class="empty-title">没有找到相关路线</text>
        <text class="empty-desc">试试其他关键词？</text>
      </view>
    </view>
  </view>

  <!-- 路线卡片列表（非搜索模式） -->
  <view class="route-list" wx:if="{{!showSkeleton && !searchMode}}">
    <!-- 复用 route-card 组件 -->
    <view
      wx:for="{{routes}}"
      wx:key="_id"
      style="animation: fadeInUp 400ms cubic-bezier(0.25, 0.46, 0.45, 0.94) both; animation-delay: {{index * 80}}ms;"
    >
      <route-card
        route="{{item}}"
        isFavorited="{{item.isFavorited}}"
        bind:tap="onRouteTap"
        bind:fav="onFavoriteTap"
      />
    </view>

    <!-- 空状态 -->
    <view class="empty-wrap" wx:if="{{routes.length === 0 && !loading}}">
      <view class="empty-visual">
        <view class="empty-circle"></view>
        <text class="empty-icon">🥾</text>
      </view>
      <text class="empty-title">暂无匹配路线</text>
      <text class="empty-desc">试试其他筛选条件？</text>
    </view>

    <!-- 加载更多 -->
    <view class="load-more" wx:if="{{loading}}">
      <view class="load-spinner"></view>
      <text class="load-text">加载中...</text>
    </view>

    <!-- 没有更多 -->
    <view class="no-more" wx:if="{{!hasMore && routes.length > 0 && !loading}}">
      <view class="no-more__line"></view>
      <text class="no-more__text">已经到底啦</text>
      <view class="no-more__line"></view>
    </view>
  </view>

  <view class="nice-toast nice-toast--{{toastType}} {{showToast ? 'nice-toast--show' : ''}}">{{toastMessage}}</view>

  <!-- ===== 收藏成功提示弹窗 ===== -->
  <view class="hint-overlay" wx:if="{{showFavHint}}" bindtap="onCloseFavHint">
    <view class="hint-popup" catchtap="">
      <view class="hint-popup__icon">❤️</view>
      <view class="hint-popup__title">收藏成功！</view>
      <view class="hint-popup__desc">这条路线收藏好了，你可以在「个人中心」-「我的收藏」中查看所有收藏的路线哦！</view>
      <view class="hint-popup__btn" bindtap="onCloseFavHint">我知道了</view>
    </view>
  </view>

</view>
