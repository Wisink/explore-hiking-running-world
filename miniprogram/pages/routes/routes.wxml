<!--pages/routes/routes.wxml-->
<view class="routes-page">

  <!-- 顶部标题栏 -->
  <view class="header">
    <view class="header__bg"></view>
    <view class="header__content">
      <view class="header__left">
        <text class="header__emoji">🏔️</text>
        <view class="header__text">
          <text class="header__title">秦人徒步</text>
          <text class="header__sub">发现秦岭好路线</text>
        </view>
      </view>
      <view class="header__search" bindtap="onSearchTap">
        <text class="header__search-icon">🔍</text>
      </view>
    </view>
  </view>

  <!-- 搜索栏（展开状态） -->
  <view class="search-bar" wx:if="{{showSearch}}">
    <view class="search-bar__input">
      <text class="search-bar__icon">🔍</text>
      <input
        class="search-bar__field"
        placeholder="搜索路线名称、地点..."
        value="{{searchKeyword}}"
        bindinput="onSearchInput"
        bindconfirm="onSearchConfirm"
        confirm-type="search"
        focus="{{showSearch}}"
      />
      <text class="search-bar__clear" wx:if="{{searchKeyword}}" bindtap="onSearchClear">✕</text>
    </view>
    <text class="search-bar__cancel" bindtap="onSearchCancel">取消</text>
  </view>

  <!-- 筛选标签栏 -->
  <scroll-view class="filter-scroll" scroll-x enable-flex>
    <view
      class="filter-chip {{activeFilter === item.id ? 'filter-chip--active' : ''}}"
      wx:for="{{filterTags}}"
      wx:key="id"
      data-filter="{{item.id}}"
      bindtap="onFilterTap"
      hover-class="filter-chip--hover"
      hover-stay-time="80"
    >
      <text class="filter-chip__icon" wx:if="{{item.icon}}">{{item.icon}}</text>
      <text class="filter-chip__text">{{item.label}}</text>
    </view>
  </scroll-view>

  <!-- 骨架屏 -->
  <view class="skeleton-wrap" wx:if="{{showSkeleton}}">
    <view class="skel-card" wx:for="{{3}}" wx:key="index">
      <view class="skel-cover skel-shimmer"></view>
      <view class="skel-body">
        <view class="skel-line skel-line--title skel-shimmer"></view>
        <view class="skel-line skel-line--desc skel-shimmer"></view>
        <view class="skel-row">
          <view class="skel-chip skel-shimmer"></view>
          <view class="skel-chip skel-shimmer"></view>
          <view class="skel-chip skel-shimmer"></view>
        </view>
      </view>
    </view>
  </view>

  <!-- 路线卡片列表 -->
  <view class="route-list" wx:if="{{!showSkeleton}}">
    <view
      class="route-card"
      wx:for="{{routes}}"
      wx:key="_id"
      data-id="{{item._id}}"
      data-index="{{index}}"
      bindtap="onRouteTap"
      hover-class="route-card--hover"
      style="animation-delay: {{index * 80}}ms"
    >
      <!-- 封面图 -->
      <view class="route-card__cover">
        <image
          class="route-card__image"
          src="{{item.coverImage || '/images/scenery/scenery-general.jpg'}}"
          mode="aspectFill"
          lazy-load
        />
        <view class="route-card__overlay"></view>

        <!-- 难度角标 -->
        <view class="route-card__badge" style="background: {{item.diffColor}}">
          {{item.diffText}}
        </view>

        <!-- 免费角标 -->
        <view class="route-card__free" wx:if="{{item.isFree}}">免费</view>

        <!-- 收藏按钮 -->
        <view
          class="route-card__fav {{item.isFavorited ? 'route-card__fav--on' : ''}}"
          data-id="{{item._id}}"
          data-index="{{index}}"
          catchtap="onFavoriteTap"
        >
          <text>{{item.isFavorited ? '❤️' : '🤍'}}</text>
        </view>

        <!-- 底部叠加信息 -->
        <view class="route-card__hero">
          <text class="route-card__name">{{item.name}}</text>
          <view class="route-card__meta">
            <view class="route-card__meta-item" wx:if="{{item.distanceText}}">
              <text>📏 {{item.distanceText}}</text>
            </view>
            <view class="route-card__meta-item" wx:if="{{item.durationText}}">
              <text>⏱ {{item.durationText}}</text>
            </view>
            <view class="route-card__meta-item" wx:if="{{item.cost}}">
              <text>💰 {{item.isFree ? '免费' : item.cost}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 卡片内容 -->
      <view class="route-card__body">
        <text class="route-card__desc ellipsis">{{item.description || '探索这条美丽的路线'}}</text>

        <!-- 风景标签 -->
        <view class="route-card__tags" wx:if="{{item.features && item.features.length > 0}}">
          <text class="route-card__tag" wx:for="{{item.features}}" wx:for-item="feat" wx:key="*this">{{feat}}</text>
        </view>

        <!-- 亲子标记 -->
        <view class="route-card__family" wx:if="{{item.family_friendly}}">
          <text>👨‍👩‍👧 亲子友好</text>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-wrap" wx:if="{{routes.length === 0 && !loading}}">
      <view class="empty-visual">
        <view class="empty-circle"></view>
        <text class="empty-icon">🥾</text>
      </view>
      <text class="empty-title">暂无匹配路线</text>
      <text class="empty-desc">试试其他筛选条件？</text>
    </view>

    <!-- 加载更多 -->
    <view class="load-more" wx:if="{{loading}}">
      <view class="load-spinner"></view>
      <text class="load-text">加载中...</text>
    </view>

    <!-- 没有更多 -->
    <view class="no-more" wx:if="{{!hasMore && routes.length > 0 && !loading}}">
      <view class="no-more__line"></view>
      <text class="no-more__text">已经到底啦</text>
      <view class="no-more__line"></view>
    </view>
  </view>

</view>
