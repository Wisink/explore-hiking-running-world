<!-- 路线卡片组件 v4.0 - 适配新版 routes 数据集（数字字段） -->
<view
  class="route-card"
  bindtap="onTap"
  hover-class="route-card--hover"
  hover-stay-time="80"
>
  <!-- 封面图区 -->
  <view class="route-card__cover">
    <image
      class="route-card__image"
      src="{{route.coverImage || '/images/scenery/scenery-general.jpg'}}"
      mode="aspectFill"
      lazy-load
      binderror="onImageError"
    />
    <!-- 渐变遮罩 -->
    <view class="route-card__overlay"></view>

    <!-- 难度角标：纯色背景颜色映射 -->
    <view
      class="route-card__badge"
      style="background: {{route.diffColor || diffColor}}"
    >
      {{route.diffText || difficultyText}}
    </view>

    <!-- 收藏按钮 -->
    <view
      class="route-card__fav {{isFavorited ? 'route-card__fav--active' : ''}}"
      catchtap="onFavTap"
    >
      <text class="route-card__fav-icon">{{isFavorited ? '❤️' : '🤍'}}</text>
    </view>

    <!-- 底部信息叠加 -->
    <view class="route-card__hero">
      <text class="route-card__name">{{route.name}}</text>
      <view class="route-card__meta">
        <view class="route-card__meta-item" wx:if="{{route.distance > 0}}">
          <text class="meta-icon">📏</text>
          <text>{{route.distance}}km</text>
        </view>
        <view class="route-card__meta-item" wx:if="{{route.durationText}}">
          <text class="meta-icon">⏱</text>
          <text>{{route.durationText}}</text>
        </view>
        <view class="route-card__meta-item" wx:if="{{route.elevationGain > 0}}">
          <text class="meta-icon">⛰️</text>
          <text>{{route.elevationGain}}m↑</text>
        </view>
        <view class="route-card__meta-item" wx:if="{{route.district}}">
          <text class="meta-icon">📍</text>
          <text>{{route.district}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 内容区 -->
  <view class="route-card__body">
    <!-- 简短描述 -->
    <text class="route-card__desc ellipsis">{{route.shortDesc || route.description || '探索这条美丽的路线'}}</text>

    <!-- 地形类型标签（中文，最多3个） -->
    <view class="route-card__tags" wx:if="{{terrainLabels.length > 0}}">
      <text
        class="route-card__tag"
        wx:for="{{terrainLabels}}"
        wx:key="*this"
      >{{item}}</text>
    </view>

    <!-- 路线DNA标签（中文，最多2个） -->
    <view class="route-card__tags route-card__tags--dna" wx:if="{{dnaLabels.length > 0}}">
      <text
        class="route-card__tag route-card__tag--dna"
        wx:for="{{dnaLabels}}"
        wx:for-item="dna"
        wx:key="*this"
      >{{dna}}</text>
    </view>

    <!-- 底部行：难度星级 + 费用 -->
    <view class="route-card__footer">
      <!-- 难度星级 -->
      <view class="route-card__stars">
        <text
          class="route-card__star"
          wx:for="{{5}}"
          wx:key="*this"
        >{{index < difficultyValue ? '★' : '☆'}}</text>
      </view>

      <!-- 费用 -->
      <view class="route-card__cost route-card__cost--free">
        <text>免费</text>
      </view>
    </view>
  </view>
</view>
