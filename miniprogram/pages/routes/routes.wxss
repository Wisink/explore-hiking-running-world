/* pages/routes/routes.wxss - 路线列表页 v3.0 自然清新风 + 毛玻璃 */

/* 状态栏占位 — 毛玻璃 */
.page-statusbar {
  background: linear-gradient(135deg,
    rgba(129, 199, 132, 0.5) 0%,
    rgba(76, 175, 80, 0.4) 100%
  );
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
}

.routes-page {
  min-height: 100vh;
  padding-bottom: 140rpx;
  background:
    radial-gradient(ellipse at 20% 50%, rgba(129,199,132,.35) 0%, transparent 50%),
    radial-gradient(ellipse at 80% 20%, rgba(165,214,167,.25) 0%, transparent 50%),
    radial-gradient(ellipse at 60% 80%, rgba(76,175,80,.2) 0%, transparent 50%),
    linear-gradient(160deg, #e8f5e9 0%, #c8e6c9 25%, #a5d6a7 50%, #81c784 75%, #66bb6a 100%);
}

/* ===== 顶部标题栏 — 毛玻璃 ===== */
.header {
  position: relative;
  overflow: hidden;
}

.header__bg {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(135deg, rgba(129,199,132,.5) 0%, rgba(76,175,80,.4) 100%);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-bottom: 1px solid rgba(255,255,255,.25);
}

.header__content {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 20rpx 32rpx 24rpx;
}

.header__left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.header__emoji {
  font-size: 40rpx;
}

.header__text {
  display: flex;
  flex-direction: column;
}

.header__title {
  font-size: 36rpx;
  font-weight: 800;
  color: #FFFFFF;
  letter-spacing: 2rpx;
  text-shadow: 0 1rpx 6rpx rgba(255,255,255,.5);
}

.header__sub {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.75);
  margin-top: 2rpx;
}

.header__search {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(12rpx);
  -webkit-backdrop-filter: blur(12rpx);
  border: 1px solid rgba(255,255,255,.25);
  transition: transform 200ms ease;
}

.header__search:active { transform: scale(0.9); }
.header__search-icon { font-size: 34rpx; }

/* ===== 内联搜索栏 — 毛玻璃 ===== */
/* 搜索行 — 搜索框 + 高级筛选按钮同一行 */
.search-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.header__search-inline {
  width: 100%;
}

.search-inline {
  flex: 1;
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.3);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(255,255,255,.25);
  border-radius: 44rpx;
  padding: 0 12rpx 0 20rpx;
  height: 76rpx;
  gap: 8rpx;
}

.search-inline__icon { font-size: 28rpx; opacity: 0.8; }

.search-inline__field {
  flex: 1;
  font-size: 26rpx;
  color: #fff;
  height: 76rpx;
}

.search-inline__field::placeholder {
  color: rgba(255, 255, 255, 0.6);
}

.search-inline__clear {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
  padding: 8rpx;
}

/* 搜索按钮 — 搜索框内部右侧 */
.search-inline__search-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 24rpx;
  background: linear-gradient(135deg, rgba(129,199,132,.85), rgba(76,175,80,.85));
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border-radius: 24rpx;
  font-size: 24rpx;
  color: #FFFFFF;
  font-weight: 600;
  white-space: nowrap;
  border: 1px solid rgba(255,255,255,.2);
  transition: all 200ms ease;
  box-shadow: 0 4rpx 12rpx rgba(76, 175, 80, 0.25);
}

.search-inline__search-btn:active {
  transform: scale(0.95);
  opacity: 0.9;
}

/* 高级筛选按钮 — 搜索框同行右侧 */
.search-advanced-filter-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 36rpx;
  background: rgba(255, 255, 255, 0.25);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border-radius: 28rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 600;
  white-space: nowrap;
  border: 1px solid rgba(255,255,255,.2);
  transition: all 200ms ease;
}

.search-advanced-filter-btn.active {
  background: rgba(255, 255, 255, 0.95);
  color: #2d6a4f;
  border-color: rgba(255,255,255,.4);
}

/* ===== 功能入口卡片 — 双卡片横排 ===== */
.quick-actions {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 24rpx 0;
}

.quick-card {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 14rpx;
  background: rgba(255, 255, 255, 0.22);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(255,255,255,.25);
  border-radius: 20rpx;
  padding: 20rpx 18rpx;
  transition: all 250ms ease;
}

.quick-card:active {
  background: rgba(255, 255, 255, 0.35);
  transform: scale(0.97);
  box-shadow: 0 4rpx 16rpx rgba(46,125,50,0.15);
}

.quick-card__icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: rgba(255,255,255,0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  flex-shrink: 0;
}

.quick-card__text {
  flex: 1;
  min-width: 0;
}

.quick-card__title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #1a2e1a;
  margin-bottom: 4rpx;
}

.quick-card__desc {
  display: block;
  font-size: 20rpx;
  color: #4a6b4a;
  line-height: 1.3;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.quick-card--highlight {
  background: rgba(76,175,80,0.15);
  border-color: rgba(76,175,80,0.25);
}

/* 徒步助手卡片 — 绿色渐变 */
.quick-card--assistant {
  background: linear-gradient(135deg, rgba(200, 230, 201, 0.6) 0%, rgba(165, 214, 167, 0.6) 100%);
  border-color: rgba(129, 199, 132, 0.35);
}

/* ===== 高级筛选 — 毛玻璃 ===== */
.advanced-filter {
  padding: 20rpx 24rpx;
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid rgba(255,255,255,.15);
}

.advanced-filter__row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.advanced-filter__row:last-child { margin-bottom: 0; }

.advanced-filter__label {
  font-size: 24rpx;
  color: #4a6b4a;
  width: 80rpx;
  flex-shrink: 0;
}

.advanced-filter__options {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.advanced-filter__option {
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  color: #4a6b4a;
  background: rgba(255, 255, 255, 0.25);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border-radius: 16rpx;
  border: 1px solid rgba(255,255,255,.2);
  transition: all 200ms ease;
}

.advanced-filter__option.active {
  background: rgba(76, 175, 80, 0.75);
  color: #FFFFFF;
  border-color: rgba(76, 175, 80, 0.5);
  box-shadow: 0 4rpx 16rpx rgba(76, 175, 80, 0.3);
}

.advanced-filter__collapse {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 0;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6b8b6b;
}

/* 高级筛选底部按钮 */
.advanced-filter__actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  margin-top: 8rpx;
  gap: 16rpx;
  border-top: 1px solid rgba(255,255,255,.15);
}

.advanced-filter__reset {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 80rpx;
  background: rgba(255, 255, 255, 0.25);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border-radius: 40rpx;
  font-size: 26rpx;
  color: #4a6b4a;
  font-weight: 600;
  border: 1px solid rgba(255,255,255,.2);
  transition: all 200ms ease;
}

.advanced-filter__reset:active { transform: scale(0.96); }

.advanced-filter__collapse {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 80rpx;
  background: rgba(255, 255, 255, 0.25);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border-radius: 40rpx;
  font-size: 26rpx;
  color: #4a6b4a;
  font-weight: 600;
  border: 1px solid rgba(255,255,255,.2);
  transition: all 200ms ease;
}

.advanced-filter__collapse:active { transform: scale(0.96); }

.advanced-filter__apply {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 80rpx;
  background: linear-gradient(135deg, rgba(129,199,132,.85), rgba(76,175,80,.85));
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border-radius: 40rpx;
  font-size: 26rpx;
  color: #fff;
  font-weight: 600;
  letter-spacing: 2rpx;
  box-shadow: 0 4rpx 16rpx rgba(76, 175, 80, 0.3);
  border: 1px solid rgba(255,255,255,.2);
  transition: all 200ms ease;
}

.advanced-filter__apply:active { transform: scale(0.96); }

/* ===== 筛选标签栏 — 毛玻璃 ===== */
.filter-scroll {
  display: flex;
  white-space: nowrap;
  padding: 20rpx 20rpx;
  background: rgba(255, 255, 255, 0.12);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid rgba(255,255,255,.15);
}

.filter-chip {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 24rpx;
  margin-right: 14rpx;
  border-radius: 40rpx;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 1px solid rgba(255,255,255,.2);
  transition: all 250ms cubic-bezier(0.4, 0, 0.2, 1);
  flex-shrink: 0;
  user-select: none;
}

.filter-chip--hover {
  opacity: 0.8;
  transform: scale(0.95);
}

.filter-chip--active {
  background: linear-gradient(135deg, rgba(46,125,50,.8) 0%, rgba(67,160,71,.8) 100%);
  border-color: rgba(76,175,80,.5);
  box-shadow: 0 4rpx 14rpx rgba(46, 125, 50, 0.3);
}

.filter-chip__icon { font-size: 22rpx; }

.filter-chip__text {
  font-size: 24rpx;
  color: #4a6b4a;
  font-weight: 500;
}

.filter-chip--active .filter-chip__text {
  color: #FFFFFF;
}

/* ===== 骨架屏 ===== */
.skeleton-wrap { padding: 24rpx 24rpx; }

.skel-card {
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1px solid rgba(255,255,255,.2);
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(31,38,50,.12);
}

.skel-cover { width: 100%; height: 360rpx; }
.skel-body { padding: 24rpx; }
.skel-line { border-radius: 8rpx; height: 28rpx; }
.skel-line--title { width: 55%; height: 34rpx; margin-bottom: 16rpx; }
.skel-line--desc { width: 80%; height: 24rpx; margin-bottom: 16rpx; }
.skel-row { display: flex; gap: 12rpx; margin-top: 14rpx; }
.skel-chip { width: 100rpx; height: 32rpx; border-radius: 8rpx; }

.skel-shimmer {
  background: linear-gradient(90deg, rgba(255,255,255,.15) 25%, rgba(129,199,132,.2) 37%, rgba(255,255,255,.15) 63%);
  background-size: 400rpx 100%;
  animation: skelShimmer 1.8s ease infinite;
}

@keyframes skelShimmer {
  0% { background-position: -400rpx 0; }
  100% { background-position: 400rpx 0; }
}

/* ===== 路线卡片列表 — 毛玻璃卡片 ===== */
.route-list {
  padding: 24rpx 24rpx;
}

.route-card {
  background: rgba(255, 255, 255, 0.22);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(255,255,255,.25);
  border-radius: 20rpx;
  margin-bottom: 28rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(31,38,50,.18);
  animation: fadeInUp 400ms cubic-bezier(0.25, 0.46, 0.45, 0.94) both;
  transition: all .35s cubic-bezier(.4,0,.2,1);
}

.route-card--hover {
  transform: scale(0.97);
  opacity: 0.95;
}

@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(40rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* 卡片封面 */
.route-card__cover {
  position: relative;
  width: 100%;
  height: 360rpx;
  overflow: hidden;
}

.route-card__image {
  width: 100%;
  height: 100%;
  transition: transform 500ms ease;
}

.route-card:active .route-card__image {
  transform: scale(1.03);
}

.route-card__overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 65%;
  background: linear-gradient(180deg, rgba(0,0,0,0) 0%, rgba(0,0,0,0.45) 100%);
  pointer-events: none;
}

/* 难度角标 */
.route-card__badge {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  padding: 8rpx 18rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  color: #FFFFFF;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.15);
  backdrop-filter: blur(8rpx);
  -webkit-backdrop-filter: blur(8rpx);
}

/* 免费角标 */
.route-card__free {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  background: rgba(76, 175, 80, 0.85);
  font-size: 22rpx;
  color: #FFFFFF;
  font-weight: 500;
  backdrop-filter: blur(8rpx);
  -webkit-backdrop-filter: blur(8rpx);
}

/* 收藏按钮 */
.route-card__fav {
  position: absolute;
  bottom: 16rpx;
  right: 16rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.3);
  backdrop-filter: blur(12rpx);
  -webkit-backdrop-filter: blur(12rpx);
  border: 1px solid rgba(255,255,255,.3);
  border-radius: 50%;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.15);
  font-size: 30rpx;
  transition: transform 200ms cubic-bezier(0.34, 1.56, 0.64, 1);
  z-index: 5;
}

.route-card__fav:active { transform: scale(1.3); }

.route-card__fav--on {
  background: rgba(255, 235, 238, 0.95);
}

/* 底部叠加信息 */
.route-card__hero {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx;
  z-index: 2;
}

.route-card__name {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 10rpx;
  text-shadow: 0 1rpx 6rpx rgba(0,0,0,0.3);
}

.route-card__meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.route-card__meta-item {
  padding: 4rpx 12rpx;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(8rpx);
  -webkit-backdrop-filter: blur(8rpx);
  border-radius: 6rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.9);
  border: 1px solid rgba(255,255,255,.15);
}

/* 卡片内容 */
.route-card__body {
  padding: 20rpx 24rpx 24rpx;
}

.route-card__desc {
  display: block;
  font-size: 26rpx;
  color: #4a6b4a;
  margin-bottom: 14rpx;
  line-height: 1.5;
}

/* 风景标签 */
.route-card__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 10rpx;
}

.route-card__tag {
  padding: 4rpx 12rpx;
  background: rgba(129, 199, 132, 0.2);
  backdrop-filter: blur(8rpx);
  -webkit-backdrop-filter: blur(8rpx);
  border-radius: 6rpx;
  font-size: 20rpx;
  color: #2d6a4f;
  border: 1px solid rgba(129, 199, 132, 0.2);
}

/* 亲子标记 */
.route-card__family {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #1565C0;
  background: rgba(227, 242, 253, 0.6);
  backdrop-filter: blur(8rpx);
  -webkit-backdrop-filter: blur(8rpx);
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  display: inline-block;
}

/* ===== 空状态 ===== */
.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.empty-visual {
  position: relative;
  width: 140rpx;
  height: 140rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
}

.empty-circle {
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(129,199,132,.3) 0%, rgba(76,175,80,.2) 100%);
  animation: emptyPulse 3s ease-in-out infinite;
}

@keyframes emptyPulse {
  0%, 100% { transform: scale(1); opacity: 0.6; }
  50% { transform: scale(1.08); opacity: 1; }
}

.empty-icon { position: relative; font-size: 64rpx; }
.empty-title { font-size: 30rpx; font-weight: 600; color: #1a2e1a; margin-bottom: 12rpx; }
.empty-desc { font-size: 26rpx; color: #6b8b6b; }

/* ===== 加载更多 ===== */
.load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  padding: 36rpx 0;
}

.load-spinner {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid rgba(255,255,255,.3);
  border-top-color: #2d6a4f;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.load-text { font-size: 24rpx; color: #6b8b6b; }

/* 没有更多 */
.no-more {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 36rpx 0;
}

.no-more__line { width: 60rpx; height: 1rpx; background: rgba(255,255,255,.3); }
.no-more__text { font-size: 22rpx; color: #6b8b6b; }
