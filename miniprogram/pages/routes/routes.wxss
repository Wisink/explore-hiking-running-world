/* pages/routes/routes.wxss - 路线列表页 v2.0 */

.routes-page {
  min-height: 100vh;
  background: #FAFAF5;
  padding-bottom: 140rpx;
}

/* ===== 顶部标题栏 ===== */
.header {
  position: relative;
  overflow: hidden;
}

.header__bg {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(135deg, #2E7D32 0%, #388E3C 40%, #43A047 100%);
}

.header__content {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 24rpx;
}

.header__left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.header__emoji {
  font-size: 44rpx;
}

.header__text {
  display: flex;
  flex-direction: column;
}

.header__title {
  font-size: 38rpx;
  font-weight: 800;
  color: #FFFFFF;
  letter-spacing: 2rpx;
}

.header__sub {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 2rpx;
}

.header__search {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(8rpx);
  transition: transform 200ms ease;
}

.header__search:active {
  transform: scale(0.9);
}

.header__search-icon {
  font-size: 34rpx;
}

/* ===== 搜索栏 ===== */
.search-bar {
  flex: 1;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  gap: 16rpx;
}

.search-bar__input {
  flex: 1;
  display: flex;
  align-items: center;
  background: #F5F5F0;
  border-radius: 40rpx;
  padding: 0 24rpx;
  height: 72rpx;
}

.search-bar__icon {
  font-size: 26rpx;
  margin-right: 12rpx;
}

.search-bar__field {
  flex: 1;
  font-size: 28rpx;
  color: #212121;
}

.search-bar__clear {
  font-size: 26rpx;
  color: #9E9E99;
  padding: 8rpx;
}

.search-bar__cancel {
  font-size: 28rpx;
  color: #2E7D32;
  font-weight: 500;
  white-space: nowrap;
}

@keyframes slideDown {
  from { opacity: 0; transform: translateY(-20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* ===== 高级筛选 ===== */
.search-bar-row {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  animation: slideDown 250ms ease-out;
}

.search-bar {
  flex: 1;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  gap: 16rpx;
}

.filter-toggle {
  padding: 10rpx 20rpx;
  background: #F5F5F0;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #303028;
  white-space: nowrap;
}

.advanced-filter {
  padding: 20rpx 24rpx;
  background: #F9F9F4;
  border-bottom: 1rpx solid #E0E0DB;
}

.advanced-filter__row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.advanced-filter__row:last-child {
  margin-bottom: 0;
}

.advanced-filter__label {
  font-size: 24rpx;
  color: #666;
  width: 80rpx;
  flex-shrink: 0;
}

.advanced-filter__options {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.advanced-filter__option {
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  color: #666;
  background: #FFFFFF;
  border-radius: 16rpx;
  border: 1rpx solid #E0E0DB;
}

.advanced-filter__option.active {
  background: #2E7D32;
  color: #FFFFFF;
  border-color: #2E7D32;
}

/* ===== 筛选标签栏 ===== */
.filter-scroll {
  display: flex;
  white-space: nowrap;
  padding: 20rpx 20rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.04);
}

.filter-chip {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 24rpx;
  margin-right: 14rpx;
  border-radius: 40rpx;
  background: #F5F5F0;
  transition: all 250ms cubic-bezier(0.4, 0, 0.2, 1);
  flex-shrink: 0;
  user-select: none;
}

.filter-chip--hover {
  opacity: 0.8;
  transform: scale(0.95);
}

.filter-chip--active {
  background: linear-gradient(135deg, #2E7D32 0%, #43A047 100%);
  box-shadow: 0 4rpx 14rpx rgba(46, 125, 50, 0.3);
}

.filter-chip__icon {
  font-size: 22rpx;
}

.filter-chip__text {
  font-size: 24rpx;
  color: #616156;
  font-weight: 500;
}

.filter-chip--active .filter-chip__text {
  color: #FFFFFF;
}

/* ===== 骨架屏 ===== */
.skeleton-wrap {
  padding: 24rpx 24rpx;
}

.skel-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.skel-cover {
  width: 100%;
  height: 360rpx;
}

.skel-body {
  padding: 24rpx;
}

.skel-line {
  border-radius: 8rpx;
  height: 28rpx;
}

.skel-line--title { width: 55%; height: 34rpx; margin-bottom: 16rpx; }
.skel-line--desc { width: 80%; height: 24rpx; margin-bottom: 16rpx; }

.skel-row {
  display: flex;
  gap: 12rpx;
  margin-top: 14rpx;
}

.skel-chip {
  width: 100rpx;
  height: 32rpx;
  border-radius: 8rpx;
}

.skel-shimmer {
  background: linear-gradient(90deg, #F0F0EB 25%, #E8F5E9 37%, #F0F0EB 63%);
  background-size: 400rpx 100%;
  animation: skelShimmer 1.8s ease infinite;
}

@keyframes skelShimmer {
  0% { background-position: -400rpx 0; }
  100% { background-position: 400rpx 0; }
}

/* ===== 路线卡片列表 ===== */
.route-list {
  padding: 24rpx 24rpx;
}

.route-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  margin-bottom: 28rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  animation: fadeInUp 400ms cubic-bezier(0.25, 0.46, 0.45, 0.94) both;
}

.route-card--hover {
  transform: scale(0.97);
  opacity: 0.95;
}

@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(40rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* 卡片封面 */
.route-card__cover {
  position: relative;
  width: 100%;
  height: 360rpx;
  overflow: hidden;
}

.route-card__image {
  width: 100%;
  height: 100%;
  transition: transform 500ms ease;
}

.route-card:active .route-card__image {
  transform: scale(1.03);
}

.route-card__overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 65%;
  background: linear-gradient(180deg, rgba(0,0,0,0) 0%, rgba(0,0,0,0.55) 100%);
  pointer-events: none;
}

/* 难度角标 */
.route-card__badge {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  padding: 8rpx 18rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  color: #FFFFFF;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.15);
}

/* 免费角标 */
.route-card__free {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  background: rgba(76, 175, 80, 0.9);
  font-size: 22rpx;
  color: #FFFFFF;
  font-weight: 500;
  backdrop-filter: blur(4rpx);
}

/* 当季推荐角标 */
.route-card__season {
  position: absolute;
  top: 16rpx;
  left: 120rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  background: rgba(255, 152, 0, 0.9);
  font-size: 22rpx;
  color: #FFFFFF;
  font-weight: 500;
  backdrop-filter: blur(4rpx);
}

/* 收藏按钮 */
.route-card__fav {
  position: absolute;
  bottom: 100rpx;
  right: 20rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 50%;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.15);
  font-size: 30rpx;
  transition: transform 200ms cubic-bezier(0.34, 1.56, 0.64, 1);
  z-index: 5;
}

.route-card__fav:active {
  transform: scale(1.3);
}

.route-card__fav--on {
  background: rgba(255, 235, 238, 0.95);
}

/* 底部叠加信息 */
.route-card__hero {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx;
  z-index: 2;
}

.route-card__name {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 10rpx;
  text-shadow: 0 1rpx 6rpx rgba(0,0,0,0.3);
}

.route-card__meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.route-card__meta-item {
  padding: 4rpx 12rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 6rpx;
  backdrop-filter: blur(4rpx);
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 卡片内容 */
.route-card__body {
  padding: 20rpx 24rpx 24rpx;
}

.route-card__desc {
  display: block;
  font-size: 26rpx;
  color: #757570;
  margin-bottom: 14rpx;
  line-height: 1.5;
}

/* 风景标签 */
.route-card__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 10rpx;
}

.route-card__tag {
  padding: 4rpx 12rpx;
  background: rgba(129, 199, 132, 0.15);
  border-radius: 6rpx;
  font-size: 20rpx;
  color: #2E7D32;
  border: 1rpx solid rgba(129, 199, 132, 0.2);
}

/* 亲子标记 */
.route-card__family {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #1565C0;
  background: #E3F2FD;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  display: inline-block;
}

/* ===== 空状态 ===== */
.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.empty-visual {
  position: relative;
  width: 140rpx;
  height: 140rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
}

.empty-circle {
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: linear-gradient(135deg, #E8F5E9 0%, #C8E6C9 100%);
  animation: emptyPulse 3s ease-in-out infinite;
}

@keyframes emptyPulse {
  0%, 100% { transform: scale(1); opacity: 0.6; }
  50% { transform: scale(1.08); opacity: 1; }
}

.empty-icon {
  position: relative;
  font-size: 64rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #424240;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #9E9E99;
}

/* ===== 加载更多 ===== */
.load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  padding: 36rpx 0;
}

.load-spinner {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid #E0E0DB;
  border-top-color: #2E7D32;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.load-text {
  font-size: 24rpx;
  color: #9E9E99;
}

/* 没有更多 */
.no-more {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 36rpx 0;
}

.no-more__line {
  width: 60rpx;
  height: 1rpx;
  background: #E0E0DB;
}

.no-more__text {
  font-size: 22rpx;
  color: #C0C0BB;
}
