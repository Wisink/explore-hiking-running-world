/* 骨架屏组件样式 */

.skeleton {
  padding: 0;
}

/* 脉冲动画 */
.skeleton-pulse {
  animation: skeletonPulse 1.5s ease-in-out infinite;
  background: linear-gradient(90deg, #F0F0F0 25%, #E0E0E0 50%, #F0F0F0 75%);
  background-size: 400rpx 100%;
}

@keyframes skeletonPulse {
  0% { background-position: -400rpx 0; }
  100% { background-position: 400rpx 0; }
}

/* 卡片骨架 */
.skeleton-card {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.skeleton-card__image {
  width: 100%;
  height: 320rpx;
  border-radius: 16rpx 16rpx 0 0;
}

.skeleton-card__body {
  padding: 24rpx;
}

.skeleton-card__row {
  display: flex;
  gap: 12rpx;
  margin-top: 12rpx;
}

/* 线条骨架 */
.skeleton-line {
  border-radius: 8rpx;
  height: 28rpx;
}

.skeleton-line--title {
  width: 60%;
  height: 32rpx;
  margin-bottom: 16rpx;
}

.skeleton-line--desc {
  width: 80%;
  height: 24rpx;
  margin-bottom: 16rpx;
}

.skeleton-line--short {
  width: 120rpx;
  height: 24rpx;
}

.skeleton-line--tag {
  width: 80rpx;
  height: 28rpx;
  border-radius: 4rpx;
}

.skeleton-line--full {
  width: 100%;
  height: 24rpx;
  margin-bottom: 16rpx;
}

.skeleton-line--half {
  width: 50%;
  height: 24rpx;
  margin-bottom: 16rpx;
}

.skeleton-line--3-4 {
  width: 75%;
  height: 24rpx;
  margin-bottom: 16rpx;
}

.skeleton-line--btn {
  flex: 1;
  height: 88rpx;
  border-radius: 8rpx;
}

/* 详情骨架 */
.skeleton-detail__banner {
  width: 100%;
  height: 480rpx;
}

.skeleton-detail__content {
  padding: 32rpx;
}

.skeleton-detail__row {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}
