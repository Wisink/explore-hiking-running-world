<!-- 骨架屏组件 v2.0 -->
<view class="skeleton">
  <!-- 列表骨架 -->
  <block wx:if="{{type === 'list'}}">
    <view class="skel-card" wx:for="{{count}}" wx:key="*this">
      <view class="skel-cover skel-shimmer"></view>
      <view class="skel-body">
        <view class="skel-line skel-line--title skel-shimmer"></view>
        <view class="skel-line skel-line--desc skel-shimmer"></view>
        <view class="skel-row">
          <view class="skel-chip skel-shimmer"></view>
          <view class="skel-chip skel-shimmer"></view>
          <view class="skel-chip skel-shimmer"></view>
        </view>
      </view>
    </view>
  </block>

  <!-- 详情骨架 -->
  <block wx:if="{{type === 'detail'}}">
    <view class="skel-banner skel-shimmer"></view>
    <view class="skel-content">
      <view class="skel-line skel-line--title skel-shimmer"></view>
      <view class="skel-line skel-line--desc skel-shimmer"></view>
      <view class="skel-row">
        <view class="skel-chip skel-shimmer"></view>
        <view class="skel-chip skel-shimmer"></view>
      </view>
      <view class="skel-row" style="margin-top: 32rpx;">
        <view class="skel-btn skel-shimmer"></view>
        <view class="skel-btn skel-shimmer"></view>
      </view>
      <view style="margin-top: 36rpx;">
        <view class="skel-line skel-line--full skel-shimmer"></view>
        <view class="skel-line skel-line--full skel-shimmer"></view>
        <view class="skel-line skel-line--half skel-shimmer"></view>
      </view>
      <view style="margin-top: 24rpx;">
        <view class="skel-line skel-line--full skel-shimmer"></view>
        <view class="skel-line skel-line--3-4 skel-shimmer"></view>
      </view>
    </view>
  </block>
</view>
