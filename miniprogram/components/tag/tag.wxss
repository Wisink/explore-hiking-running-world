/* 标签组件 v2.0 - 自然色系+波纹效果 */

.tag {
  display: inline-flex;
  align-items: center;
  position: relative;
  overflow: hidden;
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 500;
  transition: all 200ms cubic-bezier(0.4, 0, 0.2, 1);
  user-select: none;
}

.tag--hover {
  opacity: 0.85;
  transform: scale(0.95);
}

/* 尺寸 */
.tag--sm {
  padding: 4rpx 14rpx;
  font-size: 20rpx;
  border-radius: 6rpx;
}

.tag--md {
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  border-radius: 8rpx;
}

.tag--lg {
  padding: 10rpx 24rpx;
  font-size: 26rpx;
  border-radius: 10rpx;
}

/* 类型 - 自然色系 */
.tag--difficulty {
  background: rgba(255, 152, 0, 0.1);
  color: #E65100;
  border: 1rpx solid rgba(255, 152, 0, 0.15);
}

.tag--difficulty.tag--selected {
  background: linear-gradient(135deg, #FF9800 0%, #FFA726 100%);
  color: #FFFFFF;
  border-color: transparent;
  box-shadow: 0 2rpx 8rpx rgba(255, 152, 0, 0.3);
}

.tag--cost-free {
  background: rgba(76, 175, 80, 0.1);
  color: #2d6a4f;
  border: 1rpx solid rgba(76, 175, 80, 0.15);
}

.tag--cost-free.tag--selected {
  background: linear-gradient(135deg, #4CAF50 0%, #66BB6A 100%);
  color: #FFFFFF;
  border-color: transparent;
  box-shadow: 0 2rpx 8rpx rgba(76, 175, 80, 0.3);
}

.tag--cost-paid {
  background: rgba(255, 143, 0, 0.1);
  color: #E65100;
  border: 1rpx solid rgba(255, 143, 0, 0.15);
}

.tag--cost-paid.tag--selected {
  background: linear-gradient(135deg, #FF8F00 0%, #FFA726 100%);
  color: #FFFFFF;
  border-color: transparent;
}

.tag--scenery {
  background: rgba(129, 199, 132, 0.15);
  color: #2d6a4f;
  border: 1rpx solid rgba(129, 199, 132, 0.2);
}

.tag--scenery.tag--selected {
  background: linear-gradient(135deg, #74c69d 0%, #A5D6A7 100%);
  color: #FFFFFF;
  border-color: transparent;
}

.tag--crowd {
  background: rgba(100, 181, 246, 0.12);
  color: #1565C0;
  border: 1rpx solid rgba(100, 181, 246, 0.18);
}

.tag--crowd.tag--selected {
  background: linear-gradient(135deg, #42A5F5 0%, #64B5F6 100%);
  color: #FFFFFF;
  border-color: transparent;
}

.tag--default {
  background: #F5F5F0;
  color: #4a6b4a;
  border: 1rpx solid var(--color-border, #E0E0DB);
}

.tag--default.tag--selected {
  background: linear-gradient(135deg, #2d6a4f 0%, #40916c 100%);
  color: #FFFFFF;
  border-color: transparent;
  box-shadow: 0 2rpx 8rpx rgba(46, 125, 50, 0.3);
}

.tag--primary {
  background: rgba(46, 125, 50, 0.08);
  color: #2d6a4f;
  border: 1rpx solid rgba(46, 125, 50, 0.12);
}

.tag--primary.tag--selected {
  background: linear-gradient(135deg, #2d6a4f 0%, #40916c 100%);
  color: #FFFFFF;
  border-color: transparent;
}

.tag--accent {
  background: rgba(255, 143, 0, 0.08);
  color: #FF8F00;
  border: 1rpx solid rgba(255, 143, 0, 0.12);
}

.tag--accent.tag--selected {
  background: linear-gradient(135deg, #FF8F00 0%, #FFA726 100%);
  color: #FFFFFF;
  border-color: transparent;
}

/* 禁用 */
.tag--disabled {
  opacity: 0.35;
  pointer-events: none;
}

/* 图标 */
.tag__icon {
  margin-right: 6rpx;
  font-size: 20rpx;
}

.tag__text {
  position: relative;
  z-index: 1;
}

/* 波纹效果 */
.tag__ripple {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.4);
  width: 200%;
  padding-bottom: 200%;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) scale(0);
  animation: ripple 400ms ease-out;
  pointer-events: none;
}

@keyframes ripple {
  to {
    transform: translate(-50%, -50%) scale(1);
    opacity: 0;
  }
}
