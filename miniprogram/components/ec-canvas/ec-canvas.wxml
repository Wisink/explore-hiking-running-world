<!-- ec-canvas.wxml -->
<!-- 新Canvas 2D API (基础库 >= 2.9.0) -->
<canvas wx:if="{{isUseNewCanvas}}" type="2d" class="ec-canvas" canvas-id="{{canvasId}}" bindtouchstart="{{ec.disableTouch ? '' : 'touchStart'}}" bindtouchmove="{{ec.disableTouch ? '' : 'touchMove'}}" bindtouchend="{{ec.disableTouch ? '' : 'touchEnd'}}"></canvas>
<!-- 旧Canvas API (基础库 < 2.9.0) -->
<canvas wx:else class="ec-canvas" canvas-id="{{canvasId}}" bindtouchstart="{{ec.disableTouch ? '' : 'touchStart'}}" bindtouchmove="{{ec.disableTouch ? '' : 'touchMove'}}" bindtouchend="{{ec.disableTouch ? '' : 'touchEnd'}}"></canvas>
