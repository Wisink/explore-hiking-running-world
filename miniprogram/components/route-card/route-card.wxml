<!-- 路线卡片组件 v2.0 -->
<view
  class="route-card"
  bindtap="onTap"
  hover-class="route-card--hover"
  hover-stay-time="80"
>
  <!-- 封面图区 -->
  <view class="route-card__cover">
    <image
      class="route-card__image"
      src="{{route.coverImage || route.cover || '/images/scenery/scenery-general.jpg'}}"
      mode="aspectFill"
      lazy-load
      binderror="onImageError"
    />
    <!-- 渐变遮罩 -->
    <view class="route-card__overlay"></view>

    <!-- 难度角标 -->
    <view class="route-card__badge diff-{{route.difficulty.level}}">
      {{route.difficulty.label || difficultyText}}
    </view>

    <!-- 收藏按钮 -->
    <view
      class="route-card__fav {{isFavorited ? 'route-card__fav--active' : ''}}"
      catchtap="onFavTap"
    >
      <text class="route-card__fav-icon">{{isFavorited ? '❤️' : '🤍'}}</text>
    </view>

    <!-- 底部信息叠加 -->
    <view class="route-card__hero">
      <text class="route-card__name">{{route.name}}</text>
      <view class="route-card__meta">
        <view class="route-card__meta-item" wx:if="{{route.distance_km}}">
          <text class="meta-icon">📏</text>
          <text>{{route.distance_km}}km</text>
        </view>
        <view class="route-card__meta-item" wx:if="{{route.duration_hours}}">
          <text class="meta-icon">⏱</text>
          <text>{{route.duration_hours}}h</text>
        </view>
        <view class="route-card__meta-item" wx:if="{{route.elevation_gain_m}}">
          <text class="meta-icon">⛰️</text>
          <text>{{route.elevation_gain_m}}m↑</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 内容区 -->
  <view class="route-card__body">
    <!-- 描述 -->
    <text class="route-card__desc ellipsis">{{route.description}}</text>

    <!-- 底部行 -->
    <view class="route-card__footer">
      <!-- 难度星级 -->
      <view class="route-card__stars">
        <text
          class="route-card__star"
          wx:for="{{5}}"
          wx:key="*this"
        >{{index < route.difficulty.level ? '★' : '☆'}}</text>
      </view>

      <!-- 费用 -->
      <view class="route-card__cost {{route.cost.type === '免费' ? 'route-card__cost--free' : ''}}">
        <text>{{route.cost.type === '免费' ? '免费' : '¥' + (route.cost.amount || '?')}}</text>
      </view>
    </view>

    <!-- 风景标签 -->
    <view class="route-card__tags" wx:if="{{route.scenery && route.scenery.length}}">
      <text class="route-card__tag" wx:for="{{route.scenery}}" wx:key="*this">{{item}}</text>
    </view>
  </view>
</view>
