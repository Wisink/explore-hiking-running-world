/* 路线卡片组件 v2.0 - 大图封面+自然风格 */

.route-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  transition: all 250ms cubic-bezier(0.4, 0, 0.2, 1);
  animation: fadeInUp 400ms cubic-bezier(0.25, 0.46, 0.45, 0.94) both;
}

.route-card--hover {
  transform: scale(0.97);
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.08);
}

/* 封面图区 */
.route-card__cover {
  position: relative;
  width: 100%;
  height: 360rpx;
  overflow: hidden;
}

.route-card__image {
  width: 100%;
  height: 100%;
  transition: transform 500ms cubic-bezier(0.4, 0, 0.2, 1);
}

.route-card:active .route-card__image {
  transform: scale(1.03);
}

/* 渐变遮罩 */
.route-card__overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 60%;
  background: linear-gradient(180deg, rgba(0,0,0,0) 0%, rgba(0,0,0,0.55) 100%);
  pointer-events: none;
}

/* 难度角标 */
.route-card__badge {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  padding: 8rpx 18rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #FFFFFF;
  backdrop-filter: blur(8rpx);
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.15);
}

/* 收藏按钮 */
.route-card__fav {
  position: absolute;
  bottom: 100rpx;
  right: 20rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 50%;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.15);
  transition: transform 200ms cubic-bezier(0.34, 1.56, 0.64, 1);
  z-index: 5;
}

.route-card__fav:active {
  transform: scale(1.25);
}

.route-card__fav--active {
  background: rgba(255, 235, 238, 0.95);
}

.route-card__fav-icon {
  font-size: 32rpx;
}

/* 底部叠加信息 */
.route-card__hero {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx;
  z-index: 2;
}

.route-card__name {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 10rpx;
  text-shadow: 0 1rpx 4rpx rgba(0,0,0,0.3);
}

.route-card__meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.route-card__meta-item {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 4rpx 12rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 6rpx;
  backdrop-filter: blur(4rpx);
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.95);
}

.meta-icon {
  font-size: 18rpx;
}

/* 内容区 */
.route-card__body {
  padding: 20rpx 24rpx 24rpx;
}

.route-card__desc {
  display: block;
  font-size: 26rpx;
  color: #757570;
  line-height: 1.5;
  margin-bottom: 14rpx;
}

/* 底部行 */
.route-card__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.route-card__stars {
  display: flex;
  align-items: center;
  gap: 2rpx;
}

.route-card__star {
  font-size: 22rpx;
  color: #FFB300;
}

.route-card__cost {
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
  font-weight: 600;
  background: #FFF8E1;
  color: #E65100;
}

.route-card__cost--free {
  background: #E8F5E9;
  color: #2E7D32;
}

/* 风景标签 */
.route-card__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.route-card__tag {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
  color: #2E7D32;
  background: rgba(129, 199, 132, 0.15);
  border: 1rpx solid rgba(129, 199, 132, 0.2);
}

/* 入场动画延迟 */
.route-card:nth-child(1) { animation-delay: 0ms; }
.route-card:nth-child(2) { animation-delay: 80ms; }
.route-card:nth-child(3) { animation-delay: 160ms; }
.route-card:nth-child(4) { animation-delay: 240ms; }
.route-card:nth-child(5) { animation-delay: 320ms; }

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
