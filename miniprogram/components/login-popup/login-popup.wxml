<!--components/login-popup/login-popup.wxml-->
<view class="login-popup {{show ? 'show' : ''}}" bindtap="onClose">
  <view class="login-dialog" catchtap="onStop">
    <view class="dialog-header">
      <text class="dialog-title">登录提示</text>
      <view class="close-btn" bindtap="onClose">
        <text class="close-icon">×</text>
      </view>
    </view>
    <view class="dialog-body">
      <view class="login-icon">
        <text class="icon-text">👤</text>
      </view>
      <text class="login-desc">{{desc || '请先登录后再操作'}}</text>
      <text class="login-benefit">登录后可使用收藏、点赞、评论等功能</text>
    </view>
    <view class="dialog-footer">
      <button class="login-btn" bindtap="onLogin">
        <text class="btn-text">立即登录</text>
      </button>
    </view>
  </view>
</view>
